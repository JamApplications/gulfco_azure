<odoo>
	<record id="purchase_order_inherited_advance_payments_form_view" model="ir.ui.view">
		<field name="name">purchase.order.inherited.advance.payment.form.view</field>
		<field name="model">purchase.order</field>
		<field name="inherit_id" ref="purchase.purchase_order_form"/>
		<field name="arch" type="xml">
			<xpath expr="//header" position="inside">
				<button string="Advance Payment"
				        type="object"
				        name="action_advance_payment"
				        invisible="state not in ['draft', 'sent', 'purchase']"
				        groups="eg_advance_payment_in_purchase.advance_payment_in_purchase"/>
			</xpath>
			<xpath expr="//notebook" position="inside">
				<page string="Account Payment" groups="eg_advance_payment_in_purchase.advance_payment_in_purchase">
					<field name="payment_line" mode="list" readonly="1">
						<list editable="bottom">
							<field name="currency_id" column_invisible="True"/>
							<field name="purchase_id" column_invisible="True"/>
							<field name="memo"/>
							<field name="partner_id"/>
							<field name="date"/>
							<field name="create_uid"/>
							<field name="create_date"/>
							<field name="state" column_invisible="True"/>
							<field name="journal_id"/>
							<field name="payment_method_id"/>
							<field name="amount" sum="amount" options="{'currency_field':'currency_id'}"/>
						</list>
					</field>
				</page>
			</xpath>
		</field>
	</record>
	<record id="gulfco_purchase_order_form_inherit_requisition" model="ir.ui.view">
		    <field name="name">gulfco.purchase.order.form.inherit.requisition</field>
		    <field name="model">purchase.order</field>
		    <field name="inherit_id" ref="purchase_requisition.purchase_order_form_inherit"/>
		    <field name="arch" type="xml">
		        <xpath expr="//field[@name='partner_id']" position="attributes">
					<attribute name="readonly">requisition_type == 'blanket_order' or state not in ('draft', 'sent') or payment_line</attribute>
		        </xpath>
				<xpath expr="//field[@name='requisition_id']" position="attributes">
					<attribute name="readonly">state not in ('draft', 'sent')</attribute>
				</xpath>
		    </field>
		</record>
</odoo>