<odoo>
    <record id="sale_order_inherited_advance_payment_form_view" model="ir.ui.view">
        <field name="name">sale.order.inherited.advance.payment.form.view</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button string="Advance Payment"
                        type="object"
                        name="action_advance_payment"
                        invisible="state not in ['draft', 'sent', 'sale']"/>
            </xpath>
            <xpath expr="//page[@name='customer_signature']" position="after">
                <page string="Account Payment">
                    <field name="payment_line" nolabel="1" readonly="1">
                        <list editable="bottom">
                            <field name="currency_id" column_invisible="1"/>
                            <field name="sale_id" column_invisible="1"/>
                            <field name="memo"/>
                            <field name="company_id" column_invisible="1"/>
                            <field name="partner_id"/>
                            <field name="date"/>
                            <field name="create_uid"/>
                            <field name="create_date"/>
                            <field name="journal_id"/>
                            <field name="state" column_invisible="1"/>
                            <field name="payment_method_id"/>
                            <field name="amount" sum="amount" options="{'currency_field':'currency_id'}"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>