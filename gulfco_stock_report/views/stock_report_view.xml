<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_report_view_list" model="ir.ui.view">
        <field name="name">stock.report.view.list</field>
        <field name="model">gulfco.stock.report</field>
        <field name="arch" type="xml">
            <list editable="bottom" create="0" edit="0" js_class="inventory_report_list" sample="1" duplicate="0">
                <field name="date"/>
                <field name="default_code"/>
                <field name="product_id"/>
                <field name="category_id"/>
                <field name="planned_quantity"/>
                <field name="qty"/>
                <field name="cost"/>
                <field name="total_cost"/>
                <field name="state"/>
                <field name="picking_type_id"/>
                <field name="complete_name"/>
                <field name="location"/>
                <field name="location_name"/>
                <field name="lot_name"/>
                <field name="expiration_date"/>
                <field name="operation_type"/>
                <field name="usage"/>
                <field name="trx_type"/>
            </list>
        </field>
    </record>


    <record id="action_stock_report_view" model="ir.actions.act_window">
        <field name="name">Stock Report View</field>
        <field name="res_model">gulfco.stock.report</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_stock_report_view_root"
              name="Stock Report View"
              parent="stock.menu_warehouse_report"
              action="action_stock_report_view"/>
</odoo>

