<odoo>
    <record id="account_payment_cdc_writeoff_form" model="ir.ui.view">
        <field name="name">account.payment.cdc.writeoff.form</field>
        <field name="model">account.payment.cdc.writeoff</field>
        <field name="arch" type="xml">
            <form string="Payment CDC Write off Wizard">
                <group>
                    <group>
                        <field name="account_id" options="{'no_open': True, 'no_create': True}"
                               required="1"/>
                    </group>
                    <group>
                        <field name="ref"/>
                        <field name="date"/>
                    </group>
                </group>
                <footer>
                    <button string="Register Write Off" name="action_register_write_off" type="object"
                            class="oe_highlight"/>
                    <button string="Cancel" class="btn btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>