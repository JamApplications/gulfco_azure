<odoo>
    <record id="account_check_printing_view_account_payment_form_inherited" model="ir.ui.view">
        <field name="name">account.check.printing.view.account.payment.form.inherited</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account_check_printing.view_account_payment_form_inherited"/>
        <field name="arch" type="xml">
            <xpath expr="//widget[@name='web_ribbon']" position="attributes">
                <attribute name="invisible">not is_sent or state in ('rejected', 'canceled') or payment_type == 'inbound'</attribute>
            </xpath>
        </field>
    </record>

    <record id="account_payment_cdc_form_inherit" model="ir.ui.view">
        <field name="name">account.payment.form.inherit</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account_pdc.account_payment_form_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='is_pdc_payment']" position="after">
                <field name="is_cdc_payment" invisible="1"/>
                <field name="is_access_draft" invisible="1"/>
                <field name="can_be_cdc_payable" invisible="1"/>
            </xpath>

            <xpath expr="//button[@name='action_reject']" position="attributes">
<!--                <attribute name="invisible">state not in ('in_process') or is_pdc_payment == True or is_pdc_payable == True or is_cdc_payment == True or is_cdc_payable == True</attribute>-->
                <attribute name="invisible">1</attribute>
                <attribute name="groups">account.group_account_manager</attribute>
            </xpath>

            <xpath expr="//button[@name='action_cancel']" position="attributes">
                <attribute name="invisible">state not in ('draft', 'in_process') or is_pdc_payment == True or is_pdc_payable == True or is_cdc_payment == True or is_cdc_payable == True</attribute>
            </xpath>
            <xpath expr="//button[@name='unmark_as_sent']" position="attributes">
                <attribute name="invisible">state not in ('draft') or is_pdc_payment == True or is_pdc_payable == True or is_cdc_payment == True or is_cdc_payable == True</attribute>
            </xpath>

            <xpath expr="//button[@name='unmark_as_sent']" position="attributes">
                <attribute name="invisible">state != 'in_process' or is_move_sent == False or payment_method_code != 'manual' or is_pdc_payment == True or is_pdc_payable == True or is_cdc_payment == True or is_cdc_payable == True</attribute>
            </xpath>
            <xpath expr="//button[@name='mark_as_sent']" position="attributes">
                <attribute name="invisible">state != 'in_process' or is_move_sent == True or payment_method_code != 'manual' or is_pdc_payment == True or is_pdc_payable == True or is_cdc_payment == True or is_cdc_payable == True</attribute>

            </xpath>
            <xpath expr="//button[@name='action_draft']" position="attributes">
                <attribute name="invisible">state not in ('in_process', 'cancel') or is_pdc_payment == True or is_pdc_payable == True or is_cdc_payment == True or is_cdc_payable == True</attribute>
                <attribute name="groups">account.group_account_manager</attribute>
            </xpath>

            <xpath expr="//button[@name='action_post']" position="after">
                <!-- cdc receivable buttons -->
                <button name="action_open_cdc_receivable_bounce_wizard" string="Bounce" type="object"
                        invisible="is_cdc_payable or is_cdc_payment == False or cdc_state not in ['collected']"/>
                <button name="action_cdc_receivable_recycled" string="Mark To Recycle" type="object"
                        invisible="is_cdc_payable or is_cdc_payment == False or cdc_state != 'bounced'"/>
                <button name="action_create_cdc_receivable_collection_fees" string="Add Bank Collection Fees"
                        type="object"
                        invisible="is_cdc_payable or is_cdc_payment == False or cdc_state not in ['collected']"/>
                <button name="action_open_cdc_receivable_write_off" string="Write Off Cheque" type="object"
                        invisible="is_cdc_payable or is_cdc_payment == False or cdc_state not in ['bounced']"/>
                <button name="action_open_cdc_receivable_cashed_wizard" string="Cashed" type="object"
                        invisible="is_cdc_payable or is_cdc_payment == False or state != 'in_process' or cdc_state not in ['registered', 'bounced']"/>
                <button name="action_cdc_receivable_deposit_wizard" string="Deposit" type="object"
                        invisible="is_cdc_payable or is_cdc_payment == False or state != 'in_process' or cdc_state not in ['registered', 'bounced']"/>
                
                <button name="action_open_cdc_receivable_re_collect_wizard" string="Re-Deposit" type="object" class="oe_highlight" 
                        invisible="is_cdc_payable or is_cdc_payment == False or cdc_state not in ['bounced', 'returned']"/>
                <button name="action_open_cdc_receivable_re_cheque_wizard" string="Re Cheque" type="object" class="oe_highlight" 
                        invisible="is_cdc_payable or is_cdc_payment == False or cdc_state not in ['bounced', 'returned']"/>

                <button name="action_open_cdc_receivable_collect_wizard" string="Collect Bank" type="object"
                        class="oe_highlight"
                        invisible="is_cdc_payable or is_cdc_payment == False or cdc_state != 'deposit'"/>
                <button name="action_cancel_cdc" string="Cancel Cheque" type="object"
                        invisible="is_cdc_payable or is_cdc_payment == False or state != 'in_process' or cdc_state != 'registered'"/>
                <button name="action_return_cdc" string="Return Cheque" type="object" 
                        invisible="is_cdc_payable or is_cdc_payment == False or cdc_state != 'bounced'"/>
                <button name="action_draft_cdc_receivable" string="Set Draft" type="object" groups="account.group_account_manager"
                        invisible="is_cdc_payable or is_cdc_payment == False or state != 'in_process' or cdc_state != 'registered'"/>

                <!-- cdc payable buttons -->
                <!-- <button name="action_open_cdc_payable_delivered_wizard" string="Set Delivered" type="object"
                        class="oe_highlight"
                        invisible="is_cdc_payable == False or state != 'in_process' or cdc_payable_state != 'registered' or cleared_cdc_payable_move_id != False"/> -->
                <button name="action_open_cdc_payable_clear_wizard" string="Set Cleared" type="object"
                        class="oe_highlight"
                        invisible="is_cdc_payable == False or state != 'in_process' or cdc_payable_state not in ['registered','bounced'] or cleared_cdc_payable_move_id != False"/>
                <!-- <button name="action_cdc_payable_bounced" string="Set Bounced" type="object"
                        invisible="is_cdc_payable == False or state != 'in_process' or cdc_payable_state != 'delivered' or bounced_move_id != False"/>     -->
                <button name="action_cdc_payable_bounce_cancel" string="Bounce/Cancel" type="object"
                        invisible="is_cdc_payable == False or state not in ['in_process','paid'] or cdc_payable_state not in ['registered', 'cleared'] or bounced_move_id != False"/>
                <!-- <button name="action_cancel_cdc" string="Cancel Cheque" type="object"
                        invisible="is_cdc_payable == False or state != 'in_process' or cdc_payable_state  != 'delivered'"/> -->

            </xpath>

            <xpath expr="//field[@name='memo']" position="after">
                <!-- <label for="cdc_ref" string="Cheque Number" class="oe_inline" invisible="is_cdc_payment == False"/>
                <div class="o_row" invisible="is_cdc_payment == False">
                    <field name="cdc_ref" nolabel="1" options="{'format': 0}"
                           invisible="is_cdc_payment == False" required="is_cdc_payment == True" readonly="state != 'draft'"/>
                </div> -->
                <field name="cdc_ref" string="Cheque No." options="{'format': 0}"
                       invisible="not is_cdc_payable and not is_cdc_payment" required="is_cdc_payable == True or is_cdc_payment == True" readonly="state != 'draft'"/>
                <field name="cancel_id" string="Cancel Reason" invisible="state != 'canceled'" readonly="1"/>
            </xpath>

            <xpath expr="//field[@name='memo']" position="after">
                <field name="cdc_state" invisible="deposit_cdc_id == False"/>
                <field name="deposit_cdc_id" invisible="deposit_cdc_id == False"/>
                <field name="is_cdc_payment" invisible="1"/>
                <field name="cleared_cdc_payable_move_id"
                        invisible="cleared_cdc_payable_move_id == False"/>
            </xpath>
            <xpath expr="//group[@name='group2']" position="inside">
                <field name="cdc_bank_id" options="{'no_open': True, 'no_create': True}"
                       invisible="is_cdc_payment == False or is_cdc_payable" required="is_cdc_payment == True and not is_cdc_payable"/>
                <!-- <field name="due_date" invisible="is_cdc_payment == False"/> -->
                <field name="due_date" invisible="not is_cdc_payable and not is_cdc_payment" required="is_cdc_payable == True or is_cdc_payment == True" 
                       readonly="state != 'draft'" string="Due Date"/>
                <field name="cheque_owner_id" invisible="1"
                       options="{'no_open': True, 'no_create': True}"/>
                <field name="beneficiary_id" invisible="1"/>
                <field name="beneficiary_name" invisible="is_cdc_payment == False or is_cdc_payable"/>
                <field name="cheque_scanning" widget="image"
                       invisible="is_cdc_payment == False and is_cdc_payable == False" readonly="cdc_payable_state != 'draft'"/>
                <field name="cdc_payable_state" invisible="1" readonly="1"
                       force_save="1"/>
                <!-- <field name="due_date"
                       invisible="is_cdc_payable == False" required="is_cdc_payable == True or is_cdc_payment == True" readonly="state != 'draft'"
                       string="Due Date"/> -->
                <field name="cdc_payable_note"
                       invisible="is_cdc_payable == False"
                       string="CDC Note"/>
            </xpath>
            <xpath expr="//field[@name='journal_id']" position="after">
                <field name="is_cdc_payable" invisible="1"/>
            </xpath>

            <!-- smart button -->
            <div class="oe_button_box" position="inside">
                <!-- cdc receivable -->
                <!-- deposit -->
                <button class="oe_stat_button" name="action_open_cdc_receivable_deposit"
                        icon="fa-exchange"
                        type="object"
                        invisible="cdc_receivable_deposit_count == 0">
                    <field name="cdc_receivable_deposit_count" string="Deposits" widget="statinfo"/>
                </button>
                <!-- bounced in / out -->
                <button class="oe_stat_button" name="action_open_cdc_receivable_bounced_in_out"
                        icon="fa-reply"
                        type="object"
                        invisible="cdc_receivable_bounced_in_out_count == 0">
                    <field name="cdc_receivable_bounced_in_out_count" string="Bounced Bank Transactions"
                           widget="statinfo"/>
                </button>
                <!-- collected -->
                <button class="oe_stat_button" name="action_open_cdc_receivable_collected"
                        icon="fa-university"
                        type="object"
                        invisible="cdc_receivable_collected_count == 0">
                    <field name="cdc_receivable_collected_count" string="Collect Bank Transactions" widget="statinfo"/>
                </button>
                <!-- write-off -->
                <button class="oe_stat_button" name="action_open_cdc_receivable_writeoff"
                        icon="fa-usd"
                        type="object"
                        invisible="cdc_receivable_writeoff_count == 0">
                    <field name="cdc_receivable_writeoff_count" string="Write-Off" widget="statinfo"/>
                </button>
                <!-- Collection Fees -->
                <button class="oe_stat_button" name="action_open_cdc_receivable_collection_fees"
                        icon="fa-usd"
                        type="object"
                        invisible="cdc_receivable_collection_fees_count == 0">
                    <field name="cdc_receivable_collection_fees_count" string="Collection Fees" widget="statinfo"/>
                </button>
                <!-- recheque -->
                <button class="oe_stat_button" name="action_open_cdc_receivable_recheque"
                        icon="fa-refresh"
                        type="object"
                        invisible="cdc_receivable_recheque_count == 0">
                    <field name="cdc_receivable_recheque_count" string="Re-Cheque" widget="statinfo"/>
                </button>
                <!-- recycled -->
                <button class="oe_stat_button" name="action_open_cdc_receivable_recycled"
                        icon="fa-refresh"
                        type="object"
                        invisible="cdc_receivable_recycled_count == 0">
                    <field name="cdc_receivable_recycled_count" string="Recycled" widget="statinfo"/>
                </button>
                <!-- cashed -->
                <button class="oe_stat_button" name="action_open_cdc_receivable_cashed"
                        icon="fa-money"
                        type="object"
                        invisible="cdc_receivable_cashed_count == 0">
                    <field name="cdc_receivable_cashed_count" string="Cash Receipt" widget="statinfo"/>
                </button>
                <!-- cdc payable -->
                <!-- delivered -->
                <button class="oe_stat_button" name="action_open_cdc_payable_delivered_move"
                        icon="fa-university"
                        type="object"
                        invisible="cdc_payable_delivered_move_count == 0">
                    <field name="cdc_payable_delivered_move_count" string="Delivered Move(s)" widget="statinfo"/>
                </button>
                <!-- cleared -->
                <!-- <button class="oe_stat_button" name="action_open_cdc_payable_cleared_move"
                        icon="fa-university"
                        type="object"
                        invisible="cdc_payable_cleared_move_count == 0">
                    <field name="cdc_payable_cleared_move_count" string="Cleared Move(s)" widget="statinfo"/>
                </button> -->
                <!-- common cdc receivable / payable -->
                <!-- bounced -->
                <button class="oe_stat_button" name="action_open_cdc_receivable_bounced_move"
                        icon="fa-undo"
                        type="object"
                        invisible="cdc_receivable_bounced_move_count == 0 or is_cdc_payment == False">
                    <field name="cdc_receivable_bounced_move_count" string="Bounced Move(s)" widget="statinfo"/>
                </button>
                <field name="cheque_payment_id" invisible="1"/>
                <button class="oe_stat_button" name="action_open_related_cdc"
                        type="object" icon="fa-envelope-o"
                        invisible="cheque_payment_id == False or is_cdc_payment == False" >
                    <span>1 CDC</span>
                </button>
            </div>

            <xpath expr="//button[@name='action_open_pdc_receivable_bounced_move']" position="replace">
                <button class="oe_stat_button" name="action_open_pdc_receivable_bounced_move"
                        icon="fa-undo"
                        type="object"
                        invisible="pdc_receivable_bounced_move_count == 0 or is_pdc_payment == False">
                    <field name="pdc_receivable_bounced_move_count" string="Bounced Move(s)" widget="statinfo"/>
                </button>
            </xpath>
            <xpath expr="//button[@name='action_open_related_pdc']" position="replace">
                <button class="oe_stat_button" name="action_open_related_pdc"
                        type="object" icon="fa-envelope-o"
                        invisible="cheque_payment_id == False or is_pdc_payment == False" >
                    <span>1 PDC</span>
                </button>
            </xpath>
            <xpath expr="//widget[@name='web_ribbon']" position="after">
                <!-- CDC Receivable Ribbons -->
                <widget name="web_ribbon" title="Registered" data-id="cdc-registered"
                        invisible="is_cdc_payable or state != 'in_process' or is_cdc_payment == False or cdc_state != 'registered'"/>
                <widget name="web_ribbon" bg_color="bg-info" title="Bounced"
                        invisible="is_cdc_payable or is_cdc_payment == False or cdc_state != 'bounced'"/>
                <widget name="web_ribbon" bg_color="bg-danger" title="Cashed" data-id="cdc-cashed"
                        invisible="is_cdc_payable or is_cdc_payment == False or cdc_state != 'cashed'"/>
                <widget name="web_ribbon" bg_color="bg-danger" title="Recycled"
                        invisible="is_cdc_payable or is_cdc_payment == False or cdc_state != 'recycled'"/>
                <widget name="web_ribbon" bg_color="bg-danger" title="Re Chequed"
                        invisible="is_cdc_payable or is_cdc_payment == False or cdc_state != 're_cheque'"/>
                <widget name="web_ribbon" title="Remitted"
                        invisible="is_cdc_payable or is_cdc_payment == False or cdc_state != 'deposit'"/>
                <widget name="web_ribbon" title="Collected"
                        invisible="is_cdc_payable or is_cdc_payment == False or cdc_state != 'collected'"/>
                
                <!-- CDC Payable Ribbons -->
                <widget name="web_ribbon" title="Registered" data-id="cdc-payable-registered"
                        invisible="state != 'in_process' or is_cdc_payable == False or cdc_payable_state != 'registered'"/>
                <widget name="web_ribbon" bg_color="bg-danger" title="Bounced"
                        invisible="state == 'in_process' or is_cdc_payable == False or cdc_payable_state != 'bounced'"/>
                <widget name="web_ribbon" title="Cleared"
                        invisible="state != 'in_process' or is_cdc_payable == False or cdc_payable_state != 'cleared'"/>
                <widget name="web_ribbon" title="Delivered"
                        invisible="state != 'in_process' or is_cdc_payable == False or cdc_payable_state != 'delivered'"/>
            </xpath>
        </field>
    </record>

    <record id="account_payment_cdc_tree_inherit" model="ir.ui.view">
        <field name="name">account.payment.cdc.tree.inherit</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_method_line_id']" position="attributes">
                <attribute name="invisible">0</attribute>
            </xpath>
<!--            <xpath expr="//field[@name='partner_id']" position="after">-->
<!--                <field name="memo" string="Memo" optional="show"/>-->
<!--            </xpath>-->

        </field>
    </record>

    <record id="account_payment_search_inherit" model="ir.ui.view">
        <field name="name">account.payment.search.inherit</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='reconciled']" position="after">
                <separator/>
                <filter string="CDC Receivable" name="is_cdc_payment" domain="[('is_cdc_payment', '=', True)]"/>
                <filter string="CDC Payable" name="is_cdc_payable" domain="[('is_cdc_payable', '=', True)]"/>
            </xpath>
            <xpath expr="//filter[@name='state']" position="after">
                <filter string="CDC Receivable Status" name="cdc_state" domain="[]"
                        context="{'group_by': 'cdc_state'}"/>
                <filter string="CDC Payable Status" name="cdc_payable_state" domain="[]"
                        context="{'group_by': 'cdc_payable_state'}"/>
            </xpath>
        </field>
    </record>

    <record id="account_payment_kanban_inherit" model="ir.ui.view">
        <field name="name">account.payment.kanban.inherit</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="memo"/>
            </xpath>
            <xpath expr="//field[@name='currency_id']" position="after">
                <br/>
                <field name="memo"/>
            </xpath>
        </field>
    </record>

    <!-- cdc receivable views -->
    <record id="account_payment_cdc_receivable_form_inherit_primary" model="ir.ui.view">
        <field name="name">account.payment.cdc.receivable.form.inherit.primary</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account_pdc.account_payment_form_inherit"/>
        <field name="priority">80</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="cdc_state" position="move"/>
            </xpath>
            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='cdc_state']" position="attributes">
                <attribute name="attrs"></attribute>
                <attribute name="widget">statusbar</attribute>
                <attribute name="statusbar_visible">registered,deposit,collected</attribute>
            </xpath>
            <xpath expr="//field[@name='journal_id']" position="attributes">
                <attribute name="domain">[('type', '=', 'bank'), ('is_cdc','=',True)]</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_bank_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='payment_type']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="account_payment_cdc_receivable_tree_inherit_primary" model="ir.ui.view">
        <field name="name">account.payment.cdc.receivable.tree.inherit</field>
        <field name="model">account.payment</field>
        <field name="priority">80</field>
        <field name="mode">primary</field>
        <field name="inherit_id" ref="account_payment_cdc_tree_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
<!--            <xpath expr="//field[@name='memo']" position="attributes">-->
<!--                <attribute name="string">Cheque Number</attribute>-->
<!--            </xpath>-->
            <xpath expr="//field[@name='memo']" position="before">
                <field name="cdc_ref" string="Cheque Number"/>
            </xpath>
            <xpath expr="//field[@name='state']" position="after">
                <field name="cdc_state"
                       decoration-success="cdc_state == 'deposit'"
                       decoration-info="cdc_state == 'collected'"
                       decoration-warning="cdc_state == 'registered'"
                       decoration-muted="cdc_state == 'cashed'"
                       decoration-danger="cdc_state == 'recycled' or cdc_state == 're_cheque'"
                       widget="badge" string="Status" />
            </xpath>
            <xpath expr="//field[@name='date']" position="after">
                <field name="due_date"/>
                <field name="cdc_bank_id" options="{'no_open': True, 'no_create': True}"/>
            </xpath>

        </field>
    </record>

    <record id="account_payment_cdc_receivable_search_primary" model="ir.ui.view">
        <field name="name">account.payment.cdc.receivable.search.primary.inherit</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account_payment_search_inherit"/>
        <field name="mode">primary</field>
        <field name="priority">80</field>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='state_in_process']" position="after">
                <separator/>
                <filter string="Registered" name="is_cdc_registered" domain="[('cdc_state', '=', 'registered')]"/>
                <filter string="Deposit" name="is_cdc_deposit" domain="[('cdc_state', '=', 'deposit')]"/>
                <filter string="Collected" name="is_cdc_collect" domain="[('cdc_state', '=', 'collected')]"/>
                <filter string="Bounced" name="is_cdc_bounced" domain="[('cdc_state', '=', 'bounced')]"/>
                <filter string="Cashed" name="is_cdc_cashed" domain="[('cdc_state', '=', 'cashed')]"/>
                <filter string="Recycled" name="is_cdc_recycled" domain="[('cdc_state', '=', 'recycled')]"/>
                <filter string="Re Cheque" name="is_cdc_re_cheque" domain="[('cdc_state', '=', 're_cheque')]"/>
                <separator/>
                <filter string="Today Due Date" name="today_due_date" domain="[('due_date', '=', current_date)]"/>
                <filter string="Late Due Date" name="late_due_date" domain="[('due_date', '&lt;', current_date)]"/>
            </xpath>
            <xpath expr="//filter[@name='state']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//filter[@name='groupby_date']" position="attributes">
                <attribute name="string">Creation Date</attribute>
            </xpath>
            <xpath expr="//filter[@name='groupby_date']" position="after">
                <filter string="Due Date" name="groupby_due_date" domain="[]" context="{'group_by': 'due_date'}"/>
                <filter string="Cheque Owner" name="groupby_cheque_owner" domain="[]"
                        context="{'group_by': 'cheque_owner_id'}"/>
            </xpath>
        </field>
    </record>

    <record id="account_payment_cdc_receivable_action" model="ir.actions.act_window">
        <field name="name">CDC Receivable</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">list,kanban,form,graph</field>
        <field name="context">{
