    <!-- cdc payable views -->
    <record id="account_payment_cdc_payable_form_inherit_primary" model="ir.ui.view">
        <field name="name">account.payment.cdc.payable.form.inherit.primary</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account_pdc.account_payment_form_inherit"/>
        <field name="priority">80</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="cdc_payable_state" position="move"/>
            </xpath>
            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='cdc_payable_state']" position="attributes">
                <attribute name="attrs"></attribute>
                <attribute name="widget">statusbar</attribute>
                <attribute name="statusbar_visible">draft,registered,delivered,cleared</attribute>
            </xpath>
            <xpath expr="//field[@name='journal_id']" position="attributes">
                <attribute name="domain">[('type', '=', 'bank'), ('cdc_notes_payable_account_id','!=',False)]</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_bank_id'][2]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='payment_type']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_id'][2]" position="attributes">
                <attribute name="string">Issued To</attribute>
            </xpath>

        </field>
    </record>

    <record id="account_payment_cdc_payable_tree_inherit_primary" model="ir.ui.view">
        <field name="name">account.payment.cdc.payable.tree.inherit</field>
        <field name="model">account.payment</field>
        <field name="priority">80</field>
        <field name="mode">primary</field>
        <field name="inherit_id" ref="account_payment_cdc_tree_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
<!--            <xpath expr="//field[@name='memo']" position="attributes">-->
<!--                <attribute name="string">Cheque Number</attribute>-->
<!--            </xpath>-->
            <xpath expr="//field[@name='memo']" position="before">
                <field name="cdc_ref" string="Cheque Number"/>
            </xpath>
            <xpath expr="//field[@name='state']" position="after">
                <field name="cdc_payable_state"
                       decoration-success="cdc_payable_state == 'registered'"
                       decoration-info="cdc_payable_state == 'cleared'"
                       decoration-warning="cdc_payable_state == 'draft'"
                       decoration-muted="cdc_payable_state == 'cashed'"
                       decoration-danger="cdc_payable_state == 'cancel'"
                       widget="badge" string="Status"/>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="string">Issued To</attribute>
            </xpath>
            <xpath expr="//field[@name='date']" position="after">
                <field name="due_date"/>
            </xpath>
        </field>
    </record>

    <record id="account_payment_cdc_payable_search_primary" model="ir.ui.view">
        <field name="name">account.payment.cdc.payable.search.primary.inherit</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account_payment_search_inherit"/>
        <field name="mode">primary</field>
        <field name="priority">80</field>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='state_in_process']" position="after">
                <separator/>
                <filter string="Draft" name="is_cdc_payable_draft" domain="[('cdc_payable_state', '=', 'draft')]"/>
                <filter string="Registered" name="is_cdc_payable_registered"
                        domain="[('cdc_payable_state', '=', 'registered')]"/>
                <filter string="Cleared" name="is_cdc_payable_cleared"
                        domain="[('cdc_payable_state', '=', 'cleared')]"/>
                <filter string="Bounced" name="is_cdc_payable_bounced"
                        domain="[('cdc_payable_state', '=', 'bounced')]"/>
                <separator/>
                <filter string="Today Due Date" name="today_due_date" domain="[('due_date', '=', current_date)]"/>
                <filter string="Late Due Date" name="late_due_date" domain="[('due_date', '&lt;', current_date)]"/>
            </xpath>
            <xpath expr="//filter[@name='state']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//filter[@name='groupby_date']" position="attributes">
                <attribute name="string">Reg. Date</attribute>
            </xpath>
            <xpath expr="//filter[@name='groupby_date']" position="after">
                <filter string="Due Date" name="groupby_due_date" domain="[]" context="{'group_by': 'due_date'}"/>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="string">Issued To</attribute>
            </xpath>
            <xpath expr="//filter[@name='cdc_state']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//filter[@name='cdc_payable_state']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//filter[@name='is_cdc_payment']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//filter[@name='is_cdc_payable']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//filter[@name='inbound_filter']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//filter[@name='outbound_filter']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//filter[@name='state_draft']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//filter[@name='state_in_process']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//filter[@name='state_sent']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//filter[@name='unmatched']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//filter[@name='paymentmethodline']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//filter[@name='state']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//filter[@name='date']" position="attributes">
                <attribute name="string">Date</attribute>
            </xpath>
            <xpath expr="//filter[@name='partner']" position="attributes">
                <attribute name="string">Issued To</attribute>
            </xpath>
        </field>
    </record>

