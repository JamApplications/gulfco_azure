    <record id="account_payment_inherit_form_inherit_custom_payment_mode_cdc_extra" model="ir.ui.view">
        <field name="name">account.payment.form.inherit</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account_cdc.account_payment_inherit_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_amount']" position="attributes">
                <attribute name="readonly">custom_workflow_state != 'draft'</attribute>
            </xpath>

            <xpath expr="//field[@name='advance_amount']" position="attributes">
                <attribute name="readonly">custom_workflow_state != 'draft'</attribute>
            </xpath>
        </field>
    </record>

    <record id="account_payment_inherit_form_inherit_custom_payment_mode_pdc_extra" model="ir.ui.view">
        <field name="name">account.payment.form.inherit</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account_pdc.account_payment_inherit_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_amount']" position="attributes">
                <attribute name="readonly">custom_workflow_state != 'draft'</attribute>
            </xpath>
            <xpath expr="//field[@name='advance_amount']" position="attributes">
                <attribute name="readonly">custom_workflow_state != 'draft'</attribute>
            </xpath>
        </field>
    </record>

