<odoo>
    <data noupdate="0">
        <record id="ir_cron_auto_set_customer_on_hold" model="ir.cron">
            <field name="name">Auto Credit Hold Check</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="state">code</field>
            <field name="code">model.search([]).check_auto_hold_conditions()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now()+ timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
