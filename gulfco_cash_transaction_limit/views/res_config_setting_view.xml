<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_account_settings_inherit" model="ir.ui.view">
            <field name="name">account.config.settings.inherit.cash.limit</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="account.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//block[@id='storno']" position="after">
                    <block title="Cash Limit" id="cash_limit" groups="account.group_account_user">
                        <setting id="enable_cash_limit" company_dependent="1" help="Enable Cash Limit"
                                 title="Allows you to use cash limit.">
                            <field name="enable_cash_transaction_limit"/>
                        </setting>
                    </block>
                </xpath>
            </field>
        </record>


    </data>
</odoo>