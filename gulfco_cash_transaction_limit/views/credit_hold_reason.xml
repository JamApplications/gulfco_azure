<odoo>

    <record id="credit_hold_reason_tree" model="ir.ui.view">
        <field name="name">Credit Hold Reasons</field>
        <field name="model">credit.hold.reason</field>
        <field name="arch" type="xml">
            <list string="Credit Hold Reason">
                <field name="name"/>
                <field name="reason"/>
            </list>
        </field>
    </record>


    <record id="action_credit_hold_reason" model="ir.actions.act_window">
        <field name="name">Credit Hold Reasons</field>
        <field name="res_model">credit.hold.reason</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="credit_hold_reason_tree"/>
    </record>

    <menuitem id="menu_credit_hold_reason_root"
              name="Credit Hold Reasons"
              parent="sale.menu_sale_config"
              action="gulfco_cash_transaction_limit.action_credit_hold_reason"
              sequence="100"/>
</odoo>