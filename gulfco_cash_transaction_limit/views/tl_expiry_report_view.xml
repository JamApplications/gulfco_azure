<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="tl_expiry_report_tree" model="ir.ui.view">
        <field name="name">TL Expiry Customer Report</field>
        <field name="model">tl.expiry.report</field>
        <field name="arch" type="xml">
            <list string="Credit Hold Reason">
                <field name="customer_id"/>
                <field name="customer_name" column_invisible="1"/>
                <field name="customer_code"/>
                <field name="trade_number"/>
                <field name="tl_expiry_date"/>
                <field name="expiry_status"  widget="badge"
                   decoration-danger="expiry_status == 'expired'"
                   decoration-warning="expiry_status == 'expiring_soon'"
                   decoration-success="expiry_status == 'valid'"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="is_credit_hold" column_invisible="1"/>
                <field name="credit_hold_reason" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="action_tl_expiry_report" model="ir.actions.act_window">
        <field name="name">TL Expiry Customer Report</field>
        <field name="res_model">tl.expiry.report</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="tl_expiry_report_tree"/>
    </record>

    <menuitem id="menu_tl_expiry_report"
              name="TL Expiry Report"
              parent="sale.menu_sale_report"
              action="action_tl_expiry_report"/>

</odoo>