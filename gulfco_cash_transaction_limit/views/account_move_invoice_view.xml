<odoo>
    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.view.form.inherit.exchange.currency.rate</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
<!--             <xpath expr="//field[@name='state']" position="attributes">-->
<!--                <attribute name="statusbar_visible">draft,awaiting_credit_approval,posted</attribute>-->
<!--            </xpath>-->

            <xpath expr="//button[@name='action_post']" position="after">

                  <button name="action_approve_order_limit" type="object" string="Release"
                        invisible="state != 'waiting_for_release'"  class="btn-primary"
                        groups="gulfco_contact_registration_custom.group_credit_officer_approval"/>

                <button name="action_approve_credit_override_move" type="object" string="Approve Credit Override"
                        invisible="state != 'awaiting_credit_approval'"  class="btn-primary"
                        groups="gulfco_contact_registration_custom.group_credit_officer_approval"/>
                <button name="action_reject_credit_override_move" type="object" string="Reject"
                        invisible="state != 'awaiting_credit_approval'"  class="btn-primary"
                        groups="gulfco_contact_registration_custom.group_credit_officer_approval"/>
            </xpath>
            <xpath expr="//header/button[@name='action_post'][2]" position="replace">
                <field name="credit_override_requested" invisible="1"/>
                <field name="order_limit_requested" invisible="1"/>
                <button name="action_post" string="Confirm" class="oe_highlight"
                                type="object" groups="account.group_account_invoice" data-hotkey="q"
                                context="{'validate_analytic': True, 'disable_abnormal_invoice_detection': False}"
                                invisible="state in ['waiting_for_release','awaiting_credit_approval'] or hide_post_button or move_type == 'entry' or display_inactive_currency_warning"/>

                <button name="action_post" string="Confirm" class="oe_highlight"
                        type="object" data-hotkey="q"
                        groups="account.group_account_invoice,gulfco_contact_registration_custom.group_ccd_approval,!gulfco_contact_registration_custom.group_credit_officer_approval"
                        context="{'validate_analytic': True, 'disable_abnormal_invoice_detection': False}"
                        invisible="state not in ['awaiting_credit_approval']"/>
            </xpath>

            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="credit_override_requested" invisible="1"/>
                <field name="order_limit_requested" invisible="1"/>
            </xpath>

        </field>
    </record>

</odoo>