<odoo>
  <record id="ir_cron_deactivate_expired_notifications" model="ir.cron">
    <field name="name">Deactivate Expired Notification Configs</field>
    <field name="model_id" ref="model_notification_config"/>
    <field name="state">code</field>
    <field name="code">model._deactivate_expired_configs()</field>
    <field name="interval_number">1</field>
    <field name="interval_type">daily</field>
    <field name="active">True</field>
  </record>
</odoo>
