<odoo>

    <!-- Form View -->
    <record id="view_notification_config_form" model="ir.ui.view">
        <field name="name">notification.config.form</field>
        <field name="model">notification.config</field>
        <field name="arch" type="xml">
            <form string="Notification Configuration">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="active" readonly="1"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group>
                            <field name="model_id" />
                            <field name="group_ids" widget="many2many_tags"/>
                            <field name="user_ids" readonly="1" widget="many2many_tags"/>
                            <field name="notify_users" widget="many2many_tags"/>
                        </group>
                    </group>

                    <group string="Trigger on These States">
                        <!-- clickable checkboxes -->
                    <field name="selected_states"
                            widget="many2many_checkboxes"
                            options="{'no_create': True}"
                            domain="[('id','in', state_field_values)]"/>
                    </group>


                    <group string="Available States">
                        <!-- optional read-only list of all available -->
                        <field name="state_field_values" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_notification_config_tree" model="ir.ui.view">
        <field name="name">notification.config.list</field>
        <field name="model">notification.config</field>
        <field name="arch" type="xml">
            <list string="Notification Configurations">
                <field name="name"/>
                <field name="model_id"/>
                <field name="group_ids"/>
                <field name="user_ids"/>
                <field name="notify_users" />
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="active"/>
            </list>
        </field>
    </record>


    <!-- Action -->
    <record id="action_notification_config" model="ir.actions.act_window">
        <field name="name">Notification Configurations</field>
        <field name="res_model">notification.config</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_create">
                Click to create a new Notification Configuration.
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_notification_root"
              name="Notification Management"
              sequence="20"/>

    <menuitem id="menu_notification_config"
            name="Notification Configuration"
            parent="menu_notification_root"
            action="action_notification_config"
            sequence="1"/>

</odoo>
