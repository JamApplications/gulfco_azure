<odoo>
    <record id="purchase_order_form" model="ir.ui.view">
        <field name="name">purchase.order.form</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form" />
        <field name="arch" type="xml">
<!--            <xpath expr="//form" position="attributes">-->
<!--                <attribute name="js_class">is_readonly_purchase</attribute>-->
<!--            </xpath>-->
            <xpath expr="//field[@name='order_line']/list" position="inside">
                <field name="purchase_request_lines" column_invisible="1" />
                <button
                    invisible="not purchase_request_lines"
                    name="action_open_request_line_tree_view"
                    title="Request Lines"
                    type="object"
                    icon="fa-folder-open-o"
                />
            </xpath>
        </field>
    </record>
    <record id="purchase_order_line_form2" model="ir.ui.view">
        <field name="name">purchase.order.line.form2</field>
        <field name="model">purchase.order.line</field>
        <field name="inherit_id" ref="purchase.purchase_order_line_form2" />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <separator string="Purchase Request Lines" />
                <field name="purchase_request_lines" />
            </field>
        </field>
    </record>
    <record id="purchase_order_line_tree" model="ir.ui.view">
        <field name="name">purchase.order.line.list</field>
        <field name="model">purchase.order.line</field>
        <field name="inherit_id" ref="purchase.purchase_order_line_tree" />
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="purchase_request_lines" column_invisible="1" />
                <button
                    invisible="not purchase_request_lines"
                    name="action_open_request_line_tree_view"
                    title="Request Lines"
                    type="object"
                    icon="fa-folder-open-o"
                />
            </xpath>
        </field>
    </record>
    <record id="gulfco_purchase_stock_order_view_form_inherit" model="ir.ui.view">
        <field name="name">gulfco.purchase.stock.order.view.form.inherit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase_stock.purchase_order_view_form_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='picking_type_id']" position="attributes">
                <attribute name="readonly">state not in ('draft', 'sent')</attribute>
            </xpath>
        </field>
    </record>
    <record id="gulfco_view_order_form_inherit_project_purchase" model="ir.ui.view">
        <field name="name">gulfco.view.order.form.inherit.project.purchase</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="project_purchase.view_order_form_inherit_project_purchase"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='project_id']" position="attributes">
                <attribute name="readonly">state not in ('draft', 'sent')</attribute>
            </xpath>
        </field>
    </record>
</odoo>
