<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_report_view_list" model="ir.ui.view">
        <field name="name">sale.report.view.list</field>
        <field name="model">sale.report.view</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="partner_shipping_id"/>
                <field name="assign_to"/>
                <field name="date_order"/>
                <field name="state"/>
                <field name="delivery_status"/>
                <field name="invoice_status"/>
                <field name="product_id"/>
                <field name="product_packaging_id"/>
                <field name="product_packaging_qty"/>
                <field name="product_packaging_price"/>
                <field name="product_uom_qty"/>
                <field name="price_unit"/>
                <field name="qty_delivered"/>
                <field name="qty_invoiced"/>
                <field name="exercise_price"/>
                <field name="discount_amount"/>
                <field name="discount"/>
                <field name="price_subtotal"/>
                <field name="price_tax"/>

                <field name="customer_code"/>
                <field name="partner_channel_id"/>
                <field name="outlet_id"/>
                <field name="sub_outlet_id"/>
                <field name="customer_type"/>
                <field name="customer_group_id"/>
                <field name="customer_subdivision_id"/>
                <field name="default_code"/>
                <field name="categ_id"/>
                <field name="brand_id"/>
                <field name="division"/>

            </list>
        </field>
    </record>


    <record id="action_sale_report_view" model="ir.actions.act_window">
        <field name="name">Sale Order Report View</field>
        <field name="res_model">sale.report.view</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_sale_report_view_root"
              name="Sale Order Report View"
              parent="sale.menu_sale_report"
              action="action_sale_report_view"/>
</odoo>
