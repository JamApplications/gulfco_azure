<?xml version="1.0" encoding="utf-8"?>
<odoo>
     <record id="sales_customer_mapping_tree_view" model="ir.ui.view">
        <field name="name">customer.mapping.list</field>
        <field name="model">customer.mapping</field>
        <field name="arch" type="xml">
            <list>
                <field name="customer_id"/>
            </list>
        </field>
    </record>



    <record id="sales_customer_mapping_form_view" model="ir.ui.view">
        <field name="name">customer.mapping.form.view</field>
        <field name="model">customer.mapping</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                       <field name="customer_id"/>
                       <field name="location_id" context="{'customer_id': customer_id}"/>
                    </group>

                    <separator/>
                    <notebook>
                        <page name="Customer_mapping" string="Customer Mapping">
                            <field name="customer_map_lines">
                                <list editable="bottom">
                                    <field name="worker_id" options="{'no_create': True}"/>
                                    <field name="division"/>
                                    <field name="categ_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="action_sales_customer_mapping" model="ir.actions.act_window">
        <field name="name">Customer Mapping</field>
        <field name="res_model">customer.mapping</field>
        <field name="view_mode">list,form</field>
    </record>





    <menuitem id="menu_sales_customer_mapping"
              name="Customer Mapping"
              parent="sale.menu_sale_config"
              action="action_sales_customer_mapping"
              sequence="20"/>




</odoo>