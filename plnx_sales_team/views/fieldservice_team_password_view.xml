<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sales_team_password_configuration_tree_view" model="ir.ui.view">
        <field name="name">team.password.config.list</field>
        <field name="model">team.password.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="prefix"/>
                <field name="no_of_sequence"/>
                <field name="suffix"/>
                <field name="state"/>
            </list>
        </field>
    </record>


    <record id="sales_team_password_configuration_form_view" model="ir.ui.view">
        <field name="name">team.password.config.form.view</field>
        <field name="model">team.password.config</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_inactive" invisible="state == 'inactive'" type="object" string="Inactive"
                            class="btn-primary"/>
                    <button name="action_active" invisible="state == 'active'" type="object" string="Active"
                            class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="active,inactive"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="state == 'active'"/>
                            <field name="no_of_sequence" readonly="state == 'active'"/>
                        </group>
                        <group>
                            <field name="prefix" readonly="state == 'active'"/>
                            <field name="suffix" readonly="state == 'active'"/>
                            <field name="sequence" invisible="0"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_sales_team_password_configuration" model="ir.actions.act_window">
        <field name="name">Password Configuration</field>
        <field name="res_model">team.password.config</field>
        <field name="view_mode">list,form</field>
    </record>


    <menuitem id="menu_sales_team_password_configuration"
              name="Password Configuration"
              parent="fieldservice.menu_fsm_config_person"
              action="action_sales_team_password_configuration"
              sequence="20"/>


</odoo>