<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Views for outlet.channel -->
    <record id="view_outlet_channel_tree" model="ir.ui.view">
        <field name="name">outlet.channel.tree</field>
        <field name="model">outlet.channel</field>
        <field name="arch" type="xml">
            <list>
                <field name="channel_name_id"/>
                <field name="outlet_name"/>
                <field name="sub_outlet_ids"/>
            </list>
        </field>
    </record>

    <record id="view_outlet_channel_form" model="ir.ui.view">
        <field name="name">outlet.channel.form</field>
        <field name="model">outlet.channel</field>
        <field name="arch" type="xml">
            <form string="Outlet Channel">
                <sheet>
                    <group>
                        <field name="outlet_name" options="{'no_create': False}"/>
                        <field name="channel_name_id" options="{'no_create': False}"/>
                    </group>
                    <notebook>
                        <page string="Sub Outlets">
                            <field name="sub_outlet_ids">
                                <list editable="bottom">
                                    <field name="sub_outlet_name" options="{'no_create': False}"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>


    <!-- Views for sub.outlet.channel -->
    <record id="view_sub_outlet_channel_tree" model="ir.ui.view">
        <field name="name">sub.outlet.channel.tree</field>
        <field name="model">sub.outlet.channel</field>
        <field name="arch" type="xml">
            <list>
                <field name="sub_outlet_name"/>
                <field name="outlet_id"/>
            </list>
        </field>
    </record>

    <record id="view_sub_outlet_channel_form" model="ir.ui.view">
        <field name="name">sub.outlet.channel.form</field>
        <field name="model">sub.outlet.channel</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="sub_outlet_name"/>
                        <field name="outlet_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_outlet_channel" model="ir.actions.act_window">
        <field name="name">Customer Channel</field>
        <field name="res_model">outlet.channel</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menus -->
    <menuitem id="menu_customer_channels_root"
              name="Customer Channels"
              parent="contacts.menu_partner_category_form"
              sequence="3"/>

    <menuitem id="menu_outlet_channel"
              name="Customer Channel"
              parent="menu_customer_channels_root"
              action="action_outlet_channel"
              sequence="2"/>
</odoo>
