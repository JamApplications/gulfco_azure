<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_stock_request_order_form_inherit" model="ir.ui.view">
        <field name="name">stock.request.order.form.inherit.custom</field>
        <field name="model">stock.request.order</field>
        <field name="inherit_id" ref="stock_request_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//page[@name='items']" position="after">
                <field name="direction" invisible="1"/>
                <page string="Additional Info" invisible="direction not in ['stock_takeover']">
                    <group>
                        <group>
                            <field name="new_stockkeeper"
                                   string="New Stock keeper"
                                    domain="[('id', 'in', stock_keeper_user_ids)]"
                                   options="{'no_create': True, 'no_open': True}"/>

                            <field name="stock_keeper_user_ids"
                                    invisible="1"/> 
                        </group>
                        <group>
                            <field name="reason_for_hand_over"
                                   string="Reason for Hand Over"
                                   widget="binary"/>
                        </group>
                    </group>
                </page>
            </xpath>

            <xpath expr="//div[@name='button_box']//button[@name='action_view_stock_requests']" position="after">
                <button name="open_picking"
                        type="object"
                        string="View Transfer"
                        icon="fa-truck"
                        class="oe_stat_button"
                        invisible="not picking_id  or state in ['draft']"
                        groups="stock.group_stock_user"/>
                <button class="oe_stat_button" name="action_open_stock_scrap"
                        type="object"
                        invisible="scrap_count == 0">
                    <field name="scrap_count" string="Scraps" widget="statinfo"/>
                </button>
            </xpath>


            <xpath expr="//field[@name='expected_date']" position="before">
                <field name="customer_id"
                       string="VAN"
                       options="{'no_create': True, 'no_open': True}"
                       invisible="direction  not in ('van_load','van_off_load')"
                />
                <field name="customer_id"
                       string="Vendor"
                       options="{'no_create': True, 'no_open': True}"
                       invisible="direction not in ('foc_receiving','miscellaneous_receiving')"
                />
                <field name="customer_id"
                       options="{'no_create': True, 'no_open': True}"
                       invisible="direction in ('van_load','van_off_load','foc_receiving','miscellaneous_receiving','damage_expiry_issue_out','miscellaneous_issue_out')"
                />
                <field name="customer_id" string="Re-Cycle Company"
                       options="{'no_create': True, 'no_open': True}"
                       invisible="direction not in ('damage_expiry_issue_out','miscellaneous_issue_out')"
                />
                <field name="picking_id" readonly="1" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="product_packaging_id" options="{'no_create': True, 'no_open': True}"/>
                <field name="product_packaging_qty"/>
            </xpath>
            <xpath expr="//field[@name='product_uom_id']" position="after">
<!--                <field name="is_claimable"-->
<!--                column_invisible="parent.direction not in ['sample_issue_out', 'damage_expiry_issue_out']"/>-->
<!--                <field name="percentage" -->
<!--                      column_invisible="parent.direction not in ['sample_issue_out', 'damage_expiry_issue_out']"-->
<!--                       required="is_claimable == True"-->
<!--                />-->
                <field name="user_has_scd_approval" column_invisible="1"/>
                <field name="cost"
                        column_invisible="parent.direction not in ['foc_receiving','miscellaneous_receiving','damage_expiry_issue_out','miscellaneous_issue_out','consumable_issuance','sample_issue_out']"
                        readonly="not user_has_scd_approval"
                        sum="Total"
                        help="Only users in the Stock Keeper group can edit this field."/>

            </xpath>
            <xpath expr="//field[@name='warehouse_id']" position="before">
                <field name="direction"
                        readonly="state != 'draft'"
                        options="{'no_create': True, 'no_open': True}"
                        required="state == 'draft'"
                />
                <field name="move_type" invisible="1"/>
                <field name="move_type_id"
                       required="direction in ['internal_transfer'] or (direction == 'consumable_issuance' and consumable_issuance_type == 'internal')"
                       invisible="direction not in ['internal_transfer','consumable_issuance'] or (direction == 'consumable_issuance' and consumable_issuance_type != 'internal')"/>
                <field name="consumable_issuance_type" widget="radio" options="{'horizontal': true}" invisible="direction != 'consumable_issuance'"/>
            </xpath>
            <xpath expr="//field[@name='location_id']" position="after">
                <field name="destination_id"
                       readonly="state != 'draft'"
                       options="{'no_create': True, 'no_open': True}"
                       groups="stock.group_stock_multi_locations"
                       required="direction in ('internal_transfer','scrap_issuance') or (direction == 'consumable_issuance' and consumable_issuance_type == 'internal')"
                       invisible="direction not in ('internal_transfer','consumable_issuance') or (direction == 'consumable_issuance' and consumable_issuance_type != 'internal')"
                       context="{'stock_request_direction': direction,'stock_request_warehouse_id':warehouse_id,'is_destination':1}"
                />
                <field name="destination_damage_id"
                       readonly="state != 'draft'"
                       options="{'no_create': True, 'no_open': True}"
                       groups="stock.group_stock_multi_locations"
                       required="direction in ('damage_expiry_issue_out','miscellaneous_issue_out','miscellaneous_receiving')"
                       invisible="direction not in ('damage_expiry_issue_out','scrap_issuance','miscellaneous_issue_out','miscellaneous_receiving')"
                       context="{'stock_request_direction': direction,'stock_request_warehouse_id':warehouse_id,'is_destination':1}"
                />

            </xpath>

             <xpath expr="//group" position="after">
                 <group invisible="direction not in ('stock_takeover')">
                     <group>
                    <field name="reason_handover_id"/>
                     </group>
                     <group>
                         <label string="Handover Period" for="handover_period_from"/>
                            <div class="d-flex align-items-center" style="gap: 8px;">
                                <field name="handover_period_from" placeholder="From"/>
                                <label string="to" for="handover_period_to"/>
                                <field name="handover_period_to" placeholder="To"/>
                            </div>
                     </group>
                </group>

             </xpath>
            <xpath expr="//field[@name='picking_policy']" position="after">


                <field name="delivery_required"
                       string="Delivery Required"
                       invisible="direction not in ['sample_issue_out']"
                />
                <field name="number_of_pallet" invisible="direction not in ['damage_expiry_issue_out','miscellaneous_issue_out']"/>

                <field name="is_claimable"
                invisible="direction not in ['sample_issue_out', 'damage_expiry_issue_out','miscellaneous_issue_out']"/>
                <field name="percentage" invisible="direction not in ['sample_issue_out', 'damage_expiry_issue_out','miscellaneous_issue_out']"
                       required="is_claimable == True"
                />
            </xpath>
            <xpath expr="//field[@name='procurement_group_id']" position="attributes">
<!--                <attribute name="groups">stock.group_adv_location</attribute>-->
<!--                <attribute name="invisible">direction in ('van_load', 'van_off_load', 'stock_takeover')</attribute>-->
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='location_id']" position="attributes">
                <attribute name="groups">stock.group_adv_location</attribute>
                <attribute name="required">direction in ('internal_transfer','damage_expiry_issue_out','scrap_issuance','miscellaneous_issue_out','miscellaneous_receiving') or (direction == 'consumable_issuance' and consumable_issuance_type == 'internal')</attribute>
                <attribute name="context">{'stock_request_direction': direction,'stock_request_warehouse_id':warehouse_id}</attribute>
                <attribute name="invisible">direction not in ('internal_transfer', 'stock_takeover', 'damage_expiry_issue_out','miscellaneous_issue_out','scrap_issuance','consumable_issuance','miscellaneous_receiving') or (direction == 'consumable_issuance' and consumable_issuance_type != 'internal')</attribute>
            </xpath>
            <xpath expr="//page[@name='items']" position="attributes">
                <attribute name="invisible">direction == 'stock_takeover'</attribute>
            </xpath>
        </field>
    </record>

   <record id="view_product_product_filter_inherit" model="ir.ui.view">
        <field name="name">product.product.search.inherit</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="stock.product_search_form_view_stock"/>
        <field name="arch" type="xml">

        <xpath expr="//search" position="inside">
            <field name="supplier_classification_id"/>
<!--            <field name="supplier_classification"/>-->
        </xpath>
        <xpath expr="//search/field[@name='categ_id']" position="after">
            <filter name="filter_principle_vendor"
                    string="Supplier Classification"
                    domain="[('seller_ids.partner_id.supplier_classification_id.is_filtered',
                    '=', True)]"/>
        </xpath>
        </field>
    </record>
</odoo>
