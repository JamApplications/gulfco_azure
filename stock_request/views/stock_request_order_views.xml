<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="action_stock_request_order_approve_request" model="ir.actions.server">
        <field name="name">Approve</field>
        <field name="model_id" ref="stock_request.model_stock_request_order"/>
        <field name="binding_model_id" ref="stock_request.model_stock_request_order"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_approve()</field>
        <field name="sequence" eval="1"/>
    </record>

    <record id="action_stock_request_order_confirm_request" model="ir.actions.server">
        <field name="name">Confirm</field>
        <field name="model_id" ref="stock_request.model_stock_request_order"/>
        <field name="binding_model_id" ref="stock_request.model_stock_request_order"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_confirm()</field>
        <field name="sequence" eval="2"/>
    </record>

    <record id="action_stock_request_order_delivery_for_recycling" model="ir.actions.server">
        <field name="name">Deliver for Recycling</field>
        <field name="model_id" ref="stock_request.model_stock_request_order"/>
        <field name="binding_model_id" ref="stock_request.model_stock_request_order"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_delivery_recycle_wiz()</field>
        <field name="sequence" eval="3"/>
    </record>



    <record model="ir.ui.view" id="stock_request_order_tree">
        <field name="name">stock.request.order.tree</field>
        <field name="model">stock.request.order</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="customer_id"/>
                <field name="expected_date"/>
                <field name="warehouse_id" groups="stock.group_stock_multi_locations" />
                <field name="to_warehouse_id" string="Destination Warehouse"/>
                <field name="location_id" groups="stock.group_stock_multi_locations" />
                <field name="total_value" optional="show"/>
                <field name="state" />
            </list>
        </field>
    </record>
    <record model="ir.ui.view" id="stock_request_order_form">
        <field name="name">stock.request.order.form</field>
        <field name="model">stock.request.order</field>
        <field name="arch" type="xml">
            <form>
                <header>

                    <button
                        name="action_confirm"
                        string="Confirm"
                        type="object"
                        invisible="state not in ['draft']"
                    />
                    <button name="action_delivery_recycle_wiz" type="object"
                            string="Deliver for Recycling" class="btn-primary"
                            invisible="state not in ['done'] or direction not in ['damage_expiry_issue_out','miscellaneous_issue_out']"/>
<!--                    <button name="%(stock_request.action_stock_select_delivery_for_recycle)d"-->
<!--                            string="Deliver for Recycling"-->
<!--                            class="btn-primary"-->
<!--                            type="action"-->
<!--                            invisible="state not in ['done'] or direction not in ['damage_expiry_issue_out']"/>-->
                    <button
                        name="action_cancel"
                        invisible="state not in ['draft','open']"
                        type="object"
                        string="Cancel"
                    />
                    <button
                        name="action_draft"
                        invisible="state not in ['cancel']"
                        type="object"
                        string="Set to Draft"
                    />
                    <button name="%(stock_request.action_stock_select_multi_product_wizard)d" type="action" class="btn-primary"
                        invisible="state != 'draft' or direction in ('internal_transfer', 'stock_takeover')" string="Select Products"/>

<!-- hide button of load done cause it should be by van only -->
<!--                    <button name="action_van_load_done"-->
<!--                            type="object"-->
<!--                            string="Load is Done"-->
<!--                            class="btn-primary"-->
<!--                            invisible="direction not in ('van_load') or state in ('draft','submitted','done')"/>-->
<!--                        attrs="{'invisible': [('direction', '!=', 'van_load'), ('state', '=', 'done')]}"/>-->

                     <button
                        name="action_reject"
                        invisible="state in ['draft', 'rejected', 'cancel', 'done', 'delivery_recycle']"
                        type="object"
                        string="Reject"
                    />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <field name="picking_ids" invisible="1" />
                        <button
                            type="object"
                            name="action_view_transfer"
                            class="oe_stat_button"
                            icon="fa-truck"
                            invisible="picking_count == 0 or direction not in ('internal_transfer', 'branch_transfer',
                            'sample_issue_out', 'foc_receiving','miscellaneous_receiving', 'consumable_issuance', 'van_load', 'van_off_load')"
                            groups="stock.group_stock_user"
                        >
                            <field
                                name="picking_count"
                                widget="statinfo"
                                string="Transfers"
                            />
                        </button>
                        <button
                            type="object"
                            name="action_view_stock_requests"
                            class="oe_stat_button"
                            icon="fa-chain"
                            invisible="state == 'draft'"
                            groups="stock.group_stock_user"
                        >
                            <field
                                name="stock_request_count"
                                widget="statinfo"
                                string="Stock Requests"
                            />
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Stock request Order" />
                        <h1>
                            <field name="name" readonly="1" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="expected_date" readonly="state != 'draft'" />
                            <field name="picking_policy" readonly="state != 'draft'" />
                            <field name="total_value"/>
                        </group>
                        <group>
                            <field
                                name="warehouse_id"
                                readonly="state != 'draft'"
                                options="{'no_create': True, 'no_open': True}"
                                groups="stock.group_stock_multi_locations"
                            />
                            <field name="to_warehouse_id"
                                   readonly="state != 'draft'"
                                   options="{'no_create': True, 'no_open': True}"
                                   groups="stock.group_stock_multi_locations"
                                   invisible="direction not in  ['branch_transfer','consumable_issuance'] or (direction == 'consumable_issuance' and consumable_issuance_type != 'branch')"
                            />
                            <field
                                name="location_id"
                                readonly="state != 'draft'"
                                options="{'no_create': True, 'no_open': True}"
                                groups="stock.group_stock_multi_locations"
                            />
                            <field name="allow_virtual_location" invisible="1" />
                            <field name="route_ids" invisible="1" />
                            <field
                                name="route_id"
                                groups="stock.group_stock_multi_locations"
                                readonly="state != 'draft'"
                                force_save="1"
                                domain="[('id','in',route_ids)]"
                                    required="direction in ['sample_issue_out','foc_receiving','van_load','van_off_load','branch_transfer'] or (direction == 'consumable_issuance' and consumable_issuance_type == 'branch')"
                                options="{'no_create': True}"
                                invisible="direction in ['internal_transfer','damage_expiry_issue_out','miscellaneous_issue_out','scrap_issuance','stock_takeover','miscellaneous_receiving'] or (direction == 'consumable_issuance' and consumable_issuance_type != 'branch')"
                            />
<!--                            <field-->
<!--                                name="procurement_group_id"-->
<!--                                groups="stock.group_adv_location"-->
<!--                            />-->
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                                options="{'no_create': True}"
                                readonly="state != 'draft'"
                            />
                            <field name="warehouse_id" invisible="1" />
                            <field name="location_id" invisible="1" />
                            <field name="procurement_group_id" invisible="1" />
                            <field name="company_id" invisible="1" />
                        </group>
                    </group>
                    <notebook>
                        <page name="items" string="Items">
                            <field
                                name="stock_request_ids"
                                context="{
                            'default_expected_date':expected_date,
                            'default_picking_policy': picking_policy,
                            'default_warehouse_id': warehouse_id,
                            'default_location_id': location_id,
                            'default_procurement_group_id': procurement_group_id,
                            'default_company_id': company_id,
                            'default_state': state,
                            }"
                                readonly="state != 'draft'"
                            >
                                <list editable="bottom">
                                    <field name="name" readonly="1" optional="show" />
                                    <field name="product_id" />

                                    <field name="lot_id" context="{'product_id': product_id}" domain="[('product_id', '=', product_id)]"  required="tracking != 'none' and (parent.direction in ['damage_expiry_issue_out','miscellaneous_issue_out','scrap_issuance', 'internal_transfer','miscellaneous_receiving'] or parent.direction == 'consumable_issuance' and parent.consumable_issuance_type == 'internal')" />
<!--                                            column_invisible=" parent.direction not in ['van_off_load','damage_expiry_issue_out',-->
<!--                                    'miscellaneous_issue_out','scrap_issuance','consumable_issuance', -->
<!--                                    'internal_transfer','miscellaneous_receiving'] -->
<!--                                    or -->
<!--                                    parent.direction == 'consumable_issuance' and parent.consumable_issuance_type != 'internal'"/>-->
                                    <field name="source_location" column_invisible="parent.direction not in ['internal_transfer','damage_expiry_issue_out','miscellaneous_issue_out','consumable_issuance'] or parent.direction == 'consumable_issuance' and parent.consumable_issuance_type != 'internal'"/>
                                    <field name="destination_location" column_invisible="parent.direction not in ['internal_transfer','damage_expiry_issue_out','miscellaneous_issue_out','consumable_issuance'] or parent.direction == 'consumable_issuance' and parent.consumable_issuance_type != 'internal'"/>
                                    <field name="available_qty" sum="Total"/>
<!--                                    column_invisible="parent.direction not in ['van_load']"/>-->
                                    <field
                                        name="allowed_uom_categ_id"
                                        column_invisible="1"
                                    />

                                    <field
                                        name="product_uom_id"
                                        options="{'no_open': True, 'no_create': True}"
                                        groups="uom.group_uom"
                                    />
                                    <field
                                        name="route_id"
                                        options="{'no_create': True}"
                                        groups="stock.group_stock_multi_locations"
                                        column_invisible="1"
                                    />
                                    <field name="tracking" column_invisible="1"/>
                                    <field name="available_lot_ids" column_invisible="1" optional="hide"/>
                                    <field name="lot_id" domain="[('id', 'in', available_lot_ids)]" required="tracking != 'none' and (parent.direction in ['damage_expiry_issue_out','scrap_issuance','miscellaneous_issue_out'] or parent.direction == 'consumable_issuance' and parent.consumable_issuance_type == 'internal')" column_invisible="parent.direction not in ['damage_expiry_issue_out','scrap_issuance','consumable_issuance'] or parent.direction == 'consumable_issuance' and parent.consumable_issuance_type != 'internal'"/>
                                    <field name="route_ids" column_invisible="1" />

                                    <field name="package_id" column_invisible="0"/>
                                    <field name="product_uom_qty" sum="Total"/>
                                    <field name="qty_in_progress" optional="show" sum="Total"/>
                                    <field name="qty_done" optional="show" sum="Total"/>
                                    <field name="total_value" optional="show" sum="Total"/>
                                    <field name="expected_date" column_invisible="1" />
                                    <field name="picking_policy" column_invisible="1" />
                                    <field name="warehouse_id" column_invisible="1" />
                                    <field
                                        name="allow_virtual_location"
                                        column_invisible="1"
                                    />
                                    <field name="product_uom_id" column_invisible="1" />
                                    <field name="location_id" column_invisible="1" />
                                    <field
                                        name="procurement_group_id"
                                        column_invisible="1"
                                    />
                                    <field name="company_id" column_invisible="1" />
                                    <field name="state" optional="show" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>
    <record model="ir.ui.view" id="stock_request_order_search">
        <field name="name">stock.request.order.search</field>
        <field name="model">stock.request.order</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Stock Request Orders" />
                <field name="state" />
                <field name="warehouse_id" />
                <field name="location_id" groups="stock.group_stock_multi_locations" />
                <field name="company_id" groups="base.group_multi_company" />
                <separator />
                <filter string="Draft" name="draft" domain="[('state','=','draft')]" />
                <filter
                    string="In Progress"
                    name="open"
                    domain="[('state','=','open')]"
                />
                <filter string="Finished" name="done" domain="[('state','=','done')]" />
                <filter
                    string="Cancelled"
                    name="cancel"
                    domain="[('state','=','cancel')]"
                />
                <group expand="0" string="Group By">
                    <filter
                        string="Warehouse"
                        name="warehouse"
                        domain="[]"
                        context="{'group_by':'warehouse_id'}"
                    />
                    <filter
                        string="Location"
                        name="location"
                        domain="[]"
                        context="{'group_by':'location_id'}"
                    />
                </group>
            </search>
        </field>
    </record>
    <record model="ir.actions.act_window" id="stock_request_order_action">
        <field name="name">Stock Request Orders</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">stock.request.order</field>
        <field name="path">stock-request-orders</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
