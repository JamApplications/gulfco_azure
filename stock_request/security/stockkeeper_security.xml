<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="stock_group_stock_keeper" model="res.groups">
        <field name="name">Stock keeper</field>
        <field name="category_id" ref="module_category_stock_request"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
    </record>

    <record id="stock_group_nsm_mars_approval" model="res.groups">
        <field name="name">NSM Mars</field>
    </record>

     <record id="stock_group_nsm_f_nf_approval" model="res.groups">
        <field name="name">NSM F/NF</field>
    </record>

    <record id="stock_request_order_create_access" model="ir.model.access">
        <field name="name">Stock Request Order Create Access</field>
        <field name="model_id" ref="model_stock_request_order"/>
        <field name="group_id" ref="stock_group_stock_keeper"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
