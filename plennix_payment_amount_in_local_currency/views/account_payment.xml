<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form_local_inherit_view" model="ir.ui.view">
        <field name="name">account.payment.view.form.inherit.local.currency</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//label[@for='amount']" position="attributes">
                <attribute name='string'>Amount in Currency</attribute>
            </xpath>
            <xpath expr="//div[@name='amount_div']" position="after">
                <label for="amount_local"/>
                <div name="amount_div" class="o_row">
                    <field name="amount_local" string="Amount in Local Currency"/>
                    <field name="local_currency_id" options="{'no_create': True, 'no_open': True}" required="0"
                           readonly="1" groups="base.group_multi_currency"/>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
