<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_report_form_inherit1" model="ir.ui.view">
        <field name="name">account.report.form</field>
        <field name="model">account.report</field>
        <field name="inherit_id" ref="account_reports.account_report_form"/>
        <field name="arch" type="xml">
            <field name="filter_aml_ir_filters" position="after">
                <field name="filter_location_plan"/>
                <field name="filter_department_plan"/>
                <field name="filter_channel_plan"/>
            </field>
            <xpath expr="//field[@name='root_report_id']" position="after">
                <field name="is_payable_report"/>
                <field name="is_receivable_report"/>
            </xpath>
            <xpath expr="//field[@name='filter_hide_0_lines']" position="after">
                <field name="filter_budgets"/>
            </xpath>
        </field>
    </record>
</odoo>
