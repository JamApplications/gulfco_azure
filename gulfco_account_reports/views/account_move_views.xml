<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="gulfco_view_move_form_uncoverd_balance" model="ir.ui.view">
        <field name="name">gulfco.view.move.form.uncovered.balance</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='ref']" position="after">
                    <field name="purchase_order_ref" force_save="1" invisible="1"/>
            </xpath>            
            <xpath expr="//field[@name='ref'][1]" position="attributes">
                <attribute name="required">move_type in ('in_invoice', 'in_receipt', 'in_refund')</attribute>
            </xpath>            
            <xpath expr="//field[@name='ref'][2]" position="attributes">
                <attribute name="required">move_type in ('in_invoice', 'in_receipt', 'in_refund')</attribute>
            </xpath>
            <xpath expr="//field[@name='amount_residual']" position="after">
                <field name="uncovered_balance"/>
            </xpath>            
            <xpath expr="//div[@name='journal_div']" position="after">
                <field name="ass_value" invisible="move_type != 'in_invoice'"/>
            </xpath>
            <xpath expr="//field[@name='ref']" position="after">
                <field name="custom_authority" invisible="move_type == 'in_invoice'"/>
                <field name="boe_number" invisible="move_type == 'in_invoice'"/>
            </xpath>
            <xpath expr="//sheet//page[@name='invoice_tab']//list//field[@name='tax_ids']" position="after">
                <field name="ass_value"/>
                <!-- <field name="ass_value" column_invisible="move_type != 'in_invoice'" invisible="move_type != 'in_invoice'"/> -->
            </xpath>
            
        </field>
    </record>
</odoo>