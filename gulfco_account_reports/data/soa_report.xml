<?xml version="1.0" encoding="UTF-8"?>
<odoo auto_sequence="1">
    <record id="soa_report" model="account.report">
        <field name="name">SOA Report</field>
        <field name="filter_journals" eval="True"/>
        <field name="default_opening_date_filter">today</field>
        <field name="filter_date_range" eval="False"/>
        <field name="load_more_limit" eval="80"/>
        <field name="root_report_id" ref="account_reports.partner_ledger_report"/>
        <field name="custom_handler_model_id" ref="model_account_soa_report_handler"/>
        <field name="filter_account_type">receivable</field>
        <field name="column_ids">
            <record id="soa_report_invoicing_date" model="account.report.column">
                <field name="name">Trx Date</field>
                <field name="expression_label">invoice_date</field>
                <field name="figure_type">date</field>
            </record>
            <record id="soa_report_date_maturity" model="account.report.column">
                <field name="name">Due Date</field>
                <field name="expression_label">date_maturity</field>
                <field name="figure_type">date</field>
            </record>
            <record id="soa_report_ref" model="account.report.column">
                <field name="name">Ref</field>
                <field name="expression_label">inv_ref</field>
                <field name="figure_type">string</field>
            </record>
            <record id="soa_report_debit" model="account.report.column">
                <field name="name">Debit</field>
                <field name="expression_label">debit</field>
            </record>
            <record id="soa_report_credit" model="account.report.column">
                <field name="name">Credit</field>
                <field name="expression_label">credit</field>
            </record>
            <record id="soa_report_report_balance" model="account.report.column">
                <field name="name">Balance</field>
                <field name="expression_label">balance</field>
            </record>
            <record id="soa_report_report_unconvered_balance" model="account.report.column">
                <field name="name">Uncovered Balance</field>
                <field name="expression_label">uncovered_balance</field>
            </record>
        </field>
    </record>
</odoo>
