<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="customer_amendment_view_tree" model="ir.ui.view">
        <field name="name">customer_amendment_view_tree</field>
        <field name="model">customer.amendment</field>
        <field name="arch" type="xml">
            <list string="Customer Amendment">
                <field name="name"/>
                <field name="type"/>
            </list>
        </field>
    </record>
    <record id="customer_amendment_view_form" model="ir.ui.view">
        <field name="name">customer_amendment_view_form</field>
        <field name="model">customer.amendment</field>
        <field name="arch" type="xml">
            <form string="Customer Amendment">
                <header>
                    <field name="type" invisible="1"/>
                    <field name="bu_sales_state" widget="statusbar" invisible="type != 'sales_amendment'" statusbar_visible="draft,waiting_manager_approval,manager_approval,reject"/>
                    <field name="bu_scm_state" widget="statusbar" invisible="type != 'scm_amendment'" statusbar_visible="draft,waiting_ccd_officer_approval,ccd_officer_approval,reject"/>
                    <field name="bu_ccd_state" widget="statusbar" invisible="type != 'ccd_amendment'" statusbar_visible="draft,waiting_ccd_officer_approval,ccd_officer_approved,ccd_approved,reject"/>

<!--                    Approval flow for the BU Sales-->
                    <button name="action_submit_bu_sales" string="Submit for Approval" type="object"
                        class="oe_highlight"
                        invisible="type != 'sales_amendment' or bu_sales_state != 'draft'"
                        groups="gulfco_contact_registration_custom.group_submit_cash_customer" />
                    <button name="action_manager_approve_bu_sales" string="Manager Approval" type="object"
                        class="oe_highlight"
                        invisible="type != 'sales_amendment' or bu_sales_state != 'waiting_manager_approval'"
                         groups="gulfco_contact_registration_custom.group_manager_cash_approval" />
                    <button name="action_reject_bu_sales" string="Reject" type="object"
                        class="oe_highlight"
                        invisible="type != 'sales_amendment' or bu_sales_state not in ['draft','waiting_manager_approval']"
                        groups="gulfco_contact_registration_custom.group_reset_cash_customer"/>


                    <!-- Approval flow for the BU SCM  -->
                    <button name="action_submit_bu_scm" string="Submit Request" type="object"
                        class="oe_highlight"
                        invisible="type != 'scm_amendment' or bu_scm_state != 'draft'"
                        groups="gulfco_contact_registration_custom.group_submit_cash_customer" />
                    <button name="action_ccd_officer_bu_scm" string="CCD Officer Approval" type="object"
                        class="oe_highlight"
                        invisible="type != 'scm_amendment' or bu_scm_state != 'waiting_ccd_officer_approval'"
                        groups="gulfco_contact_registration_custom.group_credit_officer_approval"/>
                    <button name="action_reject_bu_scm" string="Reject" type="object"
                        class="oe_highlight"
                        invisible="type != 'scm_amendment' or bu_scm_state not in ['waiting_ccd_officer_approval','ccd_officer_approved']"
                        groups="gulfco_contact_registration_custom.group_reset_credit_customer,gulfco_contact_registration_custom.group_reset_cash_customer"/>
                    <!-- Approval flow for the BU CCD  -->
                    <button name="submit_to_ccd_officer_approval" string="Submit Request" type="object"
                        class="oe_highlight"
                        invisible="type != 'ccd_amendment' or bu_ccd_state != 'draft'"
                        groups="gulfco_contact_registration_custom.group_submit_credit_customer,gulfco_contact_registration_custom.group_submit_cash_customer"/>

                    <button name="action_ccd_officer_approve" string="CCD Office Approval" type="object"
                        class="oe_highlight"
                        invisible="type != 'ccd_amendment' or bu_ccd_state != 'waiting_ccd_officer_approval'"
                        groups="gulfco_contact_registration_custom.group_credit_officer_approval"/>

                    <button name="action_ccd_approved" string="CCD Manager Approval" type="object"
                        class="oe_highlight"
                        invisible="type != 'ccd_amendment' or bu_ccd_state != 'ccd_officer_approved'"
                        groups="gulfco_contact_registration_custom.group_ccd_credit_approval"/>

                    <button name="action_reject_ccd" string="Reject" type="object"
                        class="oe_highlight"
                        invisible="type != 'ccd_amendment' or bu_ccd_state not in ['waiting_ccd_officer_approval', 'ccd_officer_approved'] or is_ccd_officer_direct_approved"
                        groups="gulfco_contact_registration_custom.group_reset_credit_customer"/>
                </header>
                <sheet>
                    <div>
                        <h5>
                            <field name="name"/>
                        </h5>
                    </div>
                    <group invisible="type != 'sales_amendment'">
                        <group>
                            <table class="table table-sm o_form_table" style="border-color: white !important;">
                                <thead>
                                    <tr>
                                        <th>Label</th>
                                        <th>New Value</th>
                                        <th>Previous Value</th>
                                    </tr>
                                </thead>
                                 <tbody>
                                    <tr><td><label for="customer_group_id"/></td><td><field name="customer_group_id"/></td><td><field name="prev_customer_group_id" readonly="1" force_save="1" nolabel="1"/></td></tr>
                                    <tr><td><label for="outlet_code"/></td><td><field name="outlet_code"/></td><td><field name="prev_outlet_code" readonly="1" nolabel="1" force_save="1"/></td></tr>
                                    <tr><td><label for="outlet_short_name"/></td><td><field name="outlet_short_name"/></td><td><field name="prev_outlet_short_name" readonly="1" nolabel="1" force_save="1"/></td></tr>
                                    <tr><td><label for="external_ref"/></td><td><field name="external_ref"/></td><td><field name="prev_external_ref" readonly="1" nolabel="1" force_save="1"/></td></tr>
                                    <tr><td><label for="sales_leader_id"/></td><td><field name="sales_leader_id"/></td><td><field name="prev_sales_leader_id" readonly="1" nolabel="1" force_save="1"/></td></tr>
                                    <tr><td><label for="collector_id"/></td><td><field name="collector_id"/></td><td><field name="prev_collector_id" readonly="1" nolabel="1" force_save="1"/></td></tr>
                                 </tbody>
                            </table>
                        </group>
                        <group>
                            <table class="table table-sm o_form_table" style="border-color: white !important;">
                                <thead>
                                    <tr>
                                        <th>Label</th>
                                        <th>New Value</th>
                                        <th>Previous Value</th>
                                    </tr>
                                </thead>
                                 <tbody>
                                    <tr><td><label for="buyer_id"/></td><td><field name="buyer_id"/></td><td><field name="prev_buyer_id" readonly="1" nolabel="1" force_save="1"/></td></tr>
                                    <tr><td><label for="finance_manager_id"/></td><td><field name="finance_manager_id"/></td><td><field name="prev_finance_manager_id" readonly="1" nolabel="1" force_save="1"/></td></tr>
