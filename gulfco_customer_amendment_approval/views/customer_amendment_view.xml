                                    <tr><td><label for="share_invoice_email"/></td><td><field name="share_invoice_email"/></td><td><field name="prev_share_invoice_email" readonly="1" nolabel="1" force_save="1"/></td></tr>
                                    <tr><td><label for="latitude"/></td><td><field name="latitude"/></td><td><field name="prev_latitude" readonly="1" nolabel="1" force_save="1"/></td></tr>
                                    <tr><td><label for="longitude"/></td><td><field name="longitude"/></td><td><field name="prev_longitude" readonly="1" nolabel="1" force_save="1"/></td></tr>
                                 </tbody>
                            </table>
