<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- inherit view_stock_move_line_operation_tree -->
  <record id="view_stock_move_operations_tree_inbound" model="ir.ui.view">
    <field name="name">stock.move.operation.tree.inbound</field>
    <field name="model">stock.move</field>
    <field name="inherit_id" ref="stock.view_stock_move_operations" />
    <field name="arch" type="xml">
      <xpath expr="//widget[@name='generate_serials']" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>
      <xpath expr="//widget[@name='import_lots']" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>
    </field>
  </record>


</odoo>