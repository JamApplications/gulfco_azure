    <record id="inventory_adjustment_line_view_search" model="ir.ui.view">
        <field name="name">inventory.adjustment.line.view.search</field>
        <field name="model">inventory.adjustment.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="internal_ref_lot"/>
                <field name="product_id"/>
                <group expand="1" string="Group by">
                    <filter string="Product" name="group_product" context="{'group_by': 'product_id'}"/>
                    <filter string="Internal Lot" name="group_internal_ref_lot"
                            context="{'group_by': 'internal_ref_lot'}"/>
                </group>
            </search>
        </field>
    </record>


    <record id="action_stock_inventory_adjustment" model="ir.actions.act_window">
        <field name="name">Inventory Adjustment</field>
        <field name="res_model">stock.inventory.adjustment</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_stock_inventory_adjustment" name="Inventory Adjustment" parent="stock.menu_stock_adjustments"
              action="action_stock_inventory_adjustment"/>
</odoo>