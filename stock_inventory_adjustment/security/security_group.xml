<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="group_director_approval" model="res.groups">
        <field name="name">Director Approval</field>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
    </record>
    <record id="group_scd_approval" model="res.groups">
        <field name="name">SCD Approval</field>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
    </record>
    <record model="ir.rule" id="inventory_adjustment_comp_rule">
        <field name="name">Inventory Adjustment multi-company</field>
        <field name="model_id" ref="model_stock_inventory_adjustment"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
    </record>
    <record model="ir.rule" id="inventory_adjustment_line_comp_rule">
        <field name="name">Inventory Adjustment Line multi-company</field>
        <field name="model_id" ref="model_inventory_adjustment_line"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
