            <field name="model">stock.location</field>
            <field name="type">form</field>
            <field name="inherit_id" ref="stock.view_location_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@name='additional_info']" position="inside">
                    <field name="is_freeze_location" readonly="1" groups="!ms_inventory_freeze.group_stock_freeze_editable" string="Stock Freeze"/>
                    <field name="is_freeze_location" readonly="0" groups="ms_inventory_freeze.group_stock_freeze_editable" string="Stock Freeze"/>
                </xpath>
                
             </field>
        </record>

    </data>
</odoo>