<odoo>
    <record id="view_partner_form_inherit_add_fields" model="ir.ui.view">
        <field name="name">view.res.partner.form.inherit.add.fields</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account.view_partner_property_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='accounting']//group[@name='accounting_entries']//field[@name='property_account_payable_id']" position="after">
                <field name="advance_account_receivable_id" required="1"/>
                <field name="advance_account_payable_id" required="1"/>
            </xpath>
            <xpath expr="//page[@name='sales_purchases']//field[@name='user_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>