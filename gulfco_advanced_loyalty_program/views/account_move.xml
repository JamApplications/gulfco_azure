<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_move_form_inherited_discount_custom" model="ir.ui.view">
            <field name="name">account.move.view.form.inherited.discount.custom</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='discount']" position="after">
                    <field name='test_discount' string="Test Disc.(%)" optional="hide" column_invisible="1"/>
                    <field name='test_discount_value' string="Disc. in Value" optional="hide" column_invisible="1"/>
                    <field name="account_move_line_reward_ids" widget="many2many_tags" optional="hide"/>
                    <field name="discount_unit_price"  optional="hide"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>