<?xml version="1.0" encoding="utf-8"?>
<odoo>

	<record id="res_config_settings_view_form_purchase" model="ir.ui.view">
		<field name="name">res.config.settings.view.form.inherit.purchase</field>
		<field name="model">res.config.settings</field>
		<field name="priority" eval="25"/>
		<field name="inherit_id" ref="purchase.res_config_settings_view_form_purchase"/>
		<field name="arch" type="xml">
			<xpath expr="//block[@name='purchase_setting_container']" position="inside">

				<setting id="assessment_filter_partner" help="Hide the vendor marked as 'Stop The Partnership' when adding a new RFQ/Purchase Order.">
					<field name="filter_vendor_assessment"/>
				</setting>
				
			</xpath>
		</field>
	</record>

</odoo>
