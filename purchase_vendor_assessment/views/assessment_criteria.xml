<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="assessment_criteria_view_list" model="ir.ui.view">
        <field name="name">assessment_criteria_view_list</field>
        <field name="model">assessment.criteria</field>
        <field name="arch" type="xml">
            <list editable="top">
                <field name="sequence" widget="handle"/>
                <field name="name" />
                <field name="description" />
                <field name="python_code" />
                <field name="weightage_point"/>
            </list>
        </field>
    </record>
    <record id="assessment_criteria_view_filter" model="ir.ui.view">
        <field name="name">assessment_criteria_view_filter</field>
        <field name="model">assessment.criteria</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
            </search>
        </field>
    </record>
    <record id="assessment_criteria_action" model="ir.actions.act_window">
        <field name="name">Criteria</field>
        <field name="res_model">assessment.criteria</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="view_id" eval="False" />
    </record>
</odoo>
