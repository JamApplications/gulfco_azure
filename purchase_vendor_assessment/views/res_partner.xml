<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_partner_view_form_inherit" model="ir.ui.view">
        <field name="name">res.partner.view.form.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_open_assessments" type="object" class="oe_stat_button" icon="fa-id-card-o" groups="purchase.group_purchase_user" >
<!--                    invisible="not vendor_assessment_count">-->
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value"><field name="vendor_assessment_count"/></span>
                        <span class="o_stat_text">Assessment(s)</span>
                    </div>
                </button>
            </div>

            <xpath expr="//field[@name='category_id']" position="after">
                <field name="criteria_group_id" readonly="criteria_id" force_save="1"/>
                <field name="criteria_id"  options="{'no_create': True}" readonly="criteria_group_id != False" force_save="1"/>
<!--                <field name="criteria_ids" widget="many2many_tags" options="{'no_create': True}" readonly="criteria_group_id != False" force_save="1"/>-->


            </xpath>
        </field>
    </record>
    <record id="view_res_partner_filter_inherit" model="ir.ui.view">
        <field name="name">res.partner.select.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <field name="user_id" position="after">
                <separator/>
                <filter string="Is Strategy Partnership" name="assessment_1" domain="[('vendor_decision', '=', '1')]"/>
                <filter string="Is Warning" name="assessment_2" domain="[('vendor_decision', '=', '2')]"/>
                <filter string="Stopped Partnership" name="assessment_3" domain="[('vendor_decision', '=', '3')]"/>
            </field>
        </field>
    </record>
</odoo>
