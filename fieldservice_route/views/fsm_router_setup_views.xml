<!-- views/fsm_router_setup_views.xml -->
<odoo>

    <!-- Tree view -->
    <record id="view_fsm_router_setup_list_view" model="ir.ui.view">
        <field name="name">fsm.router.setup.list.view</field>
        <field name="model">fsm.router.setup</field>
        <field name="arch" type="xml">
            <list>
                <field name="worker_id"/>
            </list>
        </field>
    </record>

    <record id="view_fsm_router_setup_form" model="ir.ui.view">
        <field name="name">fsm.router.setup.form</field>
        <field name="model">fsm.router.setup</field>
        <field name="arch" type="xml">
            <form string="FSM Router Setup">
                <sheet>
                    <group>
                        <group>
                            <field name="worker_id"/>
                        </group>
                    </group>
                     <notebook>
                        <page string="Lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="customer_id"/>
                                    <field name="location_ids" widget="many2many_tags"/>
                                    <field name="route_day_ids" widget="many2many_tags"/>
                                </list>
                            </field>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fsm_router_setup" model="ir.actions.act_window">
        <field name="name">Router Setup</field>
        <field name="res_model">fsm.router.setup</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_fsm_router_setup"
              name="Router Setup"
              parent="fieldservice.data"
              action="action_fsm_router_setup"/>
</odoo>
