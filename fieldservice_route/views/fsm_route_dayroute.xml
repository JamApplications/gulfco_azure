<odoo>
    <record id="fsm_route_dayroute_list" model="ir.ui.view">
        <field name="name">fsm.route.dayroute.list</field>
        <field name="model">fsm.route.dayroute</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="route_id"  column_invisible="1"/>
                <field name="route_setup_id"/>
<!--                <field name="person_id" />-->
                <field name="person_id_partner"/>
                <field name="date" />
                <field name="stage_id" />
            </list>
        </field>
    </record>

    <record id="fsm_route_dayroute_form" model="ir.ui.view">
        <field name="name">fsm.route.dayroute.form</field>
        <field name="model">fsm.route.dayroute</field>
        <field name="arch" type="xml">
            <form string="Day Route">
                <header>
                    <field
                        name="stage_id"
                        widget="statusbar"
                        options="{'fold_field': 'fold'}"
                        clickable="True"
                        domain="[('stage_type', '=', 'route')]"
                    />
                    <button
                            id="schedule_visits_button"
                            name="schedule_visits_button"
                            string="Schedule visits"
                            class="oe_highlight"
                            type="object"
                    />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box" />
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" />
                        </h1>
                    </div>
                    <group id="main">
                        <group id="left">
                            <field name="route_id" invisible="1"/>
                             <field name="route_setup_id"/>
                            <field
                                name="team_id"
                                groups="fieldservice.group_fsm_team"
                            />
<!--                            <field name="person_id" required="1"/>-->
                            <field name="partner_team_member_ids" invisible="True"/>
                            <field name="person_id_partner" required="1"/>
                        </group>
                        <group id="right">
                            <div class="o_row">
                                <strong class="m-2">Period</strong>
                                <label for="date_from" class="text-bold"/>
                                <field
                                        name="date_from"
                                        class="oe_inline"
                                />
                                <label for="date_to" class="text-bold"/>
                                <field name="date_to" class="oe_inline"/>
                            </div>


                            <!--                            <label for="date_from" string="Period"/>-->
                            <!--                                <field name="date_from" placeholder="From"/>-->
                            <!--                                <label for="date_to"/>-->
                            <!--                                <field name="date_to" placeholder="To"/>-->
                            <!--                            <field name="date" required="1" string="Period"/>-->
                        </group>
                    </group>
                    <notebook>
                        <page string="Orders">
                            <group id="orders">
                                <group id="orders-left">
                                    <field name="max_order" invisible="1"/>
                                    <field name="order_count" />
                                    <field name="order_remaining" invisible="1"/>
                                </group>
                                <group id="orders-right" />
                            </group>
                            <field
                                name="order_ids"
                                nolabel="1"
                                widget="many2many"
                                domain="[('dayroute_id', '=', False)]"
                            >
                                <list>
                                    <field name="sequence" widget="handle" />
                                    <field name="name" />
                                    <field name="location_id" />
                                    <field name="scheduled_date_start" />
                                    <field name="scheduled_date_end"/>
                                    <field name="stage_id" />
                                    <field name="route_status"  decoration-danger="route_status == 'outRoute'" decoration-success="route_status == 'inRoute'"/>
                                    <button
                                        name="action_complete"
                                        string="Complete order"
                                        type="object"
                                        icon="fa-check text-success"
                                        invisible="stage_id in [%(fieldservice.fsm_stage_completed)d, %(fieldservice.fsm_stage_cancelled)d]"
                                    />
                                    <button
                                        name="action_cancel"
                                        string="Cancel order"
                                        type="object"
                                        icon="fa-times-circle text-danger"
                                        invisible="stage_id in [%(fieldservice.fsm_stage_completed)d, %(fieldservice.fsm_stage_cancelled)d]"
                                    />
                                </list>
                            </field>
                        </page>
                        <page string="Planning">
                            <group id="planning">
                                <group id="planning-left" string="Timing">
                                    <field name="date_start_planned" />
                                    <field name="work_time" />
                                    <field name="max_allow_time" />
                                </group>
                                <group id="planning-right" string="Positioning">
                                    <field name="longitude" />
                                    <field name="latitude" />
                                    <field name="start_location_id" />
                                    <field name="end_location_id" />
                                    <field name="last_location_id" />
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="fsm_route_day_search_view">
        <field name="name">Day Routes Search View</field>
        <field name="model">fsm.route.dayroute</field>
        <field name="arch" type="xml">
            <search>
                <filter
                    name="fsm_dayroute_today"
                    string="Today"
                    domain="[('date', '=', (datetime.date.today()))]"
                />
            </search>
        </field>
    </record>

    <record id="action_fsm_route_dayroute" model="ir.actions.act_window">
        <field name="name">Journey Plans</field>
        <field name="res_model">fsm.route.dayroute</field>
        <field name="view_mode">list,calendar,form</field>
        <field name="search_view_id" ref="fsm_route_day_search_view"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add Day Routes here.
            </p>
        </field>
    </record>

    <!-- Dashboard -->
    <record id="fsm_route_dayroute_calendar" model="ir.ui.view">
        <field name="name">fsm.route.dayroute.calendar</field>
        <field name="model">fsm.route.dayroute</field>
        <field name="arch" type="xml">
            <calendar
                string="Journey Plans"
                date_start="date_start_planned"
                date_delay="max_allow_time"
                color="route_setup_id"
            >
                <field name="name" />
<!--                <field name="person_id" />-->
                <field name="person_id_partner" />
            </calendar>
        </field>
    </record>

    <record id="action_fsm_route_dayroute_dash" model="ir.actions.act_window">
        <field name="name">Journey plans</field>
        <field name="res_model">fsm.route.dayroute</field>
        <field name="view_mode">calendar,list,form</field>
    </record>

    <!-- Reporting -->
    <record id="fsm_route_dayroute_graph_view" model="ir.ui.view">
        <field name="name">fsm.route.graph</field>
        <field name="model">fsm.route.dayroute</field>
        <field name="arch" type="xml">
            <graph string="Day Routes" type="bar">
                <field name="date" type="row" />
            </graph>
        </field>
    </record>

    <record id="fsm_route_dayroute_pivot_view" model="ir.ui.view">
        <field name="name">fsm.route.pivot</field>
        <field name="model">fsm.route.dayroute</field>
        <field name="arch" type="xml">
            <pivot string="Day Routes" display_quantity="true">
                <field name="date" type="row" />
            </pivot>
        </field>
    </record>

    <record id="action_fsm_route_dayroute_report" model="ir.actions.act_window">
        <field name="name">Journeys</field>
        <field name="res_model">fsm.route.dayroute</field>
        <field name="view_mode">graph,pivot</field>
        <field name="help" type="html">
            <p>
                Day Routes Report
            </p>
        </field>
    </record>
</odoo>
