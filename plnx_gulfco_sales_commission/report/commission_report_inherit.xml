<?xml version="1.0" encoding="utf-8"?>
<odoo>

      <record id="sale_commission_report_view_search_inherit" model="ir.ui.view">
        <field name="name">sale.commission.custom.search</field>
        <field name="model">sale.commission.report</field>
        <field name="inherit_id" ref="sale_commission.sale_commission_report_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='group_by_salesperson']" position="replace">
                <filter string="Salesperson" name="group_by_salesperson" context="{'group_by':'partner_id'}"/>
            </xpath>
        </field>
    </record>


    <record id="sale_commission_report_view_list_inherit" model="ir.ui.view">
        <field name="name">sale.commission.report.view.list..inherit</field>
        <field name="model">sale.commission.report</field>
        <field name="inherit_id" ref="sale_commission.sale_commission_report_view_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='achieved_rate']" position="replace">
                <field name="achieved_rate" widget="percentage" optional="hide"/>
                <!--                invisible="target_amount == 0"/>-->
            </xpath>
            <xpath expr="//field[@name='achieved']" position="after">
                <field name="achieved_plan" sum="Total Achieved Plan" optional="hide"/>
            </xpath>
            <xpath expr="//field[@name='target_amount']" position="after">
                <field name="kpi_type" column_invisible="1"/>
                <field name="target_plan" sum="Total Target Plan" optional="hide"/>
            </xpath>
            <xpath expr="//field[@name='user_id']" position="replace">
                <field name="user_id" column_invisible="1"/>
                <field name="partner_id"/>
            </xpath>
        </field>
    </record>

</odoo>