<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sales_commission_kpi_tree_view" model="ir.ui.view">
        <field name="name">commission.kpi.list</field>
        <field name="model">commission.kpi</field>
        <field name="arch" type="xml">
            <list editable="top">
                <field name="name"/>
                <field name="kpi_type"/>
            </list>
        </field>
    </record>

    <record id="sales_commission_kpi_form_view" model="ir.ui.view">
        <field name="name">commission.kpi.form.view</field>
        <field name="model">commission.kpi</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="kpi_type"/>
                    </group>

                    <separator/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_sales_commission_kpi" model="ir.actions.act_window">
        <field name="name">Commission KPI</field>
        <field name="res_model">commission.kpi</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_sales_commission_kpi"
              name="Commission KPI"
              parent="sale.menu_sale_config"
              action="action_sales_commission_kpi"
              sequence="20"/>


</odoo>