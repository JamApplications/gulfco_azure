<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form_inherit" model="ir.ui.view">
        <field name="name">account.payment.form</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group/group[@name='group1']" position="inside">
                <field name="responsible_id" readonly="payment_type == 'inbound'"/>
                <field name="team_id" invisible="1"/>
            </xpath>
        </field>
    </record>


    <record id="view_account_payment_register_form_responsible" model="ir.ui.view">
            <field name="name">account.payment.invoice.form.responsible.inherit</field>
            <field name="model">account.payment.register</field>
            <field name="inherit_id" ref="account.view_account_payment_register_form"/>
            <field name="arch" type="xml">
                <field name="communication" position="after">
                    <field name="responsible_id" readonly="payment_type == 'inbound'"/>
                </field>
            </field>
        </record>



</odoo>