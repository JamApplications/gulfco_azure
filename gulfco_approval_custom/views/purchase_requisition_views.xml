<?xml version="1.0"?>
<odoo>
    <data>
        <record id="gulfco_view_purchase_requisition_form_inherit" model="ir.ui.view">
            <field name="name">gulfco.purchase.requisition.form</field>
            <field name="model">purchase.requisition</field>
            <field name="inherit_id" ref="purchase_requisition.view_purchase_requisition_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='state']" position="attributes">
                    <attribute name="statusbar_visible">
                        draft,division_head_confirm,scm_approve,finance_approve,confirmed,done
                    </attribute>
                </xpath>
                <xpath expr="//button[@name='action_confirm']" position="attributes">
                    <attribute name="invisible">state != 'draft' or (requisition_type != 'purchase_template' and state
                        != 'finance_approve')
                    </attribute>
                </xpath>
                <xpath expr="//header" position="inside">
                    <button name="action_division_head_confirm"
                            invisible="state != 'draft' or requisition_type == 'purchase_template'" string="Confirm"
                            type="object"
                            class="btn-primary"
                            groups="gulfco_contact_registration_custom.group_div_head_approval"/>
                    <button name="action_scm_approve"
                            invisible="state != 'division_head_confirm' or requisition_type == 'purchase_template'"
                            string="Approve" type="object"
                            class="btn-primary"
                            groups="gulfco_contact_registration_custom.group_scm_approval"/>
                    <button name="action_finance_approve"
                            invisible="state != 'scm_approve' or requisition_type == 'purchase_template'"
                            string="Approve" type="object"
                            class="btn-primary"
                            groups="account.group_account_manager"/>
                    <button name="action_confirm"
                            invisible="state != 'finance_approve' or requisition_type == 'purchase_template'"
                            string="Approve" type="object" class="btn-primary"
                            groups="stock_inventory_adjustment.group_director_approval"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
