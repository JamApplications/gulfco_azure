<odoo>

    <record id="account_payment_form_inherit" model="ir.ui.view">
        <field name="name">account.payment.form.inherit</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_post']" position="before">
                <field name="is_pdc_payment" invisible="1"/>
                <field name="is_access_draft" invisible="1"/>
                <field name="can_be_pdc_payable" invisible="1"/>
                <field name="is_pdc_collected" invisible="1"/>
            </xpath>
            <xpath expr="//button[@name='unmark_as_sent']" position="attributes">
                <attribute name="invisible">state != 'in_process' or is_move_sent == False or payment_method_code != 'manual' or is_pdc_payment == True or is_pdc_payable == True</attribute>
<!--                <attribute name="attrs">-->
<!--                    {-->
<!--                    'invisible': ['|', '|', '|', '|', ('state', '!=', 'in_process'), ('is_move_sent', '=', False),-->
<!--                    ('payment_method_code', '!=', 'manual'), ('is_pdc_payment', '=', True), ('is_pdc_payable', '=',-->
<!--                    True)]}-->
<!--                </attribute>-->
            </xpath>
            <xpath expr="//button[@name='mark_as_sent']" position="attributes">
                <attribute name="invisible">state != 'in_process' or is_move_sent == True or payment_method_code != 'manual' or is_pdc_payment == True or is_pdc_payable == True</attribute>
<!--                <attribute name="attrs">{-->
<!--                    'invisible': ['|', '|', '|', '|', ('state', '!=', 'in_process'), ('is_move_sent', '=', True),-->
<!--                    ('payment_method_code', '!=', 'manual'), ('is_pdc_payment', '=', True), ('is_pdc_payable', '=',-->
<!--                    True)]}-->
<!--                </attribute>-->
            </xpath>

            <xpath expr="//button[@name='action_reject']" position="attributes">
<!--                <attribute name="invisible">state not in ('in_process') or is_pdc_payment == True or is_pdc_payable == True</attribute>-->
                <attribute name="invisible">1</attribute>
                <attribute name="groups">account.group_account_manager</attribute>
            </xpath>

            <xpath expr="//button[@name='action_cancel']" position="attributes">
                <attribute name="invisible">state not in ('draft', 'in_process') or is_pdc_payment == True or is_pdc_payable == True</attribute>
                <attribute name="groups">account.group_account_manager</attribute>
            </xpath>

            <xpath expr="//button[@name='action_draft']" position="attributes">
                <attribute name="invisible">state not in ('in_process', 'cancel') or is_pdc_payment == True or is_pdc_payable == True</attribute>
<!--                <attribute name="attrs">{'invisible': ['|', '|', ('state', 'not in', ('in_process', 'cancel')),-->
<!--                    ('is_pdc_payment', '=', True),('is_pdc_payable', '=', True)]}-->
<!--                </attribute>-->
                <attribute name="groups">account.group_account_manager</attribute>
            </xpath>
            <xpath expr="//button[@name='action_post']" position="after">
                <button name="action_open_pdc_receivable_bounce_wizard" string="Bounce" type="object"
                        invisible="is_pdc_payment == False or pdc_state not in ['collected']"/>
<!--                        attrs="{'invisible': ['|',('is_pdc_payment', '=',False),('pdc_state', 'not in',['deposit', 'collected'])]}"/>-->
                <!--<button name="action_pdc_receivable_recycled" string="Mark To Recycle" type="object"
                        invisible="is_pdc_payment == False or pdc_state != 'bounced'"/>-->
<!--                        attrs="{'invisible': ['|',('is_pdc_payment', '=',False),('pdc_state', '!=','bounced')]}"/>-->
                <button name="action_create_pdc_receivable_collection_fees" string="Add Bank Collection Fees"
                        type="object"
                        invisible="is_pdc_payment == False or pdc_state not in ['collected']"/>
<!--                        attrs="{'invisible': ['|',('is_pdc_payment', '=',False),('pdc_state', 'not in',['collected'])]}"/>-->
                <!--<button name="action_open_pdc_receivable_write_off" string="Write Off Cheque" type="object"
                        invisible="is_pdc_payment == False or pdc_state not in ['bounced']"/>-->
<!--                        attrs="{'invisible': ['|',('is_pdc_payment', '=',False),('pdc_state', 'not in',['bounced'])]}"/>-->
                <button name="action_open_pdc_receivable_cashed_wizard" string="Cashed" type="object"
                        invisible="is_pdc_payment == False or state != 'in_process' or pdc_state not in ['registered', 'bounced']"/>
<!--                        attrs="{'invisible': ['|','|',('is_pdc_payment', '=',False),('state', '!=','in_process'), ('pdc_state', 'not in',['registered', 'bounced'])]}"/>-->
                <button name="action_open_pdc_receivable_collect_wizard" string="Collect Bank" type="object"
                        class="oe_highlight"
                        invisible="is_pdc_payment == False or state != 'in_process' or pdc_state != 'deposit'"/>
<!--                        attrs="{'invisible': ['|','|',('is_pdc_payment', '=',False),('state', '!=','in_process'), ('pdc_state', '!=','deposit')]}"/>-->
				<button name="action_open_pdc_receivable_re_collect_wizard" string="Re-Deposit" type="object" class="oe_highlight"
                        invisible="is_pdc_payment == False or pdc_state not in ['bounced', 'returned']"/>
<!--                        attrs="{'invisible': ['|','|',('is_pdc_payment', '=',False),('state', '!=','in_process'), ('pdc_state', '!=','bounced')]}"/>-->
                <button name="action_open_pdc_receivable_re_cheque_wizard" string="Re Cheque" type="object"
                        class="oe_highlight"
                        invisible="is_pdc_payment == False or pdc_state not in ['bounced', 'returned'] or (payment_type == 'inbound' and pdc_state == 'returned')"/>
<!--                        attrs="{'invisible': ['|','|',('is_pdc_payment', '=',False),('state', '!=','in_process'), ('pdc_state', '!=','bounced')]}"/>-->
                <button name="action_return_pdc" string="Return Cheque" type="object"
                        invisible="is_pdc_payment == False or pdc_state != 'bounced'"/>
<!--                        attrs="{'invisible': ['|','|',('is_pdc_payment', '=',False),('state', '!=','in_process'), ('pdc_state', '!=','registered')]}"/>-->
                <button name="action_draft_pdc_receivable" string="Set Draft" type="object" groups="account.group_account_manager"
                        invisible="is_pdc_payment == False or state != 'in_process' or pdc_state != 'registered'"/>
<!--                        attrs="{'invisible': ['|','|',('is_pdc_payment', '=',False),('state', '!=','in_process'), ('pdc_state', '!=','registered')]}"/>-->

                <!-- pdc payable buttons -->
                <!-- <button name="action_open_pdc_payable_delivered_wizard" string="Set Delivered" type="object"
                        class="oe_highlight"
                        invisible="is_pdc_payable == False or state != 'in_process' or pdc_payable_state != 'registered' or cleared_pdc_payable_move_id != False"/> -->
                <button name="action_open_pdc_payable_clear_wizard" string="Set Cleared" type="object"
                        class="oe_highlight"
                        invisible="is_pdc_payable == False or state != 'in_process' or pdc_payable_state not in ['registered','bounced'] or cleared_pdc_payable_move_id != False"/>
                <!-- <button name="action_pdc_payable_bounced" string="Set Bounced" type="object" 
                        invisible="is_pdc_payable == False or state != 'in_process' or pdc_payable_state != 'delivered' or bounced_move_id != False"/> -->
                <button name="action_pdc_payable_bounce_cancel" string="Bounce/Cancel" type="object"
                        invisible="is_pdc_payable == False or state not in ['in_process','paid'] or pdc_payable_state not in ['registered', 'cleared'] or bounced_move_id != False"/>
                <!-- <button name="action_cancel_pdc" string="Cancel Cheque" type="object"
                        invisible="is_pdc_payable == False or state != 'in_process' or pdc_payable_state  not in ['registered', 'cleared']"/> -->

            </xpath>

            <xpath expr="//field[@name='memo']" position="replace">
                <!-- <label for="pdc_ref" string="Cheque Number" invisible="is_pdc_payment == False"/>
                <div invisible="is_pdc_payment == False">
                    <field name="pdc_ref" nolabel="1" options="{'format': 0}"
                           invisible="is_pdc_payment == False" required="is_pdc_payment == True" readonly="state != 'draft'"/>
                </div> -->
                <field name="memo" string="Memo"
                       readonly="state != 'draft'"/>
<!--                       attrs="{'readonly': [('state', '!=', 'draft')]}"/>-->
                <field name="pdc_ref" string="Cheque No." options="{'format': 0}"
                       invisible="is_pdc_payable == False" required="is_pdc_payable == True" readonly="state != 'draft'"/>
<!--                       attrs="{'invisible': [('is_pdc_payable', '=', False)],'required': [('is_pdc_payable', '=', True)],'readonly': [('state', '!=', 'draft')]}"/>-->
                <field name="memo" invisible="1"/>
                <field name="cancel_id" string="Bounce Reason" invisible="pdc_state != 'bounced'" readonly="1"/>
            </xpath>
            <xpath expr="//field[@name='memo']" position="after">
                <field name="pdc_state" invisible="deposit_pdc_id == False"/>
                <field name="deposit_pdc_id" invisible="deposit_pdc_id == False"/>
                <field name="deposit_move_id"
                       invisible="deposit_move_id == False"/>
<!--                attrs="{'invisible': [('deposit_move_id', '=', False)]}"/>-->
                <field name="bounced_move_id"
                       invisible="bounced_move_id == False"/>
<!--                attrs="{'invisible': [('bounced_move_id', '=', False)]}"/>-->
                <field name="collect_payment_id"
                       invisible="collect_payment_id == False"/>
<!--                       attrs="{'invisible': [('collect_payment_id', '=', False)]}"/>-->
                <field name="is_pdc_payment" invisible="1"/>
                <field name="cleared_pdc_payable_move_id"
                        invisible="cleared_pdc_payable_move_id == False"/>
<!--                       attrs="{'invisible': [('cleared_pdc_payable_move_id', '=', False)]}"/>-->
            </xpath>
            <xpath expr="//group[@name='group2']" position="inside">
                <field name="pdc_bank_id" options="{'no_open': True, 'no_create': True}"
                       invisible="is_pdc_payment == False" required="is_pdc_payment == True"/>
<!--                       attrs="{'invisible': [('is_pdc_payment', '=', False)],'required': [('is_pdc_payment', '=', True)]}"/>-->
                <field name="due_date" invisible="not is_pdc_payable and not is_pdc_payment" required="is_pdc_payable == True or is_pdc_payment == True" 
                       readonly="state != 'draft'" string="Due Date"/>
                <field name="cheque_owner_id" invisible="is_pdc_payment == False"
                       options="{'no_open': True, 'no_create': True}"/>
                <field name="beneficiary_id" invisible="1"/>
                <field name="beneficiary_name" invisible="is_pdc_payment == False"/>
                <field name="cheque_scanning" widget="image"
                       invisible="is_pdc_payment == False and is_pdc_payable == False" readonly="pdc_payable_state != 'draft'"/>
<!--                       attrs="{'invisible': [('is_pdc_payment', '=', False), ('is_pdc_payable', '=', False)], 'readonly': [('pdc_payable_state', '!=', 'draft')]}"/>-->
                <field name="pdc_payable_state" invisible="1" readonly="1"
                       force_save="1"/>
                <!-- <field name="due_date"
                       invisible="is_pdc_payable == False" required="is_pdc_payable == True or is_pdc_payment == True" readonly="state != 'draft'"
                       string="Due Date"/> -->
<!--                attrs="{'invisible': [('is_pdc_payable', '=', False)], 'required': ['|',('is_pdc_payable', '=', True), ('is_pdc_payment', '=', True)], 'readonly': [('state', '!=', 'draft')]}"-->
                <field name="pdc_payable_note"
                       invisible="is_pdc_payable == False"
                       string="PDC Note"/>
<!--                attrs="{'invisible': [('is_pdc_payable', '=', False)], 'readonly': [('state', '!=', 'draft')]}"-->
            </xpath>
            <xpath expr="//field[@name='journal_id']" position="after">
                <field name="is_pdc_payable" invisible="1"/>
            </xpath>

            <!-- smart button -->
            <div class="oe_button_box" position="inside">
                <!-- pdc receivable -->
                <!-- deposit -->
                <button class="oe_stat_button" name="action_open_pdc_receivable_deposit"
                        icon="fa-exchange"
                        type="object"
                        invisible="pdc_receivable_deposit_count == 0">
<!--                        attrs="{'invisible': [('pdc_receivable_deposit_count', '=', 0)]}">-->
                    <field name="pdc_receivable_deposit_count" string="Deposits" widget="statinfo"/>
                </button>
                <!-- bounced in / out -->
                <button class="oe_stat_button" name="action_open_pdc_receivable_bounced_in_out"
                        icon="fa-reply"
                        type="object"
                        invisible="pdc_receivable_bounced_in_out_count == 0">
<!--                        attrs="{'invisible': [('pdc_receivable_bounced_in_out_count', '=', 0)]}">-->
                    <field name="pdc_receivable_bounced_in_out_count" string="Bounced Bank Transactions"
                           widget="statinfo"/>
                </button>
                <!-- collected -->
                <button class="oe_stat_button" name="action_open_pdc_receivable_collected"
                        icon="fa-university"
                        type="object"
                        invisible="pdc_receivable_collected_count == 0">
<!--                        attrs="{'invisible': [('pdc_receivable_collected_count', '=', 0)]}">-->
                    <field name="pdc_receivable_collected_count" string="Collect Bank Transactions" widget="statinfo"/>
                </button>
                <!-- write-off -->
                <button class="oe_stat_button" name="action_open_pdc_receivable_writeoff"
                        icon="fa-usd"
                        type="object"
                        invisible="pdc_receivable_writeoff_count == 0">
<!--                        attrs="{'invisible': [('pdc_receivable_writeoff_count', '=', 0)]}">-->
                    <field name="pdc_receivable_writeoff_count" string="Write-Off" widget="statinfo"/>
                </button>
                <!-- Collection Fees -->
                <button class="oe_stat_button" name="action_open_pdc_receivable_collection_fees"
                        icon="fa-usd"
                        type="object"
                        invisible="pdc_receivable_collection_fees_count == 0">
<!--                        attrs="{'invisible': [('pdc_receivable_collection_fees_count', '=', 0)]}">-->
                    <field name="pdc_receivable_collection_fees_count" string="Collection Fees" widget="statinfo"/>
                </button>
                <!-- recheque -->
                <button class="oe_stat_button" name="action_open_pdc_receivable_recheque"
                        icon="fa-refresh"
                        type="object"
                        invisible="pdc_receivable_recheque_count == 0">
<!--                        attrs="{'invisible': [('pdc_receivable_recheque_count', '=', 0)]}">-->
                    <field name="pdc_receivable_recheque_count" string="Re-Cheque" widget="statinfo"/>
                </button>
                <!-- recycled -->
                <button class="oe_stat_button" name="action_open_pdc_receivable_recycled"
                        icon="fa-refresh"
                        type="object"
                        invisible="pdc_receivable_recycled_count == 0">
<!--                        attrs="{'invisible': [('pdc_receivable_recycled_count', '=', 0)]}">-->
                    <field name="pdc_receivable_recycled_count" string="Recycled" widget="statinfo"/>
                </button>
                <!-- cashed -->
                <button class="oe_stat_button" name="action_open_pdc_receivable_cashed"
                        icon="fa-money"
                        type="object"
                        invisible="pdc_receivable_cashed_count == 0">
<!--                        attrs="{'invisible': [('pdc_receivable_cashed_count', '=', 0)]}">-->
                    <field name="pdc_receivable_cashed_count" string="Cash Receipt" widget="statinfo"/>
                </button>
                <!-- pdc payable -->
                <!-- delivered -->
                <button class="oe_stat_button" name="action_open_pdc_payable_delivered_move"
                        icon="fa-university"
                        type="object"
                        invisible="pdc_payable_delivered_move_count == 0">
<!--                        attrs="{'invisible': [('pdc_payable_delivered_move_count', '=', 0)]}">-->
                    <field name="pdc_payable_delivered_move_count" string="Delivered Move(s)" widget="statinfo"/>
                </button>
                <!-- cleared -->
                <button class="oe_stat_button" name="action_open_pdc_payable_cleared_move"
                        icon="fa-university"
                        type="object"
                        invisible="pdc_payable_cleared_move_count == 0">
<!--                        attrs="{'invisible': [('pdc_payable_cleared_move_count', '=', 0)]}">-->
                    <field name="pdc_payable_cleared_move_count" string="Cleared Move(s)" widget="statinfo"/>
                </button>
                <!-- common pdc receivable / payable -->
                <!-- bounced -->
                <button class="oe_stat_button" name="action_open_pdc_receivable_bounced_move"
                        icon="fa-undo"
                        type="object"
                        invisible="pdc_receivable_bounced_move_count == 0">
<!--                        attrs="{'invisible': [('pdc_receivable_bounced_move_count', '=', 0)]}">-->
                    <field name="pdc_receivable_bounced_move_count" string="Bounced Move(s)" widget="statinfo"/>
                </button>
                <field name="cheque_payment_id" invisible="1"/>
                <button class="oe_stat_button" name="action_open_related_pdc"
                        type="object" icon="fa-envelope-o"
                        invisible="cheque_payment_id == False">
<!--                        attrs="{'invisible': [('cheque_payment_id', '=', False)]}">-->
                    <span>1 PDC</span>
                </button>
            </div>

            <xpath expr="//widget[@name='web_ribbon']" position="after">
                <widget name="web_ribbon" title="Registered" data-id="pdc-registered"
                        invisible="state != 'in_process' or is_pdc_payment == False or pdc_state != 'registered'"/>
<!--                        attrs="{'invisible': ['|','|', ('state', '!=', 'in_process'), ('is_pdc_payment', '=', False),('pdc_state', '!=', 'registered')]}"/>-->
                <widget name="web_ribbon" bg_color="bg-info" title="Bounced"
                        invisible="is_pdc_payment == False or pdc_state != 'bounced'"/>
<!--                        attrs="{'invisible': ['|', ('is_pdc_payment', '=', False),('pdc_state', '!=', 'bounced')]}"/>-->
                <widget name="web_ribbon" bg_color="bg-danger" title="Cashed" data-id="cashed-pdc"
                        invisible="is_pdc_payment == False or pdc_state != 'cashed'"/>
<!--                        attrs="{'invisible': ['|', ('is_pdc_payment', '=', False),('pdc_state', '!=', 'cashed')]}"/>-->
                <widget name="web_ribbon" bg_color="bg-danger" title="Recycled"
                        invisible="is_pdc_payment == False or pdc_state != 'recycled'"/>
<!--                        attrs="{'invisible': ['|', ('is_pdc_payment', '=', False),('pdc_state', '!=', 'recycled')]}"/>-->
                <widget name="web_ribbon" bg_color="bg-danger" title="Re Chequed"
                        invisible="is_pdc_payment == False or pdc_state != 're_cheque'"/>
<!--                        attrs="{'invisible': ['|', ('is_pdc_payment', '=', False),('pdc_state', '!=', 're_cheque')]}"/>-->
                <widget name="web_ribbon" title="Remitted" data-id="deposit-pdc"
                        invisible="is_pdc_payment == False or pdc_state != 'deposit'"/>
<!--                        attrs="{'invisible': ['|', ('is_pdc_payment', '=', False),('pdc_state', '!=', 'deposit')]}"/>-->
                <widget name="web_ribbon" title="Collected" data-id="collected-pdc"
                        invisible="is_pdc_payment == False or pdc_state != 'collected'"/>
<!--                        attrs="{'invisible': ['|', ('is_pdc_payment', '=', False),('pdc_state', '!=', 'collected')]}"/>-->
                <widget name="web_ribbon" title="Registered" data-id="pdc-payable-registered"
                        invisible="state != 'in_process' or is_pdc_payable == False or pdc_payable_state != 'registered'"/>
<!--                        attrs="{'invisible': ['|','|', ('state', '!=', 'in_process'),('is_pdc_payable', '=', False),('pdc_payable_state', '!=', 'registered')]}"/>-->
                <widget name="web_ribbon" bg_color="bg-danger" title="Bounced"
                        invisible="state == 'in_process' or is_pdc_payable == False or pdc_payable_state != 'bounced'"/>
<!--                        attrs="{'invisible': ['|','|', ('state', '=', 'in_process'),('is_pdc_payable', '=', False),('pdc_payable_state', '!=', 'bounced')]}"/>-->
                <widget name="web_ribbon" title="Cleared" data-id="pdc-payable-cleared"
                        invisible="state != 'in_process' or is_pdc_payable == False or pdc_payable_state != 'cleared'"/>
<!--                        attrs="{'invisible': ['|','|', ('state', '!=', 'in_process'),('is_pdc_payable', '=', False),('pdc_payable_state', '!=', 'cleared')]}"/>-->
                <widget name="web_ribbon" title="Delivered" data-id="pdc-payable-delivered"
                        invisible="state != 'in_process' or is_pdc_payable == False or pdc_payable_state != 'delivered'"/>
<!--                        attrs="{'invisible': ['|','|', ('state', '!=', 'in_process'),('is_pdc_payable', '=', False),('pdc_payable_state', '!=', 'delivered')]}"/>-->
            </xpath>
        </field>
    </record>

    <record id="account_payment_pdc_tree_inherit" model="ir.ui.view">
        <field name="name">account.payment.pdc.tree.inherit</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_method_line_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="memo" string="Memo" optional="show" column_invisible="0"/>
            </xpath>

        </field>
    </record>

    <record id="account_payment_search_inherit" model="ir.ui.view">
        <field name="name">account.payment.search.inherit</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='reconciled']" position="after">
                <separator/>
                <filter string="PDC Receivable" name="is_pdc_payment" domain="[('is_pdc_payment', '=', True)]"/>
                <filter string="PDC Payable" name="is_pdc_payable" domain="[('is_pdc_payable', '=', True)]"/>
            </xpath>
            <xpath expr="//filter[@name='state']" position="after">
                <filter string="PDC Receivable Status" name="pdc_state" domain="[]"
                        context="{'group_by': 'pdc_state'}"/>
                <filter string="PDC Payable Status" name="pdc_payable_state" domain="[]"
                        context="{'group_by': 'pdc_payable_state'}"/>
            </xpath>
        </field>
    </record>

    <record id="account_payment_kanban_inherit" model="ir.ui.view">
        <field name="name">account.payment.kanban.inherit</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="memo"/>
            </xpath>
            <xpath expr="//field[@name='currency_id']" position="after">
                <br/>
                <field name="memo"/>
            </xpath>
        </field>
    </record>

    <!-- pdc receivable views -->
    <record id="account_payment_pdc_receivable_form_inherit_primary" model="ir.ui.view">
        <field name="name">account.payment.pdc.receivable.form.inherit.primary</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account_payment_form_inherit"/>
        <field name="priority">80</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="pdc_state" position="move"/>
            </xpath>
            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='pdc_state']" position="attributes">
                <attribute name="attrs"></attribute>
                <attribute name="widget">statusbar</attribute>
                <attribute name="statusbar_visible">registered,deposit,collected</attribute>
            </xpath>
            <xpath expr="//field[@name='journal_id']" position="attributes">
                <attribute name="domain">[('type', '=', 'bank'), ('is_pdc','=',True)]</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_bank_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
<!--            <xpath expr="//field[@name='is_internal_transfer']" position="attributes">-->
<!--                <attribute name="invisible">1</attribute>-->
