<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_cheque_cancel_reason_form" model="ir.ui.view">
            <field name="name">cheque.cancel.reason.form.view</field>
            <field name="model">cheque.cancel.reason</field>
            <field name="arch" type="xml">
                <form string="Cheque Cancel Reason">
                    <sheet>
                        <field name="name"/>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_cheque_cancel_reason_list" model="ir.ui.view">
            <field name="name">cheque.cancel.reason.list.view</field>
            <field name="model">cheque.cancel.reason</field>
            <field name="arch" type="xml">
                <list string="Cheque Cancel Reason">
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record id="action_cheque_cancel_reason" model="ir.actions.act_window">
            <field name="name">Cheque Cancel Reason</field>
            <field name="res_model">cheque.cancel.reason</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="view_cheque_cancel_reason_list"/>
        </record>

        <menuitem id="menu_cancel_reason" name="Cheque Cancel Reason" parent="account.account_account_menu"  action="action_cheque_cancel_reason"/>
    </data>
</odoo>