<odoo>
    <record id="account_payment_register_form_primary_inherit" model="ir.ui.view">
        <field name="name">account.payment.register.form.primary.inherit</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='journal_id']" position="attributes">
<!--                <attribute name="domain">[('company_id', '=', company_id), ('type', '=', 'cash')]</attribute>-->
                 <attribute name="domain">[('company_id', '=', company_id)]</attribute>
            </xpath>
            <xpath expr="//field[@name='amount']" position="attributes">
                <attribute name="force_save">1</attribute>
                <attribute name="readonly">0</attribute>
            </xpath>
            <xpath expr="//field[@name='currency_id']" position="attributes">
                <attribute name="force_save">1</attribute>
                <attribute name="readonly">0</attribute>
            </xpath>
        </field>
    </record>

    <record id="account_payment_register_form_inherit" model="ir.ui.view">
        <field name="name">account.payment.register.form.inherit</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='journal_id']" position="after">
                <field name="is_pdc_payment" invisible="1"/>
                <field name="can_be_pdc_payable" invisible="1"/>
                <field name="is_pdc_payable"  invisible="can_be_pdc_payable == False"/>
<!--                       attrs="{'invisible': [('can_be_pdc_payable', '=', False)]}"/>-->
            </xpath>
            <xpath expr="//field[@name='payment_date']" position="replace">
                <field name="payment_date"  invisible="is_pdc_payable == False" string="Reg. Date"/>
<!--                attrs="{'invisible': [('is_pdc_payable', '=', False)]}"-->
                <field name="payment_date" invisible="is_pdc_payment == True or is_pdc_payable == True"/>
<!--                attrs="{'invisible': ['|',('is_pdc_payment', '=', True), ('is_pdc_payable','=',True)]}"/>-->
<!--                <label for="payment_date" string="Created Date"-->
<!--                       attrs="{'invisible': [('is_pdc_payment', '=', False)]}"/>-->
<!--                <div class="o_row" name="payment_date_div">-->
<!--                    <field name="payment_date" readonly="1" force_save="1" nolabel="1"-->
<!--                           attrs="{'invisible': [('is_pdc_payment', '=', False)]}"/>-->
<!--                </div>-->

            </xpath>
            <xpath expr="//field[@name='communication']" position="replace">
                <field name="communication" />
<!--                <label for="cheque_number" string="Cheque Number"-->
<!--                       attrs="{'invisible': [('is_pdc_payment', '=', False)], 'required': [('is_pdc_payment', '=', True)]}"/>-->
<!--                <div>-->
<!--                    <field name="cheque_number" nolabel="1" attrs="{'invisible': [('is_pdc_payment', '=', False)], 'required': [('is_pdc_payment', '=', True)]}"/>-->
<!--                </div>-->
                <field name="cheque_number"
                       invisible="(can_edit_wizard == False or is_pdc_payment == False or is_pdc_payable == True) or (can_group_payments == True and group_payment == False)"
                       required="is_pdc_payment == True"/>
<!--                       attrs="{'invisible': ['|','|','|', ('can_edit_wizard', '=', False),('is_pdc_payment', '=', False), ('is_pdc_payable','=',True),'&amp;', ('can_group_payments', '=', True), ('group_payment', '=', False)],'required': [('is_pdc_payment', '=', True)]}"/>-->
                <field name="cheque_number"
                       invisible="is_pdc_payable == False"
                       required="is_pdc_payable == True" string="Cheque No."/>
<!--                       attrs="{'invisible': [('is_pdc_payable','=',False)],'required': [('is_pdc_payable','=',True)]}" string="Cheque No."/>-->
            </xpath>
            <xpath expr="//group[@name='group2']" position="inside">
                <field name="pdc_bank_id"  invisible="is_pdc_payment == False"
                       required="is_pdc_payment == True"
                       options="{'no_open': True, 'no_create': True}"/>
                <!--     attrs="{'invisible': [('is_pdc_payment', '=', False)], 'required': [('is_pdc_payment', '=', True)]}"            -->
                <field name="due_date" invisible="is_pdc_payment == False" required="is_pdc_payment == True"/>
<!--                       attrs="{'invisible': [('is_pdc_payment', '=', False)], 'required': [('is_pdc_payment', '=', True)]}"/>-->
<!--                <field name="beneficiary_id"  invisible="is_pdc_payment == False" required="is_pdc_payment == True" options="{'no_open': True, 'no_create': True}"/>-->
                <field name="beneficiary_name"  invisible="is_pdc_payment == False" required="is_pdc_payment == True"/>
                <!--attrs="{'invisible': [('is_pdc_payment', '=', False)], 'required': [('is_pdc_payment', '=', True)]}"                -->
                <field name="cheque_owner_id" invisible="is_pdc_payment == False" required="is_pdc_payment == True" options="{'no_open': True, 'no_create': True}"/>
                <field name="cheque_scanning" widget="image"  invisible="is_pdc_payment == False and is_pdc_payable ==False" />
<!--                attrs="{'invisible': [('is_pdc_payment', '=', False), ('is_pdc_payable', '=', False)]}"/>-->
            </xpath>
            <xpath expr="//field[@name='journal_id']" position="after">
                <field name="due_date"  invisible="is_pdc_payable == False" required="is_pdc_payable == True" string="Due Date"/>
<!--                attrs="{'invisible': [('is_pdc_payable', '=', False)], 'required': [('is_pdc_payable', '=', True)]}"-->
                <field name="pdc_payable_note" invisible="is_pdc_payable == False" string="Notes"/>
<!--                attrs="{'invisible': [('is_pdc_payable', '=', False)]}"-->
            </xpath>
        </field>
    </record>


</odoo>