<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_vat_code" model="ir.ui.view">
        <field name="name">account.move.form.vat.code</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <field name="tax_ids" position="after">
                <field name="tax_vat_code_ids" widget="many2many_tags" 
                       context="{'show_vat_code': True, 'active_test': True}" 
                       options="{'no_create': True}" optional="show" readonly="False" 
                       domain="[('type_tax_use', '=?', parent.invoice_filter_type_domain), ('company_id', 'parent_of', parent.company_id), ('country_id', '=', parent.tax_country_id)]"/>
            </field>
            <field name="tax_ids" position="attributes">
                <attribute name="widget">many2many_tags</attribute>
                <!-- <attribute name="context">{'append_type_to_tax_name': not parent.invoice_filter_type_domain, 'active_test': True, 'show_vat_code': True}</attribute> -->
            </field>
            <xpath expr="//sheet//page[@name='aml_tab']//list//field[@name='tax_ids']" position="after">
                <field name="tax_vat_code_ids" widget="many2many_tags" 
                       context="{'show_vat_code': True, 'active_test': True}" 
                       options="{'no_create': True}" optional="show"/>
            </xpath>            
            <xpath expr="//sheet//page[@name='aml_tab']//list//field[@name='tax_ids']" position="attributes">
                <attribute name="widget">many2many_tags</attribute>
                <!-- <attribute name="context">{'append_type_to_tax_name': not parent.invoice_filter_type_domain, 'active_test': True, 'show_vat_code': True}</attribute> -->
            </xpath>
        </field>
    </record>
</odoo>