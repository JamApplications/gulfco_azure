<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_asset_dispose_wizard_form" model="ir.ui.view">
        <field name="name">asset.dispose.wizard.form</field>
        <field name="model">asset.dispose</field>
        <field name="arch" type="xml">
            <form string="Asset Dispose">
                <sheet>
                    <group>
                        <group>
                            <field name="date" required="1"/>
                            <field name="loss_account_id" required="1"/>
                        </group>
                        <group>
                            <field name="name" required="1"/>
                        </group>
                    </group>
                    <footer>
                        <button name="dispose"
                            string="Dispose"
                            type="object"
                            class="btn-primary"
                            data-hotkey="d"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_asset_dispose_wizard" model="ir.actions.act_window">
        <field name="name">Asset Dispose Wizard</field>
        <field name="res_model">asset.dispose</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_asset_dispose_wizard_form"/>
        <field name="target">new</field>
        <field name="context">{"default_asset_ids": active_ids}</field>
    </record>

</odoo>