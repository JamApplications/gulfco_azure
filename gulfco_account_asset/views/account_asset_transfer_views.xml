<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_asset_transfer_view_form" model="ir.ui.view">
        <field name="name">account.asset.transfer.view.form</field>
        <field name="model">account.asset.transfer</field>
        <field name="arch" type="xml">
            <form string="Asset Transfer">
                <sheet>
                    <group>
                        <group>
                            <field name="transfer_date" readonly="0"/>
                            <field name="original_location" readonly="1" groups="analytic.group_analytic_accounting" widget="analytic_distribution"/>
                            <field name="transfer_memo" readonly="1"/>
                        </group>
                        <group>
                            <field name="new_location" readonly="1" groups="analytic.group_analytic_accounting" widget="analytic_distribution"/>
                            <field name="transfer_by" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="account_asset_transfer_view_tree" model="ir.ui.view">
        <field name="name">account.asset.transfer.view.list</field>
        <field name="model">account.asset.transfer</field>
        <field name="arch" type="xml">
            <list string="Asset Transfer">
                <field name="transfer_date" readonly="0"/>
                <field name="original_location" readonly="1" groups="analytic.group_analytic_accounting" widget="analytic_distribution"/>
                <field name="new_location" readonly="1" groups="analytic.group_analytic_accounting" widget="analytic_distribution"/>
                <field name="transfer_memo" readonly="1" />
                <field name="transfer_by" readonly="1"/>
            </list>
        </field>
    </record>

    <record id="account_asset_transfer_action" model="ir.actions.act_window">
        <field name="name">Asset Transfer</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">account.asset.transfer</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" eval="False"/>
        <field name="domain">[]</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Create a new Asset Transfer.
            </p>
        </field>
    </record>


</odoo>
