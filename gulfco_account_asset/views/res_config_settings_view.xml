<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.account.asset</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="40"/>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//block[@id='default_accounts']" position="inside">
                <setting string="Asset Counterpart Account">
                    <div class="content-group">
                        <div class="row mt8">
                            <label for="account_asset_counterpart_id" class="col-lg-5 o_light_label"/>
                            <field name="account_asset_counterpart_id"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
