<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="supplier_classification_list_view" model="ir.ui.view">
            <field name="name">supplier.classification.list.view</field>
            <field name="model">supplier.classification</field>
            <field name="arch" type="xml">
                <list editable="top">
                    <field name="name" required="1"/>
                    <field name="is_filtered" string="Is Principal Filtered"/>
                </list>
            </field>
        </record>
        <record id="action_supplier_classification" model="ir.actions.act_window">
            <field name="name">Supplier Classification </field>
            <field name="res_model">supplier.classification</field>
            <field name="view_mode">list</field>
        </record>
        <menuitem id="menu_supplier_classification" name="Supplier Classification" parent="contacts.res_partner_menu_config"
                  action="action_supplier_classification"/>
    </data>
</odoo>