<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="vendor_view_partner_bank_form_inherit_account_form" model="ir.ui.view">
        <field name="name">res.partner.bank.vendor.inherit.form</field>
        <field name="model">res.partner.bank</field>
        <field name="inherit_id" ref="base.view_partner_bank_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='acc_number']" position="before">
                <field name="account_name" required="contact_type != 'customer'"/>
            </xpath>
            <xpath expr="//field[@name='acc_number']" position="after">
                <field name="iban_number" required="contact_type != 'customer'"/>
            </xpath>
            <xpath expr="//field[@name='bank_id']" position="after">
                <field name="swift_number" required="contact_type != 'customer'"/>
            </xpath>
            <xpath expr="//field[@name='currency_id']" position="after">
                <field name="branch_name"/>
                <field name="branch_code"/>
                <field name="sort_code"/>
            </xpath>
        </field>
    </record>
</odoo>