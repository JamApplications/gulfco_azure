                            <field name="vendor_registration_file_name" invisible="1"/>
                            <field name="vendor_registration_attachment" widget="binary"
                                   filename="vendor_registration_file_name"
                                   />
                            <field name="agreement_file_name" invisible="1"/>
                            <field name="agreement_attachment" widget="binary" filename="agreement_file_name"/>
                            <field name="other_attachment_file_name" invisible="1"/>
                            <field name="other_attachment" widget="binary" filename="other_attachment_file_name"/>
                            <field name="quotation_attachment_file_name" invisible="1"/>
                            <field name="quotation_attachment" widget="binary" filename="quotation_attachment_file_name"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
