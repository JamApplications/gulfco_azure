<!--                        </group>-->
<!--                    </group>-->

<!--            </xpath>-->
            <xpath expr="//page[@name='detailed_customer_data']" position="after">
                <page name="vendor_details" string="Vendor Details" invisible="contact_type == 'customer'">
                    <group>
                        <group>
                            <field name="supplier_type" required="contact_type in ['supplier', 'both']"/>
                            <field name="vendor_code"/>
                            <field name="rfq_analysis_ref" invisible="supplier_type == 'foreign'"/>

                            <field name="supplier_classification_id" required="contact_type in ['supplier', 'both']"/>
<!--                            <field name="supplier_classification" required="contact_type in ['supplier', 'both']"/>-->
                            <field name="parent_group_name"/>
<!--                            <field name="po_box"/>-->
<!--                            <field name="zip" string="ZIP/Pincode/Area Code"/>-->
<!--                            <field name="vat_trn"/>-->
                        </group>
                    </group>
                    <group string="Legal Documents" name="legal_documents">
                        <group>
                            <field name="trade_number" string="Trade License"/>
                            <field name="legal_document_issue_date" string="Issued Date"
                                />
                        </group>
                        <group>
                            <field name="issuance_authority"/>
                            <field name="legal_document_expiry_date"/>
                        </group>
                    </group>
                    <group string="Attachment" name="attachments">
                        <group>
                            <field name="trade_license_file_name" invisible="1"/>
                            <field name="trade_license_attachment" widget="binary" filename="trade_license_file_name"
                                   />
                            <field name="vat_trn_file_name" invisible="1"/>
                            <field name="vat_trn_attachment" widget="binary" filename="vat_trn_file_name"/>
                            <field name="bank_account_attachment_file_name" invisible="1"/>
                            <field name="bank_account_attachment" widget="binary"
