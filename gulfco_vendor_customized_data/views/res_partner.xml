<!--                            <field name="vat_trn_file_name" invisible="1"/>-->
<!--                            <field name="vat_trn_attachment" widget="binary" filename="vat_trn_file_name"/>-->

<!--                            <field name="poer_attorney_file_name" invisible="1"/>-->
<!--                            <field name="poer_attorney_attachment" widget="binary" filename="poer_attorney_file_name"/>-->

<!--                            <field name="company_photo_file_name" invisible="1"/>-->
<!--                            <field name="company_photo_attachment" widget="binary" filename="company_photo_file_name"/>-->

