<!-- views/pdc_cdc_wizard_views.xml -->
<odoo>
    <record id="view_pdc_cdc_wizard_form" model="ir.ui.view">
        <field name="name">pdc.cdc.wizard.form</field>
        <field name="model">pdc.cdc.wizard</field>
        <field name="arch" type="xml">
            <form string="PDC/CDC Details">
                <group>
                    <field name="payment_ids" invisible="1"/>
                    <field name="line_ids" nolabel="1" readonly="1">
                        <list create="0" edit="0" delete="0" editable="bottom">
                            <field name="custodian_code"/>
                            <field name="customer_name"/>
                            <field name="move_date"/>
                            <field name="cheque_number"/>
                            <field name="cheque_status"/>
                            <field name="due_date"/>
                            <field name="pos_rec_no"/>
                            <field name="amount"/>
                        </list>
                    </field>
                </group>
                <footer>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_show_pdc_cdc_info" model="ir.actions.act_window">
        <field name="name">PDC/CDC Info</field>
        <field name="res_model">pdc.cdc.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
