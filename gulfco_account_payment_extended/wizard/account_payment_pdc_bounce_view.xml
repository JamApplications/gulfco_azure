<odoo>
    <record id="view_account_payment_pdc_bounce_form_custodian" model="ir.ui.view">
        <field name="name">account.payment.pdc.bounce.custodian.form</field>
        <field name="model">account.payment.pdc.bounce</field>
        <field name="inherit_id" ref="account_pdc.account_payment_pdc_bounce_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='bounce_date']" position="after">
                <field name="custodian_id" required="1"/>
            </xpath>
        </field>
    </record>
</odoo>