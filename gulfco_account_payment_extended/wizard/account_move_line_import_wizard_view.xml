<odoo>
    <record id="view_account_move_line_import_wizard_form" model="ir.ui.view">
        <field name="name">account.move.line.import.wizard.form</field>
        <field name="model">account.move.line.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Move Line Data">
                <group>
                    <field name="upload_file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                    <field name="comment" invisible="1"/>
                </group>
                <footer>
                    <button string="Update Data" type="object" name="action_import_move_line_data" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_open_import_move_line_wizard" model="ir.actions.act_window">
        <field name="name">Import Move Line Data</field>
        <field name="res_model">account.move.line.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>

