<odoo>
    <record id="account_payment_cdc_bounce_form_custodian" model="ir.ui.view">
        <field name="name">account.payment.cdc.bounce.form.custodian.form</field>
        <field name="model">account.payment.cdc.bounce</field>
        <field name="inherit_id" ref="account_cdc.account_payment_cdc_bounce_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='bounce_date']" position="after">
                <field name="custodian_id" required="1"/>
            </xpath>
        </field>
    </record>
</odoo>