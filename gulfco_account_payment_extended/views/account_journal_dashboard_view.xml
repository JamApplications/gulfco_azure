<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_journal_dashboard_kanban_view_inherit_gulfco" model="ir.ui.view">
        <field name="name">account.journal.dashboard.kanban.inherit.gulfco</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.account_journal_dashboard_kanban_view"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban/templates/t[@t-name='JournalBodyBankCash']/div[@id='dashboard_bank_cash_right']/div[@t-if='dashboard.nb_lines_bank_account_balance > 0']" position="after">
                <div class="row" t-if="dashboard.has_balance_gl">
                    <div id="dashboard_gl_balance" class="col overflow-hidden text-start">
                        <a type="object" name="action_open_balance_gl">GL Balance</a>
                    </div>
                    <div class="col-auto text-end">
                        <span dir="ltr">
                            <t t-out="dashboard.balance_gl"/>
                        </span>
                    </div>
                </div>
            </xpath>            
            <xpath expr="//kanban/templates/t[@t-name='JournalBodyBankCash']/div[@id='dashboard_bank_cash_right']/div[@t-if='dashboard.nb_lines_outstanding_pay_account_balance > 0']" position="after">
                <div class="row" t-if="dashboard.nb_lines_outstanding_pay_account_balance_received > 0">
                    <div id="dashboard_bank_cash_outstanding_balance_received" class="col overflow-hidden text-start">
                        <!-- <a type="action" name="%(account.action_account_all_payments)d" context="{'search_default_unmatched': True, 'search_default_journal_id': id, 'search_default_state_posted': True, 'search_default_payment_type': 'inbound'}"> -->
                        <a type="action" name="%(account.action_account_payments)d" context="{'search_default_unmatched': True, 'search_default_journal_id': id, 'search_default_state_posted': True, 'search_default_payment_type': 'inbound'}">
                                Payments Received
                        </a>
                    </div>
                    <div class="col-auto text-end">
                        <span>
                            <t t-out="dashboard.outstanding_pay_account_balance_received"/>
                        </span>
                    </div>
                </div>                
                <div class="row" t-if="dashboard.nb_lines_outstanding_pay_account_balance_issued > 0">
                    <div id="dashboard_bank_cash_outstanding_balance_issued" class="col overflow-hidden text-start">
                        <a type="action" name="%(account.action_account_payments_payable)d" context="{'search_default_unmatched': True, 'search_default_journal_id': id, 'search_default_state_posted': True, 'search_default_payment_type': 'outbound'}">
                                Payments Issued
                        </a>
                    </div>
                    <div class="col-auto text-end">
                        <span>
                            <t t-out="dashboard.outstanding_pay_account_balance_issued"/>
                        </span>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
