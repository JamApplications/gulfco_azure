<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_monthly_pdc_customer_report_list" model="ir.ui.view">
        <field name="name">monthly.pdc.customer.report.list</field>
        <field name="model">monthly.pdc.customer.report</field>
        <field name="arch" type="xml">
            <list string="Monthly PDC Customer Report">
                <field name="customer_code"/>
                <field name="name"/>
                <field name="uncovered_amount" widget="monetary"/>
            </list>
        </field>
    </record>


    <record id="action_monthly_pdc_customer_report" model="ir.actions.act_window">
        <field name="name">Monthly PDC Report</field>
        <field name="res_model">monthly.pdc.customer.report</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="gulfco_account_payment_extended.view_monthly_pdc_customer_report_list"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No uncovered customers found.
            </p>
        </field>
    </record>

    <menuitem id="menu_monthly_pdc_customer_report"
              name="Monthly PDC Report"
              parent="account.menu_finance_entries"
              action="action_monthly_pdc_customer_report"
              />


</odoo>
