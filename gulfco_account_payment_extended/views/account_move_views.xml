<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="account_accountant.action_move_line_posted_unreconciled" model="ir.actions.act_window">
            <field name="context">{'journal_type': 'general', 'search_default_unreconciled': True, 'search_default_group_by_account': True, 'search_default_group_by_partner': True,'from_reconciled':1}</field>
        </record>
        <!-- TASK-15178: Rename "Refunds" menu to "Debit Memo" -->
        <record id="account.action_move_in_refund_type" model="ir.actions.act_window">
            <field name="name">Debit Memo</field>
        </record>

        <record id="account.menu_action_move_in_refund_type" model="ir.ui.menu">
            <field name="name">Debit Memo</field>
        </record>

        <record id="view_move_form_inherit_cheque_ribbon" model="ir.ui.view">
            <field name="name">account.move.form.inherit.cheque.ribbon</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@id='header_right_group']//field[@name='date']" position="before">
                    <field name="bill_date" invisible="move_type != 'out_refund'"/>
                </xpath>
                <xpath expr="//button[@id='account_invoice_payment_btn']" position="attributes">
                    <attribute name="invisible">(state != 'posted' or payment_state not in ('not_paid', 'partial', 'in_payment') or move_type not in ('in_invoice', 'in_refund', 'out_receipt', 'in_receipt') or invoice_has_outstanding )</attribute>
                </xpath>
                <xpath expr="//button[@id='account_invoice_payment_secondary_btn']" position="attributes">
                    <attribute name="invisible">(state != 'posted' or payment_state not in ('not_paid', 'partial', 'in_payment') or move_type not in ('in_invoice', 'in_refund', 'out_receipt', 'in_receipt') or not invoice_has_outstanding )</attribute>
                </xpath>

                <!-- For Paid Ribbon -->
                <xpath expr="//widget[1]" position="attributes">
                    <attribute name="invisible">
                                not show_payment_ribbon or payment_state != 'paid' or move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt')
                    </attribute>
                </xpath>

                <!-- For Parial Ribbon -->
                <xpath expr="//widget[3]" position="attributes">
                    <attribute name="invisible">
                                not show_payment_ribbon or payment_state != 'partial' or move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt')
                    </attribute>
                </xpath>
                <xpath expr="//field[@name='partner_shipping_id']" position="after">
                     <label for="ref" string="Customer Reference" invisible="move_type not in ['out_invoice','out_refund']"/>
                     <field name="ref" nolabel="1" invisible="move_type not in ['out_invoice','out_refund']"/>
                </xpath>
                <xpath expr="//group[@id='other_tab_group']//group[@name='sale_info_group']//label[@for='ref']" position="attributes">
                    <attribute name="invisible">move_type in ['out_invoice','out_refund']</attribute>
                </xpath>
                <xpath expr="//group[@id='other_tab_group']//group[@name='sale_info_group']//field[@name='ref']" position="attributes">
                    <attribute name="invisible">move_type in ['out_invoice','out_refund']</attribute>
                </xpath>
                <xpath expr="//div[@name='journal_div']" position="after">
                    <field name="transaction_date" readonly="1" force_save="1"/>
                </xpath>
            </field>
            </record>

        <record id="gulfco_view_move_tree_transaction_date" model="ir.ui.view">
            <field name="name">gulfco.view.move.tree.transaction.date</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='date']" position="after">
                    <field name="transaction_date"/>
                </xpath>
            </field>
        </record>

        <record id="account_move_form_gulfo_inherit" model="ir.ui.view">
            <field name="name">account.move.form.inherit</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <field name="preferred_payment_method_line_id" position="after">
                    <field name="media_id"/>
                </field>
                <xpath expr="//field[@name='invoice_payment_term_id']" position="attributes">
                    <attribute name="groups">gulfco_contact_registration_custom.group_ccd_approval,gulfco_contact_registration_custom.group_ccd_officer_approval</attribute>
                </xpath>
                 <xpath expr="//field[@name='invoice_payment_term_id']" position="after">
                     <field name="invoice_payment_term_id" context="{'example_date': invoice_date, 'example_amount': tax_totals['total_amount_currency']}" placeholder="Payment Terms" options="{'no_quick_create':True}" readonly="1" groups="!gulfco_contact_registration_custom.group_ccd_approval"/>
                </xpath>
            </field>
        </record>


        <record id="view_move_line_reconcile_tree_inherit_custom" model="ir.ui.view">
            <field name="name">account.move.line.reconcile.tree.inherit.custom</field>
            <field name="model">account.move.line</field>
            <field name="inherit_id" ref="account_accountant.view_move_line_reconcile_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='matching_number']" position="after">
                    <field name="payment_amount" optional="hide"/>
                    <field name="payment_amount_currency" optional="hide"/>
                    <field name="matching_reference" optional="hide"/>
                </xpath>
                <xpath expr="//field[@name='ref']" position="after">
                    <field name="invoice_origin" string="Source Document" optional="show"/>
                </xpath>
                <xpath expr="//list" position="inside">
                    <field name="comment" optional="hide"/>
                </xpath>
            </field>
        </record>
        <record id="view_move_line_tree_comment_field" model="ir.ui.view">
            <field name="name">account.move.line.list.comment.field</field>
            <field name="model">account.move.line</field>
            <field name="inherit_id" ref="account.view_move_line_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//list" position="inside">
                    <field name="comment" optional="hide"/>
                </xpath>
                <xpath expr="//field[@name='date']" position="after">
                    <field name="matched_date" optional="show"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
