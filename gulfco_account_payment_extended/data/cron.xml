<odoo>
    <data noupdate="1">

        <!-- Cron to auto-clear PDC/CDC payments -->
        <record id="ir_cron_auto_clear_pdc_cdc_payables" model="ir.cron">
            <field name="name">Auto Clear PDC &amp; CDC Payables</field>
            <field name="model_id" ref="account.model_account_payment"/>
            <field name="state">code</field>
            <field name="code">model._cron_auto_clear_pdc_cdc_payables()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>

        <record id="ir_cron_uncovered_monthly_pdc_hold_check" model="ir.cron">
            <field name="name">Uncovered Monthly PDC Auto Credit Hold</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="state">code</field>
            <field name="code">model._cron_uncovered_monthly_pdc_hold_check()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
