<odoo>
    <!-- Action لفتح الويزرد -->
    <record id="action_loyalty_rule_customer_wizard" model="ir.actions.act_window">
        <field name="name">Manage Customers</field>
        <field name="res_model">loyalty.rule.customer.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_loyalty_rule_customer_wizard_form" model="ir.ui.view">
        <field name="name">loyalty.rule.customer.wizard.form</field>
        <field name="model">loyalty.rule.customer.wizard</field>
        <field name="arch" type="xml">
            <form string="Filter Customers">
                <group>
                    <field name="customer_ids" widget="many2many_tags"
                           domain="[('contact_type','=','customer')]"
                           options="{'no_create': True, 'no_create_edit': True}"/>
                </group>
                <footer>
                    <button name="action_add_selected_customers"
                            type="object" string="Add" class="btn-primary"/>
                    <button name="action_remove_selected_customers"
                            type="object" string="Remove" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
