<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="gulfco_view_warehouse_form_inherit" model="ir.ui.view">
            <field name="name">gulfco.stock.warehouse.form.inherit</field>
            <field name="model">stock.warehouse</field>
            <field name="inherit_id" ref="stock.view_warehouse"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id']" position="attributes">
                   <attribute name="context">{'show_address':1,'show_vat':1}</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
