<odoo>
<data>
<record id="product_package_transmed_b2b_inherit_form" model="ir.ui.view">
            <field name="name">product.package.transmed.b2b.inherit.form</field>
            <field name="model">product.packaging</field>
            <field name="inherit_id" ref="product.product_packaging_form_view"/>
            <field name="arch" type="xml">
            <field name="product_id" position="after">
                <field name="secondary_package"/>
                <field name="secondary_quantity"/>
                <field name="secondary_package_active" invisible="1"/>
            </field>
            </field>
        </record>

    <record id="view_product_package_tree_view_inherit_custom" model="ir.ui.view">
            <field name="name">product.package.tree.view.inherit.custom</field>
            <field name="model">product.packaging</field>
            <field name="inherit_id" ref="stock.product_packaging_tree_view"/>
            <field name="arch" type="xml">
            <field name="package_type_id" position="after">
                <field name="secondary_package" domain="[('id','in',parent.packaging_ids), ('id', '!=', id)]"/>
<!--                <field name="secondary_package" domain="[('id', '!=', id)]" context="{'custom_parent_id' : parent.id}"/>-->
                <field name="secondary_quantity"/>
                <field name="secondary_package_active" column_invisible="1"/>
<!--                <field name="allowed_secondary_packaging_ids" column_invisible="1"/>-->
            </field>
            </field>
        </record>


    </data>
</odoo>