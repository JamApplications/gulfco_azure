<?xml version="1.0" encoding="utf-8"?>
<odoo>


    <record id="product_data_brand_simple_form" model="ir.ui.view">
        <field name="name">product.brand.data.form.simple</field>
        <field name="model">product.brand</field>
        <field name="arch" type="xml">
            <form>
                <sheet>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" class="oe_inline"/>
                        </h1>
                    </div>

                </sheet>
            </form>
        </field>
    </record>

    <record id="product_data_brand_simple_tree" model="ir.ui.view">
        <field name="name">product.brand.data.tree.simple</field>
        <field name="model">product.brand</field>
        <field name="arch" type="xml">
            <list string="Brands">
                <field name="name"/>
            </list>
        </field>
    </record>


    <record id="action_product_brand_view_list" model="ir.actions.act_window">
        <field name="name">Product Brands</field>
        <field name="res_model">product.brand</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Products found. Let's create one!
            </p>

        </field>
    </record>


    <menuitem id="menu_product_brand" name="Product Brands" parent="stock.menu_warehouse_config"
              action="action_product_brand_view_list" sequence="3"/>


</odoo>