
<odoo>
    <record id="view_customer_stock_form" model="ir.ui.view">
        <field name="name">customer.stock.form</field>
        <field name="model">customer.stock</field>
        <field name="arch" type="xml">
            <form string="Customer Stock">
                <sheet>
                    <group>
                        <group>
                            <field name="location_id"/>
                            <field name="customer_id"/>
                        </group>
                        <group>
                             <field name="date"/>
                            <field name="worker_id"/>
                            <field name="visit_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Stock Lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="product_id" context="{'from_sales_budget':1}"/>
                                    <field name="item_name"/>
                                    <field name="qty"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="customer_stock_view_tree" model="ir.ui.view">
        <field name="name">customer_stock_view_tree</field>
        <field name="model">customer.stock</field>
        <field name="arch" type="xml">
            <list string="customer_stock_tree">
                <field name="location_id"/>
                <field name="customer_id"/>
                <field name="date"/>
                <field name="worker_id"/>
                <field name="visit_id"/>
            </list>
        </field>
    </record>

    <record id="action_customer_stock" model="ir.actions.act_window">
        <field name="name">Customer Stock Count</field>
        <field name="res_model">customer.stock</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_customer_stock_root" name="Inventory" parent="fieldservice.root" sequence="22" groups="plnx_sales_team.group_sales_team_pre_sales"/>
    <menuitem id="menu_customer_stock" name="Customer Stock Count" parent="menu_customer_stock_root" action="action_customer_stock" sequence="1"/>
</odoo>
