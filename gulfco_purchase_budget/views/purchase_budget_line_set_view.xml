<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <odoo>
    <data>
        <record id="purchase_budget_line_values_pivot_view" model="ir.ui.view">
            <field name="name">purchase.budget.line.values.pivot</field>
            <field name="model">purchase.budget.line.values</field>
            <field name="arch" type="xml">
                <pivot string="purchase.budget.line.values">
                    <field name="start_date" type="start_date" interval="month"/>
                    <field name="partner_id" type="row"/>
                    <field name="description" type="row"/>
                    <field name="month" type="col"/>
<!--                    <field name="category_id"/>-->
                    <field name="lead_time_month"/>
                    <field name="value" type="measure"/>
                </pivot>
            </field>
        </record>
    </data>
</odoo>

