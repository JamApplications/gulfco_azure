<odoo>
    <record id="view_users_form_inherit_barcode_pin" model="ir.ui.view">
        <field name="name">res.users.form.barcode.pin</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='preferences']/group" position="after">
                <group string="Barcode Inventory" name="barcode_inventory">
                    <field name="allow_multi_employee"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
