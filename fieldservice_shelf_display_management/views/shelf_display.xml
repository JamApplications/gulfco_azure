<odoo>
    <record id="view_shelf_display_form" model="ir.ui.view">
        <field name="name">Shelf Display Form</field>
        <field name="model">shelf.display</field>
        <field name="arch" type="xml">
            <form string="Shelf Display">
                <sheet>
                    <group>
                        <group>
                            <field name="customer_id"/>
                            <field name="display_area_id"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="worker_id" context="{'default_contact_type': 'worker', 'default_fsm_person': 1, 'default_company_type': 'person'}"/>
                            <field name="visit_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Display Area Lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="item_name"/>
                                    <field name="uom_id"/>
                                    <field name="old_qty"/>
                                    <field name="current_qty"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="shelf_display_view_tree" model="ir.ui.view">
        <field name="name">Shelf Display Tree</field>
        <field name="model">shelf.display</field>
        <field name="arch" type="xml">
            <list string="Shelf Display">
                <field name="customer_id"/>
                <field name="display_area_id"/>
                <field name="date"/>
                <field name="worker_id"/>
                <field name="visit_id"/>
            </list>
        </field>
    </record>


    <record id="action_shelf_displayy" model="ir.actions.act_window">
        <field name="name">Shelf Display</field>
        <field name="res_model">shelf.display</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="shelf_display_view_tree"/>
    </record>

    <menuitem id="shelf_display" name="Shelf Display" parent="fieldservice.operations" action="action_shelf_displayy" groups="plnx_sales_team.group_sales_team_merchandiser"/>


</odoo>