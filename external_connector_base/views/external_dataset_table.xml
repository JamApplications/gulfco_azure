<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- External Dataset Table List View -->
        <record id="view_external_dataset_table_list" model="ir.ui.view">
            <field name="name">external.dataset.table.list</field>
            <field name="model">external.dataset.table</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="model_id"/>
                </list>
            </field>
        </record>

        <!-- External Dataset Table Form View -->
        <record id="view_external_dataset_table_form" model="ir.ui.view">
            <field name="name">external.dataset.table.form</field>
            <field name="model">external.dataset.table</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="model_id"/>
                            <field name="res_model_name" invisible="1" />
                            <field name="domain" widget="domain" options="{'model': 'res_model_name'}"/>
                        </group>
                        <notebook>
                            <page string="Fields">
                                <field name="field_ids"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Main Action: external.dataset.table -->
        <record id="external_dataset_table_action" model="ir.actions.act_window">
            <field name="name">External Dataset Table</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">external.dataset.table</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                All important External Dataset Table Track handle here
            </p><p>
                Ekika helps you track, manage and maintain your External Dataset Tables activity in the software.
            </p>
            </field>
        </record>

    </data>
</odoo>
