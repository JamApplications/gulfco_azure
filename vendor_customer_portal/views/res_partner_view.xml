<?xml version="1.0"?>
<odoo>

    <record id="action_customer_portal" model="ir.actions.act_window">
        <field name="name">Customer</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('contact_type','=','customer')]</field>
        <field name="context">{'default_contact_type': 'customer','default_customer_rank':1}</field>
    </record>
    <record id="action_vendor_portal" model="ir.actions.act_window">
        <field name="name">Supplier</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('contact_type','=','supplier')]</field>
        <field name="context">{'default_contact_type': 'supplier','default_supplier_rank':1}</field>
    </record>
</odoo>