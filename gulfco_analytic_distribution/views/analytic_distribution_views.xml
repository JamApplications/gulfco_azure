<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_analytic_common_distribution_form_view" model="ir.ui.view">
        <field name="name">account.analytic.common.distribution.form.view</field>
        <field name="model">account.analytic.common.distribution</field>
        <field name="arch" type="xml">
            <form string="Analytic Distribution">
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="analytic_id"/>
                        </group>
                        <group>
                            <field name="name"/>
                        </group>
                    </group>
                    <field name="active" invisible="1"/>
                    <field name="line_ids">
                        <list string="Lines" editable="bottom">
                            <field name="analytic_id"/>
                            <field name="percentage"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="account_analytic_common_distribution_list_view" model="ir.ui.view">
        <field name="name">account.analytic.common.distribution.list.view</field>
        <field name="model">account.analytic.common.distribution</field>
        <field name="arch" type="xml">
            <list string="Analytic Distribution">
                <field name="code"/>
                <field name="name"/>
                <field name="analytic_id"/>
            </list>
        </field>
    </record>

    <record id="action_account_analytic_common_distribution" model="ir.actions.act_window">
        <field name="name">Analytic Common Distribution</field>
        <field name="res_model">account.analytic.common.distribution</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="account_analytic_common_distribution_list_view"/>
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            Add a new common distribution setup
          </p><p>
          </p>
        </field>
    </record>


    <menuitem
        id="menu_account_analytic_common_distribution"
        name="Analytic Common Distribution"
        parent="account.menu_analytic_accounting"
        sequence="999"
        action="action_account_analytic_common_distribution"
        groups="analytic.group_analytic_accounting"
    />

    <record model="ir.cron" id="distribute_common_cron">
        <field name="name">Distribute Common Analytic</field>
        <field name="model_id" ref="account.model_account_move" />
        <field name="state">code</field>
        <field name="code">model._action_distribute()</field>
        <field name="interval_number">30</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now().replace(hour=0, minute=5) + timedelta(days=1)).strftime('%Y-%m-%d 00:05:05')" />
    </record>


    <record id="account_analytic_plan_inherit_form" model="ir.ui.view">
        <field name="name">account.analytic.plan.inherit.form</field>
        <field name="model">account.analytic.plan</field>
        <field name="inherit_id" ref="analytic.account_analytic_plan_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="before">
                <group>
                    <field name="is_location"/>
                    <field name="is_department"/>
                    <field name="is_channel"/>
                    <field name="active" invisible="1"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="account_analytic_inherit_form" model="ir.ui.view">
        <field name="name">account.analytic.inherit.form</field>
        <field name="model">account.analytic.account</field>
        <field name="inherit_id" ref="analytic.view_account_analytic_account_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="before">
                <group>
                    <field name="is_common"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
