<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_stock_dio_wizard_form" model="ir.ui.view">
        <field name="name">stock.dio.wizard.form</field>
        <field name="model">stock.dio.wizard</field>
        <field name="arch" type="xml">
            <form string="Stock DIO Report">
                <group>
                    <field name="date_from"/>
                    <field name="date_to"/>

                    <field name="product_id"/>
                    <field name="categ_id"/>
                    <field name="brand_id"/>
                    <field name="product_type"/>
                </group>
                <footer>
                    <button string="Generate Report"
                            type="object"
                            name="run_dio_report"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>




    <record id="action_stock_dio_wizard" model="ir.actions.act_window">
        <field name="name">Stock DIO Report</field>
        <field name="res_model">stock.dio.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>



    <menuitem id="menu_stock_dio_report_root"
              name="Stock DIO Report"
              parent="stock.menu_warehouse_report"
              action="action_stock_dio_wizard"/>
</odoo>
