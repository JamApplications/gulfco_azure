<odoo>
    <data noupdate="1">
        <record id="ir_cron_update_route_status" model="ir.cron">
            <field name="name">Update Route Status Daily</field>
            <field name="model_id" ref="model_fsm_order"/>
            <field name="state">code</field>
            <field name="code">model.cron_update_route_status()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now().replace(hour=0, minute=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')" />
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
