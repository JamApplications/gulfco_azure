<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Server Action for Regenerating Invoices -->
        <record id="action_regenerate_invoices" model="ir.actions.server">
            <field name="name">Re-Generate Invoices</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="binding_model_id" ref="sale.model_sale_order"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">
if records:
    action = records.action_regenerate_invoices()
else:
    raise UserError("No sales orders selected.")
            </field>
        </record>
    </data>
</odoo>