<odoo>
    <data>
        <record model="ir.ui.view" id="fmcg_gulfco_rma_order_inherit_form_view">
            <field name="name">RMA Order inherit</field>
            <field name="model">rma.order</field>
            <field name="inherit_id" ref="plnx_rma_order.plnx_rma_order_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='rma_line_ids']/list/field[@name='rma_id']" position="before">
                    <field name="return_reason_id"/>
<!--                    <field name="return_caused_by"/>-->
                    <field name="return_caused_by_id"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
