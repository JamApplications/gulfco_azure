<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="action_rma_submit_request" model="ir.actions.server">
        <field name="name">Submit</field>
        <field name="model_id" ref="plnx_rma_extended.model_rma"/>
        <field name="binding_model_id" ref="model_rma"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_submit_rma()</field>
        <field name="sequence" eval="5"/>
    </record>

    <record id="action_rma_confirm_request" model="ir.actions.server">
        <field name="name">Confirm</field>
        <field name="model_id" ref="model_rma"/>
        <field name="binding_model_id" ref="model_rma"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.with_context(from_rma_extended=1).action_confirm()</field>
        <field name="sequence" eval="6"/>
    </record>

     <record id="action_rma_reset_to_draft_request" model="ir.actions.server">
        <field name="name">Reset to Draft</field>
        <field name="model_id" ref="model_rma"/>
        <field name="binding_model_id" ref="model_rma"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_set_to_draft_button()</field>
        <field name="sequence" eval="7"/>
    </record>


</odoo>
