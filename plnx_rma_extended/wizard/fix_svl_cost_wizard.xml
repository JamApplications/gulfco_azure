<odoo>
    <!-- Wizard Form View -->
    <record id="view_fix_svl_cost_wizard" model="ir.ui.view">
        <field name="name">fix.svl.cost.wizard.form</field>
        <field name="model">fix.svl.cost.wizard</field>
        <field name="arch" type="xml">
            <form string="Fix SVL Costs">
                <group>
                    <field name="product_id"/>
                    <field name="fix_from_date"/>
                    <field name="correct_unit_cost" readonly="1" invisible="enter_manual_unit_cost"/>
                    <field name="enter_manual_unit_cost"/>
                    <field name="manual_unit_cost" invisible="not enter_manual_unit_cost"/>
                </group>
                <footer>
                    <button string="Fix Values" type="object" name="action_fix_svl_costs" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_fix_svl_cost_wizard" model="ir.actions.act_window">
        <field name="name">Fix SVL Costs</field>
        <field name="res_model">fix.svl.cost.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    
    <menuitem id="menu_fix_svl_cost_wizard" name="Fix SVL Costs" parent="stock.menu_stock_warehouse_mgmt" action="action_fix_svl_cost_wizard"/>

</odoo>
