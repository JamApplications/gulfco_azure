    <record id="stock_request_order_list" model="ir.ui.view">
        <field name="name">stock.request.order.list</field>
        <field name="model">stock.request.order</field>
        <field name="inherit_id" ref="stock_request.stock_request_order_tree" />
        <field name="arch" type="xml">
            <field name="warehouse_id" position="after">
                <field name="direction" />
                <field name="remarks"/>
            </field>
        </field>
    </record>
    <record id="stock_request_order_form" model="ir.ui.view">
        <field name="name">stock.request.order.form</field>
        <field name="model">stock.request.order</field>
        <field name="inherit_id" ref="stock_request.stock_request_order_form" />
        <field name="arch" type="xml">
            <div class="oe_button_box" position="inside">
                <button name="action_view_journal_entries" type="object" class="oe_stat_button" icon="fa-book" invisible="journal_entry_count == 0">
                    <field name="journal_entry_count" widget="statinfo" string="Journal Entries"/>
                </button>
            </div>
            <xpath expr="//field[@name='warehouse_id']" position="after">
                <field name="direction" invisible="1" />
                <field name="remarks" readonly="state != 'draft'"/>
                <field name="direction_account_id" readonly="state not in ['draft', 'submitted', 'division_head_approved', 'scm_approved', 'finance_approved']"/>
                <field name="analytic_account_id" invisible="direction not in ['damage_expiry_issue_out','miscellaneous_issue_out']" required="direction in ['damage_expiry_issue_out','miscellaneous_issue_out']" domain="[('plan_id.is_department_plan','=',True)]" readonly="state not in ['draft', 'submitted', 'division_head_approved', 'scm_approved', 'finance_approved']"/>
            </xpath>
            <xpath expr="//field[@name='stock_request_ids']" position="attributes">
                <attribute name="context">{
                    'default_expected_date': expected_date,
                    'default_picking_policy': picking_policy,
                    'default_warehouse_id': warehouse_id,
                    'default_direction': direction,
                    'default_location_id': location_id,
                    'default_procurement_group_id': procurement_group_id,
                    'default_company_id': company_id,
                    'default_state': state,
                    }</attribute>
            </xpath>
            <xpath expr="//list/field[@name='product_id']" position="after">
                <field name="analytic_distribution" groups="analytic.group_analytic_accounting" widget="analytic_distribution"/>
                <field name="direction_account_id" readonly="order_state not in ['draft','submitted', 'division_head_approved', 'scm_approved', 'finance_approved']"/>
            </xpath>
            <xpath expr="//list/field[@name='warehouse_id']" position="after">
                <field name="direction" column_invisible="1" />
                 <field name="remarks" readonly="state != 'draft'"/>
            </xpath>
        </field>
    </record>
</odoo>
