<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- List View -->
    <record id="view_stock_request_direction_account_list" model="ir.ui.view">
        <field name="name">stock.request.direction.account.list</field>
        <field name="model">stock.request.direction.account</field>
        <field name="arch" type="xml">
            <list string="Stock Request Direction Accounts">
                <field name="direction"/>
                <field name="account_id"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_stock_request_direction_account_form" model="ir.ui.view">
        <field name="name">stock.request.direction.account.form</field>
        <field name="model">stock.request.direction.account</field>
        <field name="arch" type="xml">
            <form string="Stock Request Direction Account">
                <sheet>
                    <group>
                        <field name="direction" class="w-auto"/>
                        <field name="account_id" class="w-auto"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_stock_request_direction_account" model="ir.actions.act_window">
        <field name="name">Request Type Accounts Mapping</field>
        <field name="res_model">stock.request.direction.account</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu (under Settings) -->
    <menuitem id="menu_stock_request_direction_account" name="Request Type Accounts Mapping" parent="stock_request.menu_stock_request_config" action="action_stock_request_direction_account" sequence="10" groups="base.group_system" />
</odoo>