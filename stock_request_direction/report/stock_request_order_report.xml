        <template id="stock_request_report_template">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <t t-foreach="docs" t-as="o">
                        <t t-if="o.direction in ['sample_issue_out','consumable_issuance','scrap_issuance']">
                            <t t-call="stock_request_direction.stock_request_report_sample_consum_scap_template"/>
                        </t>
                        <t t-elif="o.direction in ['branch_transfer','internal_transfer','van_load','van_off_load']">
                            <t t-call="stock_request_direction.stock_request_report_branch_internal_van"/>
                        </t>
                    </t>
                </t>
            </t>
        </template>
        <record id="action_stock_request_order_report" model="ir.actions.report">
            <field name="name">Stock Request Report</field>
            <field name="model">stock.request.order</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">stock_request_direction.stock_request_report_template</field>
            <field name="report_file">stock_request_direction.stock_request_report_template</field>
            <field name="print_report_name">'Stock Request Report'</field>
            <field name="binding_model_id" ref="stock_request_direction.model_stock_request_order"/>
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="stock_request_direction.gulfco_stock_request_report_paperformat"/>
        </record>
    </data>
</odoo>