<?xml version="1.0"?>
<odoo>
    <record id="ag_product_cost_update_form" model="ir.ui.view">
        <field name="name">ag.product.cost.update.form</field>
        <field name="model">product.cost.update</field>
        <field name="arch" type="xml">
            <form string="Product Cost Update">
                <group>
                    <group>
                        <field name="start_date"/>
                        <field name="end_date"/>
                    </group>
                    <group>
                        <field name="product_id" options="{'no_create':True,'no_open':True}"/>
                        <field name="current_cost" invisible="not product_id"/>
                        <field name="new_cost" invisible="not product_id"/>
                    </group>
                </group>
                <footer>
                    <button name="action_update_product_cost" string="Update Cost" type="object"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="ag_product_cost_update_action" model="ir.actions.act_window">
        <field name="name">Update Product Cost</field>
        <field name="res_model">product.cost.update</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="ag_product_cost_update_form"/>
    </record>


    <!-- This Menu Item must have a parent and an action -->
    <menuitem id="menu_cost_update" name="Inventory Recalculation" parent="stock.menu_stock_warehouse_mgmt" action="ag_product_cost_update_action" sequence="20"/>


</odoo>