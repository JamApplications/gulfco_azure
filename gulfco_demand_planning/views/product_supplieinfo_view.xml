<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_supplierinfo_data_inherit_demand_planning_form" model="ir.ui.view">
        <field name="name">product.product.supplierinfo.data.demand.planning.inherit.form</field>
        <field name="model">product.supplierinfo</field>
        <field name="inherit_id" ref="gulfco_product_customized_data.product_supplierinfo_data_inherit_accounting_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='supplier_type_id']" position="after">
                <field name="source_of_good_country_ids" widget="many2many_tags"/>
                <field name="supplier_mos"/>
            </xpath>
        </field>
    </record>
</odoo>