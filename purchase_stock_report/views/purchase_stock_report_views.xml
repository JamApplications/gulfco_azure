<!--              action="action_purchase_stock_report"/>-->

    <!-- Menu -->
    <menuitem id="menu_purchase_stock_report_root"
              name="Purchase Stock Report"
              parent="purchase.purchase_report_main"
              action="action_purchase_stock_report"/>

</odoo>
