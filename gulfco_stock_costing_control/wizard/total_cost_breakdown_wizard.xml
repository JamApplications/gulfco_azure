<odoo>
    <record id="view_total_cost_breakdown_wizard_form" model="ir.ui.view">
        <field name="name">total.cost.breakdown.wizard.form</field>
        <field name="model">total.cost.breakdown.wizard</field>
        <field name="arch" type="xml">
            <form string="Total Cost Breakdown" class="oe_form_box" create="false" edit="false">
                <group>
                    <field name="excise_duty" readonly="1"/>
                    <field name="hdr_charges" readonly="1"/>
                    <field name="po_cost_local" readonly="1"/>
                </group>
                <separator string="Total"/>
                <field name="total_cost_aed" readonly="1"/>
            </form>
        </field>
    </record>
</odoo>