<odoo>
    <data>
        <record id="view_stock_valuation_layer_tree_deferred" model="ir.ui.view">
            <field name="name">stock.valuation.layer.tree.deferred</field>
            <field name="model">stock.valuation.layer</field>
            <field name="inherit_id" ref="stock_account.stock_valuation_layer_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//list//field[@name='quantity']" position="before">
                    <field name="is_deferred_costing" string="Deferred Valuation" readonly="1"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>