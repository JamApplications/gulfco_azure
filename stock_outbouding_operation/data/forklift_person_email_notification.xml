<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="email_template_forklift_parsion_assigned" model="mail.template">
            <field name="name">Forklift Parsion Assigned</field>
            <field name="email_from">{{ user.email_formatted or '' }}</field>
            <field name="subject">{{ object.picking_id.name }} Forklift Parson Assigned</field>
            <field name="email_to">{{ object.forklift_partner_id.email or '' }}</field>
            <field name="model_id" ref="stock.model_stock_move"/>
            <field name="body_html" type="html">
                <div>
                    <p>Hello,</p>
                    <p>The Forklift
                        <strong>
                            <t t-out="object.forklift_partner_id.name or ''"/>
                        </strong>
                        You have assigned to this <t t-out="object.picking_id.name or ''"/>
                        <br/>
                        <t t-if="object.product_packaging_id">
                            This move contains package : <t t-out="object.product_packaging_id.name"/>
                        </t>
                    </p>

                </div>
            </field>
        </record>

         <record id="email_template_picker_parsion_assigned" model="mail.template">
            <field name="name">Picker Assigned</field>
            <field name="email_from">{{ user.email_formatted or '' }}</field>
            <field name="subject">{{ object.picking_id.name }} Picker Assigned</field>
            <field name="email_to">{{ object.picker_partner_id.email or '' }}</field>
            <field name="model_id" ref="stock.model_stock_move"/>
            <field name="body_html" type="html">
                <div>
                    <p>Hello,</p>
                    <p>The Picker
                        <strong>
                            <t t-out="object.picker_partner_id.name or ''"/>
                        </strong>
                        You have assigned to this <t t-out="object.picking_id.name or ''"/>
                        <br/>
                        <t t-if="object.product_packaging_id">
                            This move contains package : <t t-out="object.product_packaging_id.name"/>
                        </t>
                    </p>

                </div>
            </field>
        </record>
    </data>
</odoo>