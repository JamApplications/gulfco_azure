    <record id="action_assigned_picker_stock_move" model="ir.actions.server">
        <field name="name">Assigned picker</field>
        <field name="model_id" ref="stock.model_stock_move"/>
        <field name="binding_model_id" ref="stock.model_stock_move"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.send_notification_to_picker()</field>
    </record>
    <record id="action_un_assigned_picker_stock_move" model="ir.actions.server">
        <field name="name">Un-Assigned picker</field>
        <field name="model_id" ref="stock.model_stock_move"/>
        <field name="binding_model_id" ref="stock.model_stock_move"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.unassigned_picker()</field>
    </record>

     <record id="action_assigned_forklift_stock_move" model="ir.actions.server">
        <field name="name">Assigned Forklift</field>
        <field name="model_id" ref="stock.model_stock_move"/>
        <field name="binding_model_id" ref="stock.model_stock_move"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.send_notification_to_forklift()</field>
    </record>
    <record id="action_un_assigned_forklift_stock_move" model="ir.actions.server">
        <field name="name">Un-Assigned Forklift</field>
        <field name="model_id" ref="stock.model_stock_move"/>
        <field name="binding_model_id" ref="stock.model_stock_move"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.unassigned_forklift()</field>
    </record>

    <record id="action_check_availability_stock_move" model="ir.actions.server">
        <field name="name">Check Availability</field>
        <field name="model_id" ref="stock.model_stock_move"/>
        <field name="binding_model_id" ref="stock.model_stock_move"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.check_availability_move_wise()</field>
    </record>
    <record id="action_put_in_pack_stock_move" model="ir.actions.server">
        <field name="name">Put in pack</field>
        <field name="model_id" ref="stock.model_stock_move"/>
        <field name="binding_model_id" ref="stock.model_stock_move"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.action_put_in_pack_stock_move()</field>
    </record>
    <record id="action_load_dispatched_picking_package" model="ir.actions.server">
        <field name="name">Load &amp; Dispatched</field>
        <field name="model_id" ref="stock_outbouding_operation.model_stock_quant_package"/>
        <field name="binding_model_id" ref="stock_outbouding_operation.model_stock_quant_package"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.action_load_dispatched_picking()</field>
    </record>
</odoo>