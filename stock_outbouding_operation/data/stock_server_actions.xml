<odoo>
    <record id="ir_actions_server_ship_and_confirm_stock_move" model="ir.actions.server">
        <field name="name">Ship &amp; Confirm</field>
        <field name="model_id" ref="stock.model_stock_move"/>
        <field name="state">code</field>
        <field name="binding_view_types">list</field>
        <field name="code">records.ship_confirm_button_validate()</field>
        <field name="binding_model_id" ref="stock.model_stock_move"/>
        <field name="binding_type">action</field>
        <field name="sequence">2</field>
    </record>

    <record id="action_add_stock_move_to_batch" model="ir.actions.server">
        <field name="name">Add to Batch</field>
        <field name="model_id" ref="stock.model_stock_move"/>
        <field name="binding_model_id" ref="stock.model_stock_move"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
            action = records._open_batch_wizard_from_move()
        </field>
    </record>


    <record id="action_loaded_and_dispatched_stock_move" model="ir.actions.server">
        <field name="name">Loaded &amp; Dispatched</field>
        <field name="model_id" ref="stock.model_stock_move"/>
        <field name="binding_model_id" ref="stock.model_stock_move"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.picking_id.filtered(lambda s:s.state == 'draft' and s.picking_type_code == 'outgoing').loaded_dispatched()</field>
    </record>
    <record id="action_delivery_stock_move" model="ir.actions.server">
        <field name="name">Delivery</field>
        <field name="model_id" ref="stock.model_stock_move"/>
        <field name="binding_model_id" ref="stock.model_stock_move"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.picking_id.filtered(lambda s:s.state == 'loaded_dispatched' and s.picking_type_code == 'outgoing').button_validate()</field>
    </record>
    <record id="action_validate_stock_move" model="ir.actions.server">
        <field name="name">Validate</field>
        <field name="model_id" ref="stock.model_stock_move"/>
        <field name="binding_model_id" ref="stock.model_stock_move"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.picking_id.filtered(lambda s:s.state in ['draft', 'confirmed', 'assigned'] and s.picking_type_code != 'outgoing').button_validate()</field>
    </record>
