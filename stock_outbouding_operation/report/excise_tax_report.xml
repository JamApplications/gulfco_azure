<odoo>
  <record id="paperformat_excise_tax_report" model="report.paperformat">
    <field name="name">excise_tax</field>
    <field name="default" eval="False" />
    <field name="format">A4</field>
    <field name="orientation">Portrait</field>
    <field name="margin_top">85</field>
    <field name="margin_bottom">35</field>
    <field name="margin_left">5</field>
    <field name="margin_right">5</field>
    <field name="header_line" eval="False" />
    <field name="header_spacing">35</field>
  </record>
  <!-- ===================================================== -->
  <template id="excise_tax_layout">
    <t t-if="not o" t-set="o" t-value="doc" />
    <t t-if="not company">
      <!--  Multicompany  -->
      <t t-if="company_id">
        <t t-set="company" t-value="company_id" />
      </t>
      <t t-elif="o and 'company_id' in o and o.company_id.sudo()">
        <t t-set="company" t-value="o.company_id.sudo()" />
      </t>
      <t t-else="else">
        <t t-set="company" t-value="res_company" />
      </t>
    </t>
    <div class="article" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id"
      t-att-data-oe-lang="o and o.env.context.get('lang')">
      <t t-out="0" />
    </div>
  </template>
  <!-- ============================================================== -->
  <template id="excise_tax_document">
    <t t-call="stock_outbouding_operation.excise_tax_layout">
      <t t-set="o" t-value="o.with_context(lang=lang)" />
      <div class="page">
        <div class="header">
          <div class="text-center" t-if="o.move_type == 'out_invoice'"
            style="line-height: 1.5;font-family:'CairoRegular'">
            <span class="d-block fw-bold text-decoration-underline" style="font-size:20px"> Tax
              Invoice </span>
            <span class="d-block fw-bold">فاتورة ضريبية</span>
            <span class="d-block fw-bold">TRN : <t t-esc="o.company_id.vat" /></span>
          </div>
          <div class="text-center col-4" t-if="o.move_type == 'out_refund'">
            <div>
              <h2>
                <strong>
                  <u> Tax Credit Invoice </u>
                </strong>
              </h2>
            </div>
            <div>
              <h4>
                <b>
                  <span style="direction:rtl">إشعار دائن</span>
                </b>
              </h4>
            </div>
            <div>
              <strong>TRN : <span t-esc="company.vat" />
              </strong>
            </div>
          </div>
          <!-- ============================================================= -->
          <table class="table table-borderless company-details">
            <tr>
              <td style="">
                Division/Company:
              </td>
              <td>
                <t t-esc="o.company_id.name" />
              </td>
              <td>
                :الشركة
              </td>
              <td>
                Outlet:
              </td>
              <td>
                <t t-esc="o.company_id.state_id.name if o.company_id.state_id else ''" />
              </td>
              <td>
                :مخرج
              </td>
            </tr>
            <tr>
              <td>
                Branch:
              </td>
              <td>
                <t t-esc="o.company_id.state_id.name if o.company_id.state_id else ''" />
              </td>
              <td>
                :الفرع
              </td>
              <td>
                Printed Date:
              </td>
              <td>
                <span t-esc="datetime.datetime.now(datetime.timezone.utc).strftime('%d-%b-%y')" />
              </td>
              <td>
                :تاريخ الطباعة
              </td>
            </tr>
          </table>
          <!-- ================================================================ -->
          <table class="table company-details invoice-no-date-box">
            <tr>
              <td>
                Invoice No:
              </td>
              <td>
                <t t-out="o.name" />
              </td>
              <td>
                :رقم الفاتورة
              </td>
              <td>
                Invoice Date:
              </td>
              <td>
                <t t-out="o.invoice_date.strftime('%d-%b-%y') if o.invoice_date else ''" />
              </td>
              <td>
                :تاريخ الفاتورة
              </td>
            </tr>
          </table>
        </div>


        <!-- ================================================================ -->
        <div class="d-flex flex-row">
          <div class="d-flex flex-column" style="width:60%;">
            <!-- Bill To Customer Details -->
            <div class="mb-3">
              <table class="table box-details">
                <thead>
                  <tr>
                    <th colspan="2">Bill To Customer Details</th>
                    <th>فاتورة لتفاصيل العميل</th>
                  </tr>
                </thead>
                <tr>
                  <td>
                    Customer A/C No:
                  </td>
                  <td>
                    <span t-out="o.partner_id.customer_code or ''" />
                  </td>
                  <td>
                    :رقم حساب العميل
                  </td>
                </tr>
                <tr>
                  <td>
                    Customer Name:
                  </td>
                  <td>
                    <span t-out="o.partner_id.name" />
                  </td>
                  <td>
                    :اسم العميل
                  </td>
                </tr>
                <tr>
                  <td>
                    Address:
                  </td>
                  <td>
                    <div t-field="o.partner_id"
                      t-options='{"widget": "contact", "fields": ["address"], "no_marker": True, "phone_icons": True}' />
                  </td>
                  <td>
                    :عنوان العميل
                  </td>
                </tr>
                <tr>
                  <td>
                    Po Box No:
                  </td>
                  <td>
                    <t t-out="o.partner_id.po_box or ''" />
                  </td>
                  <td>
                    :رقم الصندوق البريدي
                  </td>
                </tr>
                <tr>
                  <td>
                    Tel No:
                  </td>
                  <td>
                    <t t-out="o.partner_id.phone or ''" />
                  </td>
                  <td>
                    :رقم الهاتف
                  </td>
                </tr>
                <tr>
                  <td>
                    Customer TRN:
                  </td>
                  <td>
                    <t t-out="o.partner_id.vat_trn or ''" />
                  </td>
                  <td>
                    :رقم السجل الضريبي
                  </td>
                </tr>
              </table>
            </div>
            <!-- Ship To Customer Details -->
            <div>
              <table class="table box-details">
                <thead>
                  <tr>
                    <th colspan="2">Ship To Customer Details</th>
                    <th>الشحن الى تفاصيل العميل </th>
                  </tr>
                </thead>
                <tr>
                  <td>
                    Customer A/C No:
                  </td>
                  <td>
                    <t t-out="o.partner_shipping_id.customer_code or ''" />
                  </td>
                  <td>
                    :رقم الحساب
                  </td>
                </tr>
                <tr>
                  <td>
                    Customer Name:
                  </td>
                  <td>
                    <t t-out="o.partner_shipping_id.name or ''" />
                  </td>
                  <td>
                    :اسم الحساب
                  </td>
                </tr>
                <tr>
                  <td>
                    Address:
                  </td>
                  <td>
                    <div t-field="o.partner_shipping_id"
                      t-options='{"widget": "contact", "fields": ["address"], "no_marker": True, "phone_icons": True}' />
                  </td>
                  <td>
                    :العنوان
                  </td>
                </tr>
                <tr>
                  <td>
                    Po Box No:
                  </td>
                  <td>
                    <t t-out="o.partner_shipping_id.po_box or ''" />
                  </td>
                  <td>
                    :رقم الصندوق البريدي
                  </td>
                </tr>
                <tr>
                  <td>
                    Tel No:
                  </td>
                  <td>
                    <t t-out="o.partner_shipping_id.phone or ''" />
                  </td>
                  <td>
                    :رقم الهاتف
                  </td>
                </tr>
                <tr>
                  <td>
                    Ship To TRN:
                  </td>
                  <td>
                    <t t-out="o.partner_shipping_id.vat_trn or ''" />
                  </td>
                  <td>
                    :الشحن الى رقم السجل الضريبي
                  </td>
                </tr>
              </table>

            </div>
          </div>
          <!-- ================================================================ -->
          <div class="d-flex flex-column" style="width:39%;margin-left:10px">
            <!-- Invoice Details -->
            <div class="mb-3">
              <table class="table box-details">
                <thead>
                  <tr>
                    <th>Invoice Details</th>
                    <th colspan="2">تفاصيل الفاتورة</th>
                  </tr>
                </thead>
                <tr>
                  <td>
                    Invoice No:
                  </td>
                  <td class="fw-bold">
                    <t t-out="o.name" />
                  </td>
                  <td>
                    :رقم الفاتورة
                  </td>
                </tr>
                <tr>
                  <td>
                    Invoice Date:
                  </td>
                  <td>
                    <t t-out="o.invoice_date.strftime('%d-%b-%y') if o.invoice_date else ''" />
                  </td>
                  <td>
                    :تاريخ الفاتورة
                  </td>
                </tr>
                <tr>
                  <td>
                    Sales Order Number:
                  </td>
                  <td>
                    <t t-out="o.invoice_origin or ''" />
                  </td>
                  <td>
                    :رقم طلب المبيعات
                  </td>
                </tr>
                <tr>
                  <td>
                    PO No.:
                  </td>
                  <td>
                    <t t-out="o.po_number or ''" />
                  </td>
                  <td>
                    :رقم الصندوق البريدي
                  </td>
                </tr>
                <tr>
                  <td>
                    Payment Terms:
                  </td>
                  <td>
                    <t t-out="o.invoice_payment_term_id.name or ''" />
                  </td>
                  <td>
                    :شروط الدفع
                  </td>
                </tr>
                <tr>
                  <td>
                    Salesman:
                  </td>
                  <td>
                    <t t-out="o.user_id.name or ''" />
                  </td>
                  <td>
                    :مندوب المبيعات
                  </td>
                </tr>
                <tr>
                  <td>
                    Date of Supply:
                  </td>
                  <td>
                    <t t-out="o.delivery_date" />
                  </td>
                  <td>
                    :تاريخ التزويد
                  </td>
                </tr>
                <tr>
                  <td>
                    Currency:
                  </td>
                  <td>
                    <t t-out="o.currency_id.name" />
                  </td>
                  <td>
                    :العملة
                  </td>
                </tr>
                <tr>
                  <td>
                    Currency Rate:
                  </td>
                  <td>
                    <t t-out="o.currency_id.rate" />
                  </td>
                  <td>
                    :سعر العملة
                  </td>
                </tr>
              </table>
            </div>
            <!-- Remark -->
            <div>
              <table class="table remark-box">
                <thead>
                  <tr>
                    <th>Remark</th>
                    <th colspan="2">ملاحظات: </th>
                  </tr>
                </thead>
              </table>
            </div>
          </div>
        </div>
        <!-- ================================================================ -->
        <t t-set="company_currency" t-value="o.company_id.currency_id" />
        <t t-set="invoice_company_currency_same" t-value="o.currency_id == company_currency" />

        <table class="table mt-3 invoice-lines">
          <thead>
            <tr>
              <th>Sr</th>
              <th >Description</th>
              <th>UOM</th>
              <th>Qty</th>
              <th>Unit Price</th>
              <th>Discount (%)</th>
              <th>Excise Tax</th>
              <th>Total Taxable Amount</th>
              <t t-if="not invoice_company_currency_same">
                <th>Total Taxable Amount (AED)</th>
              </t>
              <th width="50px">Tax %</th>
              <th>Total Tax Amount</th>
              <th>Amount Invoice Inc. VAT</th>
              <t t-if="not invoice_company_currency_same">
                <th>Amount Invoice Inc. VAT (AED)</th>
              </t>
            </tr>
            <tr>
              <th># </th>
              <th>التفاصيل</th>
              <th>وحدة القياس</th>
              <th>الكمية</th>
              <th>سعر الوحدة</th>
              <th>خصم لكل وحدة</th>
              <th>ضريبة الإنتاج</th>
              <th> المبلغ الخاضع للضريبة</th>
              <t t-if="not invoice_company_currency_same">
                <th> المبلغ الخاضع
                  للضريبة (درهم إماراتي)</th>
              </t>
              <th>ضريبة % </th>
              <th> مبلغ الضريبة</th>
              <th> متضمنا ضريبة القيمة المضافة</th>
              <t t-if="not invoice_company_currency_same">
                <th>مبلغ الفاتورة شامل
                  ضريبة القيمة المضافة (درهم إماراتي)</th>
              </t>
            </tr>
          </thead>
          <tbody>
            <t t-set="sequence" t-value="0" />
            <t t-set="total_quantity" t-value="0" />
            <t t-set="total_excise_tax" t-value="0" />
            <t t-set="total_taxable_amount" t-value="0" />
            <t t-set="tax_amount" t-value="0" />
            <t t-set="amount_invoice_vat" t-value="0" />
             <t t-set="lot_values" t-value="o._get_invoiced_lot_values()"/>

            <t t-foreach="o.invoice_line_ids" t-as="line" t-index="idx">
              <t t-set="line_lots" t-value="filter(lambda lot:lot.get('product_name') == line.product_id.display_name,lot_values)"/>
              <tr>
                <t t-set="sequence" t-value="sequence + 1" />
                <td>
                  <span t-esc="sequence" />
                </td>
                <td>
                  <t t-esc="line.name" />
                </td>
                <td t-esc="line.product_id.uom_id.name" />
                <td t-esc="line.quantity" />
                <t t-set="total_quantity" t-value="total_quantity+line.quantity" />
                <td t-esc="'{:,.2f}'.format(line.price_unit)" />
                <td t-esc="'{:,.2f}'.format(line.discount or 0.0)" />
                <td t-esc="'{:,.2f}'.format(line.exercise_price or 0.0)" />
                <t t-set="total_excise_tax" t-value="total_excise_tax+int(line.excise_tax)" />
                <t t-set="line_taxable_amt"
                  t-value="(float(line.price_unit) - (float(line.discount or 0.0))) * float(line.quantity) + (float(int(line.excise_tax) or 0.0))" />
                <td t-esc="'{:,.2f}'.format(line_taxable_amt or 0.0)" />
                <t t-if="not invoice_company_currency_same">
                  <td
                    t-esc="'{:,.2f}'.format(o.currency_id._convert(line_taxable_amt, company_currency, o.company_id, o.invoice_date or datetime.date.today()))" />
                </t>
                <t t-set="total_taxable_amount" t-value="total_taxable_amount + line_taxable_amt" />
                <t t-if="line.tax_ids">
                  <td t-esc="line.tax_ids.name" />
                </t>
                <t t-else="">
                  <td />
                </t>
                <t t-set="line_tax_amt"
                  t-value="(line_taxable_amt * sum(line.tax_ids.mapped('amount'))) /100" />
                <td t-esc="'{:,.2f}'.format(line_tax_amt or 0.0)" />
                <t t-set="tax_amount" t-value="tax_amount + line_tax_amt" />
                <td
                  t-esc="'{:,.2f}'.format(line_tax_amt + line_taxable_amt or 0.0)" />
                <t t-if="not invoice_company_currency_same">
                  <td
                    t-esc="'{:,.2f}'.format(o.currency_id._convert((line_tax_amt + line_taxable_amt or 0.0), company_currency, o.company_id, o.invoice_date or datetime.date.today()))" />
                </t>
                <t t-set="amount_invoice_vat"
                  t-value="amount_invoice_vat + line_tax_amt + line_taxable_amt" />
              </tr>
              <t t-if="line_lots">

                <t t-foreach="line_lots" t-as="lot">
                  <tr>
                    <td/>
                    <td> Pro: <t t-esc="lot['lot_name']"/> </td>
                    <td colspan="9"> Exp: <t t-esc="lot['expire_date']"/> </td>
                  </tr>
                </t>
                
              </t>
            </t>

            <tr>
              <td colspan="4">
                <center>Total (الإجمالي)</center>
              </td>
              <td>
                <t t-esc="total_quantity" />
              </td>
              <td></td>
              <td>
                <t t-esc="'{:,.2f}'.format(total_excise_tax)" />
              </td>
              <td>
                <t t-esc="'{:,.2f}'.format(total_taxable_amount)" />
              </td>
              <t
                t-if="not invoice_company_currency_same">
                <td>
                  <t
                    t-esc="'{:,.2f}'.format(o.currency_id._convert(total_taxable_amount, company_currency, o.company_id, o.invoice_date or datetime.date.today()))" />
                </td>
              </t>
              <td></td>
              <td>
                <t t-esc="'{:,.2f}'.format(tax_amount)" />
              </td>
              <td>
                <t t-esc="'{:,.2f}'.format(amount_invoice_vat)" />
              </td>
              <t
                t-if="not invoice_company_currency_same">
                <td>
                  <t
                    t-esc="'{:,.2f}'.format(o.currency_id._convert(amount_invoice_vat, company_currency, o.company_id, o.invoice_date or datetime.date.today()))" />
                </td>
              </t>
            </tr>
          </tbody>
        </table>
        <!-- ================================================================= -->
        <div class="row" style="page-break-inside:avoid">
          <div class="col-4" />
          <div class="col-8">
            <table class="table invoice-summary" >
              <thead>
                <tr>
                  <th>Tax Invoice Summary</th>
                  <th t-out="company_currency.name" />
                  <th>ملخص الفاتورة الضريبية</th>
                </tr>
              </thead>
              <tbody>
                <!-- Row 1: Sub Total Taxable Amount -->
                <tr>
                  <td>Sub Total Taxable Amount</td>
                  <t t-if="not invoice_company_currency_same">
                    <td
                      t-esc="'{:,.2f}'.format(o.currency_id._convert(total_taxable_amount, company_currency, o.company_id, o.invoice_date or datetime.date.today()))" />
                  </t>
                  <td
                    t-esc="'{:,.2f}'.format(total_taxable_amount)" />
                  <td>المبلغ الإجمالي الخاضع للضريبة</td>
                </tr>
                <!-- Row 2: Advance Payment -->
                <tr>
                  <td>Less: Advance Payment (Excl VAT)</td>
                  <t t-if="o.invoice_origin">
                    <t t-set="inv_sale_id"
                      t-value="env['sale.order'].sudo().search([('name','=', o.invoice_origin)], limit=1)" />
                    <t t-if="inv_sale_id">
                      <t t-set="total_advance_payment"
                        t-value="env['account.payment'].sudo().search([('sale_id','=', inv_sale_id.id)])" />
                      <t t-set="advance_amount"
                        t-value="sum(total_advance_payment.mapped('amount'))" />
                      <t t-if="not invoice_company_currency_same">
                        <td style="text-align:right; padding: 3px 5px;"
                          t-esc="'{:,.2f}'.format(o.currency_id._convert(advance_amount, company_currency, o.company_id, o.invoice_date or datetime.date.today()))" />
                      </t>
                      <td
                        t-esc="'{:,.2f}'.format(advance_amount)" />
                    </t>
                    <t t-else="">
                      <t t-if="not invoice_company_currency_same">
                        <td>0.00</td>
                      </t>
                      <td>0.00</td>
                    </t>
                  </t>
                  <t t-else="">
                    <td>0.00</td>
                    <t t-if="not invoice_company_currency_same">
                      <td>0.00</td>
                    </t>
                  </t>
                  <td>أقل:(دفعة مقدمة بدون ضريبة القيمة المضافة)</td>
                </tr>
                <!-- Row 3: Net Payable (Excl VAT) -->
                <tr>
                  <td>Net Payable Amount (Excl VAT)</td>
                  <t t-if="total_advance_payment">
                    <t t-if="not invoice_company_currency_same">
                      <td
                        t-esc="'{:,.2f}'.format(o.currency_id._convert((total_taxable_amount - advance_amount), company_currency, o.company_id, o.invoice_date or datetime.date.today()))" />
                    </t>
                    <td
                      t-esc="'{:,.2f}'.format(total_taxable_amount - advance_amount)" />
                  </t>
                  <t t-else="">
                    <t t-if="not invoice_company_currency_same">
                      <td
                        t-esc="'{:,.2f}'.format(o.currency_id._convert(total_taxable_amount, company_currency, o.company_id, o.invoice_date or datetime.date.today()))" />
                    </t>
                    <td
                      t-esc="'{:,.2f}'.format(total_taxable_amount)" />
                  </t>
                  <td>صافي
                    المبلغ المستحق الدفع (بدون ض.ق.م)</td>
                </tr>
                <!-- Row 4: VAT -->
                <tr>
                  <td>VAT @ 5%</td>
                  <t t-if="not invoice_company_currency_same">
                    <td
                      t-esc="'{:,.2f}'.format(o.currency_id._convert(tax_amount, company_currency, o.company_id, o.invoice_date or datetime.date.today()))" />
                  </t>
                  <td t-esc="'{:,.2f}'.format(tax_amount)" />
                  <td>ضريبة
                    القيمة المضافة @ 5%</td>
                </tr>
                <!-- Row 5: Sub Total (Non Taxable + Zero Rated) -->
                <tr>
                  <td>Sub Total (Non Taxable + Zero Rated)</td>
                  <t t-if="not invoice_company_currency_same">
                    <td>0.00</td>
                  </t>
                  <td>0.00</td>
                  <td>المجموع
                    الفرعي (غير خاضع للضريبة + صفر التصنيف)</td>
                </tr>
                <!-- Row 6: Payment Received + Adjustment -->
                <tr>
                  <td>Payment Received + Adjustment</td>
                  <t t-if="not invoice_company_currency_same">
                    <td>0.00</td>
                  </t>
                  <td>0.00</td>
                  <td>الدفعة
                    المسددة + التنبيه</td>
                </tr>
                <!-- Row 7: Net Payable (Incl VAT) -->
                <tr>
                  <td>Net Payable Amount
                    (Incl. VAT)</td>
                  <t t-if="not invoice_company_currency_same">
                    <td
                      t-esc="'{:,.2f}'.format(o.currency_id._convert(amount_invoice_vat, company_currency, o.company_id, o.invoice_date or datetime.date.today()))" />
                  </t>
                  <td
                    t-esc="'{:,.2f}'.format(amount_invoice_vat)" />
                  <td>صافي المبلغ المستحق الدفع (مع ض.ق.م)</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
        <!-- ================================================================= -->
        <table class="table amount-summary mt-2">
          <tbody>
            <tr>
              <td>Total Tax Invoice Amount</td>

              <td class="amount">
                <t t-esc="'{:,.2f}'.format(amount_invoice_vat)" />
              </td>
              <td lang="ar">إجمالي مبلغ الفاتورة الضريبية</td>
              <td class="text">
                <t t-esc="o.currency_id.amount_to_text(amount_invoice_vat)" />
              </td>
            </tr>
            <tr>
              <td>Total Payment Received From Customer</td>
              <td class="amount">0.00</td>
              <td lang="ar">المبلغ الإجمالي المقدم من العميل</td>
              <td class="text">Zero Only</td>
            </tr>
            <tr>
              <td>Net Payable Amount</td>
              <td class="amount">
                <t t-esc="'{:,.2f}'.format(amount_invoice_vat)" />
              </td>
              <td lang="ar">صافي المبلغ المستحق الدفع</td>
              <td class="text">
                <t t-esc="o.currency_id.amount_to_text(amount_invoice_vat)" />
              </td>
            </tr>
          </tbody>
        </table>
        <div style="page-break-inside:avoid">
          <!-- ================================================================= -->
          <table class="table mt-2">
            <tbody>
              <tr>
                <td>5% = Standard Rate, 0% = Zero Rate, OOS = Out of scope, Exp = Exempt</td>
                <td width="40%" />
              </tr>
            </tbody>
          </table>
          <!-- ================================================================= -->
          <h6 class="fw-bold mt-3">
            Materials recevied in good condition - Any discrepancy should be notified within 7 days
            from the date of the invoice
          </h6>
          <h6 class="fw-bold " dir="rtl">
            تم استلام المواد في حالة جيدة - يجب الابلاغ عن اي اختلاف في غضون 7 ايام من تاريخ
            الفاتورة
          </h6>
        </div>

        <!-- ================================================================= -->
        <div class="row mt-5">
          <div class="signature col-6">
            <span class="d-block">Authorized Person / Salesman Signature</span>
            <span class="d-block">توقيع البائع / الشخص المخول</span>
            <span class="d-block">
              ــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــ
            </span>
          </div>
          <div class="col-6 signature">
            <span class="d-block">Authorized Person / Customer Signature</span>
            <span class="d-block">توقيع العميل / الشخص المخول</span>
            <span class="d-block">
              ــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــ
            </span>
          </div>
        </div>

      </div>
    </t>
  </template>


  <template id="excise_report_invoice">
    <t t-call="web.html_container">
      <t t-foreach="docs" t-as="o">
        <t t-set="lang"
          t-value="o.user_id.sudo().lang if o.move_type in ('in_invoice', 'in_refund') else o.partner_id.lang" />
        <t t-call="stock_outbouding_operation.excise_tax_document" t-lang="lang" />
      </t>
    </t>
  </template>

  <record id="excise_tax_action_report" model="ir.actions.report">
    <field name="name">Excise Tax</field>
    <field name="model">account.move</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">stock_outbouding_operation.excise_report_invoice</field>
    <field name="report_file">stock_outbouding_operation.excise_report_invoice</field>
    <field name="print_report_name">(object._get_report_base_filename())</field>
    <field name="paperformat_id" ref="stock_outbouding_operation.paperformat_excise_tax_report" />
    <field name="binding_model_id" ref="model_account_move" />
    <field name="binding_type">report</field>
  </record>
