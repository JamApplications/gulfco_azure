<odoo>
    <record id="action_report_stock_picking_not_tradable_recipt_report" model="ir.actions.report">
        <field name="name">Expense /Assets receipt</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">stock_outbouding_operation.template_not_tradable_recipt_report</field>
        <field name="report_file">stock_outbouding_operation.template_not_tradable_recipt_report</field>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">report</field>
    </record>

    <template id="template_not_tradable_recipt_report">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <t t-foreach="docs" t-as="doc">
                    <div class="page">
                        <style>
                            .manage-width td {
                            width: 50%;
                            }
                        </style>
                        <table class="table table-borderless manage-width" style="width: 100%;">
                            <tr>
                                <td>
                                    <strong>Receipt Date:</strong>
                                    <t t-esc="doc.scheduled_date"/>
                                </td>
                                <td>
                                    <strong>Invoice No:</strong>
                                    <t t-esc="doc.invoice_no"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <strong>Receipt #:</strong>
                                    <t t-esc="doc.name"/>
                                </td>
                                <td>
                                    <strong>Delivery Note:</strong>
                                    <t t-esc="doc.packing_slip"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <strong>Supplier Name</strong>
                                    <t t-esc="doc.partner_id.name"/>
                                </td>
                                <td>
                                    <strong>Vehicle No:</strong>
                                    <t t-esc="doc.vehicle_number"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <strong>Warehouse:</strong>
                                    <t t-if="doc.picking_type_id" t-esc="doc.picking_type_id.warehouse_id.name"/>
                                </td>
                                <td>
                                    <strong>Remarks:</strong>
                                    <t t-esc="doc.remark_picking"/>
                                </td>
                            </tr>
                        </table>

                        <table class="table table-sm" style="width: 100%; border: 1px solid #000;">
                            <thead>
                                <tr style="border-bottom: 1px solid #000;">
                                    <th>#</th>
                                    <th>Item Code</th>
                                    <th>Description</th>
                                    <th>Unit Qty</th>
                                    <th>Remarks</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="counter" t-value="1"/>
                                <t t-foreach="doc.move_ids_without_package.filtered(lambda line: line.product_id.item_type != 'tradable')"
                                   t-as="line">
                                    <tr>
                                        <td>
                                            <t t-esc="counter"/>
                                        </td>
                                        <td>
                                            <t t-esc="line.product_id.default_code or ''"/>
                                        </td>
                                        <td>
                                            <t t-esc="line.product_id.name"/>
                                        </td>
                                        <td>
                                            <t t-esc="line.product_uom_qty"/>
                                        </td>
                                        <td>
                                             <t t-esc="line.move_remark"/>
                                        </td>
                                    </tr>
                                    <t t-set="counter" t-value="counter + 1"/>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
