    <record id="ir_actions_server_delivery_planing" model="ir.actions.server">
        <field name="name">Planning</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="state">code</field>
        <field name="binding_view_types">list</field>
        <field name="code">action = records.planing_delivery()</field>
        <field name="binding_model_id" eval="ref('stock.model_stock_picking')"/>
        <field name="binding_type">action</field>
        <field name="sequence">2</field>
    </record>

    <record id="ir_actions_server_ship_and_confirm" model="ir.actions.server">
        <field name="name">Ship &amp; Confirm</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="state">code</field>
        <field name="binding_view_types">list</field>
        <field name="code">records.ship_confirm_button_validate()</field>
        <field name="binding_model_id" eval="ref('stock.model_stock_picking')"/>
        <field name="binding_type">action</field>
        <field name="sequence">2</field>
    </record>

    <record id="ir_actions_server_delivery_load_dispatched" model="ir.actions.server">
        <field name="name">Load &amp; Dispatched</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="state">code</field>
        <field name="binding_view_types">list</field>
        <field name="code">action = records.delivery_load_dispatched()</field>
        <field name="binding_model_id" eval="ref('stock.model_stock_picking')"/>
        <field name="binding_type">action</field>
        <field name="sequence">2</field>
    </record>

