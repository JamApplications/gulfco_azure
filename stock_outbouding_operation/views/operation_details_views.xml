    <record id="stock_outbouding_operation_view_move_search_" model="ir.ui.view">
        <field name="name">stock.move.search</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_search" />
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
              <field name="brand_id" />
              <field name="picking_driver_id" />
              <field name="picking_id" />
              <field name="partner_channel_id" />
            </xpath>
            <xpath expr="//filter[@name='groupby_picking_type_id']" position="after">
                <filter string="Operation Type Code" name="groupby_picking_type_code" domain="[]" context="{'group_by': 'picking_type_code'}"/>
                <filter string="Transfer" name="groupby_picking_id" domain="[]" context="{'group_by': 'picking_id'}"/>
                <filter string="Driver" name="groupby_picking_driver_id" domain="[]" context="{'group_by': 'picking_driver_id'}"/>
                <filter string="Brand" name="groupby_brand_id" domain="[]" context="{'group_by': 'brand_id'}"/>
                <filter string="Channel" name="groupby_partner_channel_id" domain="[]" context="{'group_by': 'partner_channel_id'}"/>
            </xpath>
        </field>
    </record>

    <record id="action_operation_details" model="ir.actions.act_window">
        <field name="name">Operation Details</field>
        <field name="res_model">stock.move</field>
        <field name="view_mode">list</field>
        <field name="context">{'from_operation_details':1,'search_default_groupby_picking_type_code':1}</field>
        <field name="view_ids" eval="[(5, 0, 0),(0, 0, {'view_mode': 'list', 'view_id': ref('stock_move_operation_details_view_tree')})]"
        />
    </record>

    <menuitem id="menu_planning_main_root"
              name="Planning"
              parent="stock.menu_stock_root"
              sequence="1" />

    <menuitem id="menu_operation_details" name="Plan Allocation" parent="menu_planning_main_root"
              action="action_operation_details"/>


    <record id="action_picking_tree_outgoing_delivery_plan" model="ir.actions.act_window">
        <field name="name">Deliveries</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('delivery_required', '=', True)]</field>
        <field name="search_view_id" ref="stock.view_picking_internal_search"/>
        <field name="view_ids" eval="[(5, 0, 0),(0, 0, {'view_mode': 'list', 'view_id': ref('stock_outbouding_operation.vpicktree_delivery_plan')})]"/>
    </record>

    <menuitem id="menu_operation_details_delivery_plan" name="Delivery Plan" parent="menu_planning_main_root"
              action="action_picking_tree_outgoing_delivery_plan" sequence="2"/>

