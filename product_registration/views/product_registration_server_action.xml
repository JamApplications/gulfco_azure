<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_record_pending_internal_approval" model="ir.actions.server">
        <field name="name">Submit for Muncipality Registration</field>
        <field name="model_id" ref="product_registration.model_product_template"/>
        <field name="binding_model_id" ref="product_registration.model_product_template"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
