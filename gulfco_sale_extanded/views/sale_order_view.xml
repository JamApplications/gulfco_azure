        <record id="sale_order_view_search_inherit_quotation_custom" model="ir.ui.view">
            <field name="name">sale.order.search.inherit.custom</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_sales_order_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//search" position="inside">
                    <filter name="state" string="Discount Approvel Status" domain="[]"
                            context="{'group_by': 'state'}"/>
                </xpath>


                <xpath expr="//field[@name='name']" position="replace">
                    <field name="name" string="Order" filter_domain="['|', '|', '|', ('name', 'ilike', self),
                    ('client_order_ref', 'ilike', self), ('partner_id', 'child_of', self), ('quotation_number', 'ilike', self)]"/>
                    <field name="quotation_number"/>
                </xpath>
            </field>
        </record>

        <record id="discount_approval_action" model="ir.actions.act_window">
            <field name="name">Discount Approval</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">sale.order</field>
            <field name="domain">[("state", "in", ["pending", "rejected"])]</field>
            <field name="context">{'search_default_my_quotation': 1, 'search_default_state': 1}
            </field>
            <field name="view_mode">list,form</field>
        </record>


        <menuitem id="menu_sale_quotations_discount_approval" name="pending Quatation (Discount)"
                  action="discount_approval_action"
                  groups="sales_team.group_sale_salesman"
                  parent="sale.sale_order_menu"
                  sequence="10"/>

    </data>
