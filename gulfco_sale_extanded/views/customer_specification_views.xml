<odoo>
    <!-- Form view -->
    <record id="view_customer_specification_form" model="ir.ui.view">
        <field name="name">customer.specification.form</field>
        <field name="model">customer.specification</field>
        <field name="arch" type="xml">
            <form string="Customer Specification">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tree view -->
    <record id="view_customer_specification_tree" model="ir.ui.view">
        <field name="name">customer.specification.tree</field>
        <field name="model">customer.specification</field>
        <field name="arch" type="xml">
            <list string="Customer Specifications">
                <field name="name"/>
            </list>
        </field>
    </record>

        <!-- Action -->
    <record id="action_customer_specification" model="ir.actions.act_window">
        <field name="name">Customer Specifications</field>
        <field name="res_model">customer.specification</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
    </record>

    <!-- Menu Item under Sales > Configuration -->
    <menuitem id="menu_customer_specification"
              name="Customer Specifications"
              parent="sale.menu_sale_config"
              action="action_customer_specification"
              sequence="60"/>
</odoo>