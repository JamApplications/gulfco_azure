<odoo>
    <data noupdate="1">
        <record id="ar_voucher_sequence" model="ir.sequence">
            <field name="name">AR Voucher Sequence</field>
            <field name="code">ar.voucher.seq.code</field>
            <field name="padding">9</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>


        <record id="ap_voucher_sequence" model="ir.sequence">
            <field name="name">AP Voucher Sequence</field>
            <field name="code">ap.voucher.seq.code</field>
            <field name="padding">9</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>