    <record id="mail_template_credit_note_draft" model="mail.template">
        <field name="name">Draft Credit Note Notification for RMA</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="subject">
            {{ object.company_id.name }} Credit Note (Ref {{ object.name or 'n/a' }}) – Draft for RMA
        </field>
        <field name="email_from">{{ object.user_id.email_formatted }}</field>
        <field name="partner_to">{{ object.partner_id.id }}</field>
        <field name="lang">{{ object.partner_id.lang }}</field>
        <field name="auto_delete" eval="True"/>
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;">
                <p style="margin: 0px; padding: 0px; font-size: 13px;">
                    Dear
                    <t t-out="object.partner_id.name" />
                    <t t-if="object.partner_id.parent_id">
                        <t t-out="object.partner_id.parent_id.name" />
                    </t>
                    <br /><br />
                    Please be informed that a Credit Note with the number
                    <strong><t t-out="object.name" /></strong>
                    has been prepared in draft status for your RMA request (RMA Number:
                    <strong><t t-out="object.invoice_line_ids[0].rma_id.name"/></strong>).
                    <br /><br />
                    <strong>Amount:</strong> <t t-out="format_amount(object.amount_total, object.currency_id)" /><br />
                    <strong>Date:</strong> <t t-out="format_date(object.invoice_date)" />
                    <br /><br />
                    If you have any questions, feel free to contact us.
                    <br /><br />
                    Best regards,<br />
                    <t t-out="user.company_id.name" />
                </p>
            </div>
        </field>
    </record>
