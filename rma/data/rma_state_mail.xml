    <record id="mail_template_rma_confirmed_notification" model="mail.template">
        <field name="name">RMA Confirmed Notification</field>
        <field name="model_id" ref="model_rma" />
        <field name="email_from">{{object.user_id.email_formatted}}</field>
        <field name="partner_to">{{object.partner_id.id}}</field>
        <field name="subject">
            {{object.company_id.name}} Your RMA (Ref {{object.name or 'n/a'}}) has been confirmed
        </field>
        <field name="report_template_ids" eval="[(4, ref('rma.report_rma_action'))]" />
        <field name="lang">{{object.partner_id.lang}}</field>
        <field name="auto_delete" eval="True" />
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;">
                <p style="margin: 0px; padding: 0px; font-size: 13px;">
                    Dear
                    <t t-out="object.partner_id.name" />
                    <t t-if="object.partner_id.parent_id">
                        <t t-out="object.partner_id.parent_id.name" />
                    </t>
                    <br /><br />
                    Your RMA
                    <strong>
                        <t t-out="object.name" />
                    </strong>
                    has been <strong>confirmed</strong> by
                    <t t-out="object.company_id.name" />.
                    We are now processing your request.
                    <br /><br />
                    Feel free to contact us if you need any further information.
                </p>
            </div>
        </field>
    </record>
