<odoo>
    <!-- Inherit Form View to Modify it -->
    <record id="gulfco_account_res_config_settings_view_form" model="ir.ui.view">
        <field name="name">account.res.config.settings.view.form.inherit.custom</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='default_accounts']" position="after">
                <block title="Excise Configuration" id="excise_configuration">
                    <setting string="Excise Valuation">
                        <div class="content-group">
                            <div class="row mt8">
                                <label for="excise_journal_id" class="col-lg-4 o_light_label"
                                       string="Journal"/>
                                <field name="excise_journal_id" domain="[('company_id','=',company_id)]"/>
                            </div>
                            <div class="row mt8">
                                <label for="excise_debit_account_id" string="Excise Debit Account"
                                       class="col-lg-4 o_light_label"/>
                                <field name="excise_debit_account_id"/>
                            </div>
                            <div class="row mt8">
                                <label for="excise_credit_account_id" string="Excise Credit Account"
                                       class="col-lg-4 o_light_label"/>
                                <field name="excise_credit_account_id"/>
                            </div>
                        </div>
                    </setting>

                </block>
            </xpath>
        </field>
    </record>

</odoo>