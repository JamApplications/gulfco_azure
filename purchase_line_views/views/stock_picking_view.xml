<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="gulfco_view_picking_form_excise_entries_button" model="ir.ui.view">
        <field name="name">gulfco.picking.form.excise.entries.button</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_excise_journal_entries" type="object" class="oe_stat_button"
                        invisible="not excise_move_id">
                    Excise Journal entries
                    <field string="Excise Journal Entries" name="excise_move_id" invisible="1"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>