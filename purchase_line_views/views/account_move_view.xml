<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="purchase_bill_matching_account_move_inherit" model="ir.ui.view">
        <field name="name">purchase.bill.matching.account.move.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']//list//field[@name='analytic_distribution']" position="before">
                <field name="bill_matching_picking_ids" widget="many2many_tags" string="Picking" column_invisible="parent.move_type != 'in_invoice'" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>