<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sales_budget_tree_view" model="ir.ui.view">
        <field name="name">sales.budget.tree.view</field>
        <field name="model">sales.budget</field>
        <field name="arch" type="xml">
            <list string="Sales Budget">
                <field name="division"/>
                <field name="partner_id"/>
                <field name="partner_channel_id"/>
                <field name="outlet_id"/>
                <field name="customer_group_id"/>
            </list>
        </field>
    </record>

    <record id="sales_budget_form_view" model="ir.ui.view">
        <field name="name">sales.budget.form.view</field>
        <field name="model">sales.budget</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div name="button_box" position="inside">
                        <button name="open_action_view_budget_line" type="object" class="oe_stat_button">
                                <span class="o_stat_text">Line Report</span>
                        </button>
                         <button name="open_action_view_budget_line_pivot" type="object" class="oe_stat_button">
                                <span class="o_stat_text">Pivot Report</span>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="division"/>
                            <field name="partner_id"/>
                            <field name="partner_channel_id"/>
                            <field name="outlet_id"/>
                            <field name="customer_group_id"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="lines" string="Lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="product_id" context="{'from_sales_budget' : 1}" string="Product Code"/>
                                    <field name="product_name"/>
                                    <field name="product_type"/>
                                    <field name="brand_id"/>
                                    <field name="price_to_trade"/>
                                    <field name="item_landed_cost"/>
                                    <field name="gp_percentage"/>
                                    <field name="total_sales_volume" sum="Total Sales Volume"/>
                                     <field name="total_sales_value" sum="Total Sales Value"/>
                                     <field name="total_cogs" sum="Total Cogs"/>
                                     <field name="total_gross_margin" sum="Total Gross Margin"/>
                                     <field name="total_gp" sum="Total GP"/>
                                    <button
                                        name="action_show_details"
                                        type="object"
                                        icon="fa-list"
                                        title="Show Details"
                                        width="0.1"
                                        options='{"warn": true}'
                                    />
                                    <button
                                        name="action_pivot_details"
                                        type="object"
                                        icon="fa-area-chart"
                                        title="Show Details"
                                        width="0.1"
                                        options='{"warn": true}'
                                    />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="action_sales_budget" model="ir.actions.act_window">
        <field name="name">Sales Budget</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sales.budget</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'list', 'view_id': ref('sales_budget_tree_view')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('sales_budget_form_view')})]"/>
    </record>


    <menuitem
            id="menu_sales_budget"
            name="Sales Budget"
            action="action_sales_budget"
            parent="account.menu_finance_entries"/>

</odoo>