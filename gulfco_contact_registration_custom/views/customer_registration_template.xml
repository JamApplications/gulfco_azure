                                 <select name="nationality" id="nationality" class="form-control">
                                    <option value=""></option>
                                    <t t-foreach="request.env['res.country'].search([])" t-as="country">
                                        <option t-att-value="country.id"><t t-esc="country.name"/></option>
                                    </t>
                                </select>
                            </div>
                            <div class="col-md-12">
