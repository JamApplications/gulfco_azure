<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="gulfco_contact_registration_custom.customer_registration_template" name="Customer Registration">
        <t t-call="website.layout">

            <div class="container">
                <div class="text-center mb16 mt32">
                    <h2>Customer Registration Form</h2>
                </div>
                <form action="/submit_customer_registration" method="post" enctype="multipart/form-data"
                      class="o_mark_required mb32 oe_registration_form" data-mark="*" data-model_name="" data-success-page="">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                    <div class="row mt-3">
                        <div class="col-md-6">
                            <label>Company Type :</label>
                            <span class="s_website_form_mark"> *</span>
                            <div class="btn-group btn-group-toggle d-flex" data-toggle="buttons">
                                <label class="btn btn-outline-primary  w-50">
                                    <input type="radio" name="company_type" id="individual" value="person" autocomplete="off" checked="checked"> Individual</input>
                                </label>
                                <label class="btn btn-outline-primary w-50">
                                    <input type="radio" name="company_type" id="company" value="company" autocomplete="off"> Company</input>
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="mt-2">
                        <label>Customer Name :</label>
                        <span class="s_website_form_mark"> *</span>
                        <input type="text" name="customer_name" class="form-control" required=""/>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <label>Customer Type :</label>
                            <span class="s_website_form_mark"> *</span>
                            <select name="customer_type" id="customer_type" class="form-control" required="">
                                <option value=""></option>
                                <option value="cash">Cash</option>
                                <option value="credit">Credit</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label>Business Type :</label>
                            <input type="text" name="customer_category" class="form-control"/>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label>Tax Registration Number (TRN) :</label>
                        <span class="s_website_form_mark"> *</span>
                        <input type="text" name="customer_trn" class="form-control" required=""/>
                    </div>

