                    <div class="col-md-12">
                        <label>Complete Address :</label>
                        <span class="s_website_form_mark"> *</span>
                        <textarea name="complete_address" class="form-control" required=""></textarea>
                    </div>
                    <div class="row mt-2">
                         <div class="col-md-4">
                             <label>Country :</label>
                             <span class="s_website_form_mark"> *</span>
<!--                            <input type="text" name="country_name" class="form-control state_selection" required=""/>-->
                             <select name="country_id" id="country_id" class="form-control state_selection" required="">
                                <option value=""></option>
                                <t t-foreach="request.env['res.country'].search([])" t-as="country">
                                    <option t-att-value="country.id"><t t-esc="country.name"/></option>
                                </t>
                             </select>
                        </div>

                        <div class="col-md-4">
                            <label>State/City :</label>
                            <span class="s_website_form_mark"> *</span>
                            <select id="state_id" name="state_id" class="form-control">
                                <option value="">Select a state</option>
                            </select>
                            <div class="mt-1 mb-2">
                                <input type="text" name="city_name" class="form-control" required="" placeholder="Please Add City Name"/>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label>ZIP / Pincode / Area Code :</label>
                            <input type="text" name="zip_code" class="form-control"/>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-4">
                            <label>Area/Zone/Community Name :</label>
                            <span class="s_website_form_mark"> *</span>
                            <input type="text" name="area_zone_name" class="form-control" required=""/>
                        </div>
                        <div class="col-md-4">
                            <label>P.O.Box :</label>
                            <input type="number" name="po_box" class="form-control"/>
                        </div>
                        <div class="col-md-4">
                            <label>Web Site (URL) :</label>
                            <input type="text" name="website_url" class="form-control"/>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-4">
                            <label>Telephone # :</label>
                            <input type="number" name="telephone" class="form-control"/>
                        </div>
                        <div class="col-md-4">
                            <label>Mobile # :</label>
                            <input type="number" name="mobile" class="form-control"/>
                        </div>
                        <div class="col-md-4">
                            <label>Email :</label>
                            <span class="s_website_form_mark"> *</span>
                            <input type="email" class="form-control" name="email" required="1"
                                                        placeholder="e.g. john.smith@example.com"/>
                        </div>
                    </div>

                    <h4 class="mt-4">Contact Details</h4>
                    <table class="table table-borderless o_main_table small">
                        <thead>
                            <tr>
                                <th></th>
                                <th>Name <span class="s_website_form_mark"> *</span></th>
                                <th>Tel</th>
                                <th>Mobile</th>
                                <th>Email Id <span class="s_website_form_mark"> *</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>
                                    <div class="mt-2">
                                        <b>Contact Person</b>
                                    </div>
                                </td>
                                <td>
                                    <input type="text" name="contact_name" class="form-control" required="1"/>
                                </td>
                                <td>
                                    <input type="number" name="contact_tel" class="form-control"/>
                                </td>
                                <td>
                                    <input type="number" name="contact_mobile" class="form-control"/>
                                </td>
                                <td>
                                    <input type="email" class="form-control" name="contact_email" required="1"
                                                        placeholder="e.g. john.smith@example.com"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>



                    <div class="customer_attachment">
                            <h3 class="mt-4">Attachments</h3>
                            <div class="row ">
                                <div class="col-md-6">
                                    <label>Trade License:</label>
<!--                                    <span class="s_website_form_mark">*</span>-->
