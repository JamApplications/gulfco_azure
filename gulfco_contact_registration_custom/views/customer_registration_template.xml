                                </div>
                                <div class="col-md-6">
                                    <label>VAT/TRN Certificates:</label>
                                    <input type="file" name="vat_certificates" class="form-control"/>
                                </div>
                            </div>
                            <div class="row mt-3">
                                <div class="col-md-6">
                                    <label>Bank Statement of 6 months</label>
<!--                                    <span class="s_website_form_mark">*</span>-->
                                    <input type="file" name="bank_statement_of_six_month" class="form-control"/>
                                </div>
                                <div class="col-md-6">
                                    <label>CAF:</label>
<!--                                    <span class="s_website_form_mark">*</span>-->
                                    <input type="file" name="caf_attachment" class="form-control"/>
                                </div>
                            </div>
                            <div class="row mt-3">
                                <div class="col-md-6">
                                    <label>Guarantees Copy:</label>
<!--                                    <span class="s_website_form_mark">*</span>-->
                                    <input type="file" name="customer_guarantees_copy" class="form-control" />
                                </div>
                                <div class="col-md-6">
                                    <label>EID Copy:</label>
                                    <input type="file" name="customer_eid_copy" class="form-control"/>
                                </div>
                            </div>
                        </div>

