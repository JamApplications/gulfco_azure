                                <label>TL issued From Emairates :</label>
                                <input type="text" name="trade_license_issue" class="form-control"/>
                            </div>
                            <div class="col-md-12 customer_trade_license ">
                                <label>Trade License #:</label>
                                <span class="s_website_form_mark"> *</span>
                                <input type="text" name="trade_license" class="form-control" required=""/>
                            </div>
                            <div class="col-md-12">
                                <label>TL Expiry Date:</label>
                                <input type="date" name="tl_expiry_date" class="form-control" />
                            </div>
                            <div class="col-md-12">
                                <label>Establish Data:</label>
                                <input type="text" name="establish_data" class="form-control" />
                            </div>


                        </div>
                        <div class="col-md-6">
                            <h4 class="mt-4 mb-2">Owner Info</h4>
                            <div class="col-md-12">
                                <label>Owner Name :</label>
                                <input type="text" name="owner_name" class="form-control"/>
                            </div>
                            <div class="col-md-12">
                                <label>Owner Share :</label>
                                <input type="number" name="owner_share" class="form-control"/>
                            </div>
                            <div class="col-md-12">
