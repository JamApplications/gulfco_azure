<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Sequence for fsm.order -->
    <record id="seq_customer_code" model="ir.sequence">
        <field name="name">Customer Code Sequence</field>
        <field name="code">customer.code.seq</field>
        <field name="prefix">CUS</field>
        <field name="padding">3</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
        <field name="company_id" eval="False"/>
    </record>


    <record id="seq_cash_customer_code" model="ir.sequence">
        <field name="name">Cash Customer Code Sequence</field>
        <field name="code">cash.customer.code.seq</field>
        <field name="prefix"></field>
        <field name="padding">8</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
        <field name="company_id" eval="False"/>
    </record>


    <record id="seq_credit_customer_code" model="ir.sequence">
        <field name="name">Credit Customer Code Sequence</field>
        <field name="code">credit.customer.code.seq</field>
        <field name="prefix"></field>
        <field name="padding">6</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
