<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_division_form" model="ir.ui.view">
        <field name="name">view.division.form</field>
        <field name="model">division.management</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <div class="oe_title">
                                <label for="name"/>
                                <h1>
                                    <field name="name" placeholder="e.g. Division 0000001"/>
                                </h1>
                            </div>
                        </group>
                        <group>
                            <field name="type"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id="view_division_tree" model="ir.ui.view">
        <field name="name">view.division.tree</field>
        <field name="model">division.management</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>

            </list>
        </field>
    </record>

    <record id="view_division_tree_action" model="ir.actions.act_window">
        <field name="name">Divisions</field>
        <field name="res_model">division.management</field>
        <field name="view_mode">list,form</field>

    </record>


    <menuitem
            id="menu_division_management_root"
            name="Divisions"
            parent="contacts.menu_partner_category_form"
            sequence="3"/>

    <menuitem
            id="menu_division_management"
            name="Division"
            parent="gulfco_customer_customized_data.menu_division_management_root"
            action="view_division_tree_action"
            sequence="3"/>

</odoo>