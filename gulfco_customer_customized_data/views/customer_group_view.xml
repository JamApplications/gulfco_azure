<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_customer_group_form_view" model="ir.ui.view">
        <field name="name">customer.group.form.view</field>
        <field name="model">customer.group</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1>
                                <field name="name"/>
                            </h1>
                        </div>

                    </group>

                </sheet>
            </form>
        </field>
    </record>


    <record id="view_customer_group_tree_view" model="ir.ui.view">
        <field name="name">customer.group.tree.view</field>
        <field name="model">customer.group</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="action_customer_group" model="ir.actions.act_window">
        <field name="name">Customer Group</field>
        <field name="res_model">customer.group</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
            id="menu_customer_group"
            name="Customer Group"
            parent="contacts.res_partner_menu_config"
            action="action_customer_group"/>
</odoo>