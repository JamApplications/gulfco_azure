<odoo>
    <!-- Inherit invoice form view -->
    <record id="view_move_form_inherit_customer_code" model="ir.ui.view">
        <field name="name">account.move.form.inherit.customer.code</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_shipping_id']" position="before">
                <field name="customer_code" readonly="1"/>
            </xpath>
            <xpath expr="//div[contains(@class, 'alert-warning') and field[@name='duplicated_ref_ids']]" position="after">

                <!-- Warning: Goods Product in Debit Note -->
                <div class="alert alert-warning w-100 d-flex align-items-center gap-1" invisible="not show_goods_warning_debit_journal" role="alert">
                    <span>⚠️ Warning: You are trying to add goods products to a <strong>Debit Note</strong>.
                    </span>
                </div>

                <!-- Warning: Goods Product but no Sales Order -->
                <div class="alert alert-warning w-100 d-flex align-items-center gap-1" invisible="not show_goods_warning_no_so" role="alert">
                    <span>⚠️ Warning: You are trying to generate an invoice that is <strong>NOT linked to a Sales Order</strong>.
                    </span>
                </div>

            </xpath>
        </field>
    </record>
</odoo>
