<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-inherit="account.TaxTotalsField" t-inherit-mode="extension" owl="1">
        <xpath expr="//tr[1]" position="before">
             <tr t-if="totals.before_discount_amount">
                <td class="o_td_label">Total Value before Discount<label class="o_form_label o_tax_total_label"/></td>
                <td class="o_tax_group"><span t-out="totals.before_discount_amount"/></td>
            </tr>
            <tr t-if="totals.total_discount_amount" name="total_discount_tr">
                <td class="o_td_label">Total Discount<label class="o_form_label o_tax_total_label"/></td>
                <td class="o_tax_group"><span t-out="totals.total_discount_amount"/></td>
            </tr>

<!--     If you need to show in backend       -->
<!--             <tr t-if="totals.total_excise_amount" name="total_discount_tr">-->
<!--                <td class="o_td_label">Total Excise Value<label class="o_form_label o_tax_total_label"/></td>-->
<!--                <td class="o_tax_group"><span t-out="totals.total_excise_amount"/></td>-->
<!--            </tr>-->

        </xpath>
    </t>
</templates>
