<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="document_tax_totals" inherit_id="sale.document_tax_totals">
        <xpath expr="//tr[hasclass('o_subtotal')]" position="before">
            <tr>
                <td><strong>Total Discount</strong></td>
                <td class="text-end text-nowrap">
                    <span t-out="tax_totals['total_discount_amount']"/>
                </td>
            </tr>
              <tr>
                <td><strong>Total Excise Value</strong></td>
                <td class="text-end text-nowrap">
                    <span t-out="tax_totals['total_excise_amount']"/>
                </td>
            </tr>
        </xpath>
    </template>
        <template id="account_document_tax_totals_inherit" inherit_id="account.document_tax_totals">
        <xpath expr="//tr[hasclass('o_subtotal')]" position="before">
            <tr>
                <td><strong>Total Value before Discount</strong></td>
                <td class="text-end text-nowrap">
                    <span t-out="tax_totals['before_discount_amount']"/>
                </td>
            </tr>
            <tr>
                <td><strong>Total Discount</strong></td>
                <td class="text-end text-nowrap">
                    <span t-out="tax_totals['total_discount_amount']"/>
                </td>
            </tr>
        </xpath>
    </template>
</odoo>
