<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_order_form_inherited_discount_amount_line_custom" model="ir.ui.view">
            <field name="name">sale.order.view.form.inherited.discount.amount.line.custom</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='order_lines']/field[@name='order_line']//list//field[@name='discount']" position="after">
                    <field name="discount_amount" string="Disc. in Value" optional="hide"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>