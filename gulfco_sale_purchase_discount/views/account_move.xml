<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_move_form_inherited_discount_amount_line_custom" model="ir.ui.view">
            <field name="name">account.move.view.form.inherited.discount.amount.line.custom</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='discount']" position="after">
                    <field name="discount_amount" string="Disc. in Value" optional="hide"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>