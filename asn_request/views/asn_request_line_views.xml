<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="asn_request_line_search_view" model="ir.ui.view">
            <field name="name">asn.request.line.search.view</field>
            <field name="model">asn.request.line</field>
            <field name="arch" type="xml">
                <search string="ASN Lines">
                    <field name="hs_code"/>
                    <field name="country_of_origin"/>
                    <group expand="1" string="Group By">
                        <filter string="HS Code" name="hs_code" context="{'group_by':'hs_code'}"/>
                        <filter string="Country of Origin" name="country_of_origin"
                                context="{'group_by':'country_of_origin'}"/>
                    </group>
                </search>
            </field>
        </record>
        <record id="asn_request_line_view_tree" model="ir.ui.view">
            <field name="name">asn_request_line_view_tree</field>
            <field name="model">asn.request.line</field>
            <field name="arch" type="xml">
                <list string="ASN Lines" create="0" edit="0" delete="0">
                    <field name="asn_request_id"/>
                    <field name="purchase_order_id"/>
                    <field name="purchase_order_line_id"/>
                    <field name="product_product_id" string="Item"/>
                    <field name="product_default_code" string="Item Code"/>
                    <field name="product_description" string="Item Description"/>
                    <field name="hs_code" optional="hide"/>
                    <field name="country_of_origin" optional="show"/>
                    <field name="po_uom"/>
                    <field name="po_qty"/>
                    <field name="po_unit_price"/>
                    <field name="asn_released_qty" readonly="1" force_save="1"/>
                    <field name="shipment_value" optional="show"/>
                    <field name="qty_in_invoice" optional="show"/>
                    <field name="po_due_qty_in_case"/>
                    <field name="po_due_qty_in_eac" string="PO due qty in Cartoon"/>
                    <field name="available_qty_to_release"/>
                    <field name="invoice_no" optional="show"/>
                    <field name="container_type" optional="show"/>
                    <field name="container_no" optional="show"/>
                    <field name="count_of_pallets" optional="show"/>
                    <field name="remarks" optional="hide"/>
                    <field name="location_id" optional="hide"/>
                    <field name="warehouse_id" optional="hide"/>
                </list>
            </field>
        </record>
        <record id="action_asn_request_line" model="ir.actions.act_window">
            <field name="name">ASN Line</field>
            <field name="res_model">asn.request.line</field>
            <field name="view_mode">list</field>
            <field name="context">{'is_from_asn_request':1}</field>
        </record>
        <menuitem id="menu_asn_request_line" name="ASN Line" parent="stock.menu_stock_transfers"
                  action="action_asn_request_line"/>
    </data>
</odoo>