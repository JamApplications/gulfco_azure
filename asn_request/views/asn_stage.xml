<?xml version='1.0' encoding='utf-8'?>
<odoo>
  <record id="view_asn_stage_form" model="ir.ui.view">
    <field name="name">asn.stage.form</field>
    <field name="model">asn.stage</field>
    <field name="arch" type="xml">
      <form string="ASN stage">
        <sheet>
          <div class="oe_title">
            <label for="name" />
            <h1>
              <field name="name" class="oe_inline" />
            </h1>
          </div>
          <group>
            <field name="description" />
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_asn_stage_list" model="ir.ui.view">
    <field name="name">asn.stage.list</field>
    <field name="model">asn.stage</field>
    <field name="arch" type="xml">
      <list string="ASN Stages">
        <field name="sequence" widget="handle"/>
        <field name="name" />
        <field name="description" />
      </list>
    </field>
  </record>

  <record id="action_asn_stage" model="ir.actions.act_window">
    <field name="name">ASN Stages</field>
    <field name="res_model">asn.stage</field>
    <field name="view_mode">list,form</field>
  </record>

<!--  <menuitem id="menu_asn_configuration" name="ASN Configuration" parent="stock.menu_stock_config_settings"/>-->
<!--  <menuitem id="menu_asn_stage" name="ASN Stages" parent="asn_request.menu_asn_configuration" action="action_asn_stage" sequence="10"/>-->

</odoo>